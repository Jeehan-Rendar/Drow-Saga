  INCLUDE ~drowsaga/contenu/vocab/ds_surfacien.tpa~
END

BEGIN @50
DESIGNATED 50
LABEL ~DrowSaga-Correction-BG1NPC~
REQUIRE_PREDICATE GAME_IS ~bgee~ @31
REQUIRE_COMPONENT ~setup-drowsaga.tp2~ ~30~ @51
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~bg1npc/bg1npc.tp2~ ~0~) OR (MOD_IS_INSTALLED ~setup-bg1npc.tp2~ ~0~) @52

INCLUDE ~drowsaga/contenu/e2/ds_e2_lib.tpa~
LAF ds_e2_cherche STR_VAR dlg = ~VICONJ~ aiguille = ~apprendre sur votre monde~ RET ds_bg1npc_rev = n RET_ARRAY ds_e2_et END
ACTION_IF (ds_bg1npc_rev = 0) BEGIN FAIL @53 END

OUTER_SPRINT DS_DROW ~TriggerOverride(Player1,Global("DS_DROW","LOCALS",1))~
ACTION_IF (MOD_IS_INSTALLED ~bg1npc/bg1npc.tp2~ ~10~) OR (MOD_IS_INSTALLED ~setup-bg1npc.tp2~ ~10~) BEGIN
  COMPILE EVALUATE_BUFFER ~drowsaga/contenu/ds_bg1_alora_bg1npc.d~ USING ~drowsaga/tra/%LANGUAGE%/contenu_bg1.tra~
END

INCLUDE ~drowsaga/contenu/ds_bg1_elfe.tpa~

INCLUDE ~drowsaga/contenu/e2/ds_e2.tpa~
ACTION_IF NOT (FILE_CONTAINS_EVALUATED (~override/ds_jetons.txt~ ~BG1NPC_VU~)) BEGIN
  INCLUDE ~drowsaga/contenu/jetons/ds_jetons.tpa~
END
ACTION_BASH_FOR ~drowsaga/contenu/e2~ ~^tmp_.*\.d$~ BEGIN DELETE + ~%BASH_FOR_FILESPEC%~ END
ACTION_IF MOD_IS_INSTALLED ~setup-drowsaga.tp2~ ~60~ BEGIN
  INCLUDE ~drowsaga/contenu/vocab/ds_surfacien.tpa~
END



BEGIN @60
DESIGNATED 60
LABEL ~DrowSaga-Surfacien~
REQUIRE_PREDICATE GAME_IS ~bgee~ @31
LAF ds_jeu_francais RET ds_fr END
ACTION_IF NOT ds_fr BEGIN FAIL @61 END
INCLUDE ~drowsaga/contenu/vocab/ds_surfacien.tpa~
INCLUDE ~drowsaga/contenu/fautes/ds_fautes_base.tpa~


BEGIN @40
DESIGNATED 40
LABEL ~DrowSaga-Portrait-Viconia-SoD~
REQUIRE_PREDICATE GAME_IS ~bgee bg2ee~ @2
REQUIRE_COMPONENT ~setup-drowsaga.tp2~ ~0~ @12

INCLUDE ~drowsaga/lib/ds_portrait.tpa~
LAF ds_viconia_portrait END

BEGIN @35
DESIGNATED 200
LABEL ~DrowSaga-Contenu-BG2~
REQUIRE_PREDICATE GAME_IS ~bg2ee~ @36
REQUIRE_COMPONENT ~setup-drowsaga.tp2~ ~0~ @12

OUTER_SPRINT DS_DROW ~TriggerOverride(Player1,Global("DS_DROW","LOCALS",1))~
INCLUDE ~drowsaga/contenu/bg2/ds_bg2.tpa~
INCLUDE ~drowsaga/contenu/bg2/ds_bebe_aerie.tpa~

BEGIN @62
DESIGNATED 260
LABEL ~DrowSaga-Fautes-BG2~
REQUIRE_PREDICATE GAME_IS ~bg2ee~ @36
LAF ds_jeu_francais RET ds_fr END
ACTION_IF NOT ds_fr BEGIN FAIL @61 END
INCLUDE ~drowsaga/contenu/fautes/ds_fautes_bg2.tpa~
