BACKUP ~drowsaga/backup~
AUTHOR ~Drow Saga~
VERSION ~1.0.1~
README ~drowsaga/doc/LISEZMOI.txt~
ASK_EVERY_COMPONENT

ALWAYS
  DEFINE_ACTION_FUNCTION ds_jeu_francais RET ds_fr BEGIN
    OUTER_SET fr = 0
    OUTER_SET en = 0
    OUTER_PATCH ~~ BEGIN
      FOR (i = 1; i < 3000 AND i < NEXT_STRREF; ++i) BEGIN
        GET_STRREF i t
        PATCH_IF (INDEX (CASE_INSENSITIVE ~ vous ~ ~%t%~) >= 0) BEGIN SET fr = fr + 1 END
        PATCH_IF (INDEX (CASE_INSENSITIVE ~ you ~ ~%t%~) >= 0) BEGIN SET en = en + 1 END
      END
    END
    OUTER_SET ds_fr = (fr > en) ? 1 : 0
  END
  DEFINE_ACTION_FUNCTION ds_save_index BEGIN
    COPY ~drowsaga/lib/save_index_lua_header.txt~ ~drowsaga/generated_save_index.lua~

    GET_DIRECTORY_ARRAY ds_save_dirs ~%SAVE_DIRECTORY%~ ~.*~
    ACTION_PHP_EACH ds_save_dirs AS ds_idx => ds_save_dir BEGIN
      ACTION_IF FILE_EXISTS ~%ds_save_dir%/BALDUR.gam~ BEGIN
        ACTION_IF FILE_CONTAINS_EVALUATED(~%ds_save_dir%/BALDUR.gam~ ~DSDROWID~) BEGIN
          ACTION_IF FILE_CONTAINS_EVALUATED(~%ds_save_dir%/BALDUR.gam~ ~DS_DROW_STATS_APPLIED~) BEGIN
            APPEND_OUTER ~drowsaga/generated_save_index.lua~ ~  { path = [[%ds_save_dir%]], drow = true, early = false },~ KEEP_CRLF
          END ELSE BEGIN
            APPEND_OUTER ~drowsaga/generated_save_index.lua~ ~  { path = [[%ds_save_dir%]], drow = true, early = true },~ KEEP_CRLF
          END
        END ELSE BEGIN
          APPEND_OUTER ~drowsaga/generated_save_index.lua~ ~  { path = [[%ds_save_dir%]], drow = false, early = false },~ KEEP_CRLF
        END
      END
    END
    APPEND_OUTER ~drowsaga/generated_save_index.lua~ ~}

drowSagaFixedSaveIdentity = {}
drowSagaFixedSaveNeedsEarlyRepair = {}
for _, entry in ipairs(drowSagaGeneratedSaveEntries or {}) do
  if type(entry.path) == "string" then
    local normalized = string.gsub(entry.path, "\\", "/")
    local basename = string.match(normalized, "([^/]+)$")
    if basename and not (basename == "") then
      local key = string.upper(basename)
      drowSagaFixedSaveIdentity[key] = (entry.drow == true)
      drowSagaFixedSaveNeedsEarlyRepair[key] = (entry.early == true)
    end
  end
end~ KEEP_CRLF
  END
END

LANGUAGE ~Francais~ ~french~ ~drowsaga/tra/french/setup.tra~
LANGUAGE ~English~ ~english~ ~drowsaga/tra/english/setup.tra~

BEGIN @1
DESIGNATED 0
LABEL ~DrowSaga-Core~

REQUIRE_PREDICATE GAME_IS ~bgee bg2ee~ @2
REQUIRE_PREDICATE (GAME_IS ~bg2ee~ OR FILE_EXISTS ~dlc/sod-dlc.disabled~) @3

COPY ~drowsaga/lib/blank.spl~ ~override/DSDROWMR.spl~
  LPF ADD_SPELL_EFFECT
      INT_VAR opcode=166 target=2 timing=9 parameter1=50
  END
BUT_ONLY

COPY ~drowsaga/lib/blank.spl~ ~override/DSDROWXP.spl~
  LPF ADD_SPELL_EFFECT
      INT_VAR opcode=104 target=2 timing=9 parameter1=90 parameter2=2
  END
BUT_ONLY

COPY ~drowsaga/lib/blank.spl~ ~override/DSDROWTH.spl~
  LPF ADD_SPELL_EFFECT INT_VAR opcode=90  target=2 timing=9 parameter1=5      parameter2=0 resist_dispel=2 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode=92  target=2 timing=9 parameter1="-5"  parameter2=0 resist_dispel=2 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode=59  target=2 timing=9 parameter1="-5"  parameter2=0 resist_dispel=2 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode=275 target=2 timing=9 parameter1="-10" parameter2=0 resist_dispel=2 END
BUT_ONLY

COPY ~drowsaga/lib/blank.spl~ ~override/DSDROWLT.spl~
  LPF ADD_SPELL_EFFECT INT_VAR opcode=54  target=2 timing=9 parameter1="-1" parameter2=0 resist_dispel=2 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode=325 target=2 timing=9 parameter1="-1" parameter2=0 resist_dispel=2 END
BUT_ONLY

COPY ~drowsaga/lib/blank.spl~ ~override/DSDROWCL.spl~
  LPF ADD_SPELL_EFFECT INT_VAR opcode=321 target=2 timing=1 parameter2=0 resist_dispel=2 STR_VAR resource=~DSDROWLT~ END
BUT_ONLY

DEFINE_ACTION_FUNCTION ds_splstate STR_VAR name = ~~ RET num BEGIN
  OUTER_SET num = IDS_OF_SYMBOL (~splstate~ ~%name%~)
  ACTION_IF (num < 0) BEGIN
    OUTER_SET num = 0
    COPY_EXISTING ~splstate.ids~ ~override~
      FOR (ds_n = 247; ds_n > 126 && num = 0; ds_n = ds_n - 1) BEGIN
        PATCH_IF (INDEX_BUFFER (CASE_INSENSITIVE EVALUATE_REGEXP ~^%ds_n%[ %TAB%]~) < 0) BEGIN
          SET num = ds_n
        END
      END
    BUT_ONLY
    ACTION_IF (num = 0) BEGIN FAIL @4 END
    APPEND ~splstate.ids~ ~%num% %name%~
  END
END
LAF ds_splstate STR_VAR name = ~DS_DROW_PASSPORT~ RET ds_st_passport = num END
LAF ds_splstate STR_VAR name = ~DS_DROW_PACKAGE~  RET ds_st_package = num END

COPY ~drowsaga/lib/blank.spl~ ~override/DSDROWID.spl~
  LPF ADD_SPELL_EFFECT
      INT_VAR opcode=328 target=2 timing=9 parameter1=0 parameter2=ds_st_passport special=1 resist_dispel=2
  END
BUT_ONLY

COPY ~drowsaga/lib/blank.spl~ ~override/DSDROWPK.spl~
  LPF ADD_SPELL_EFFECT
      INT_VAR opcode=328 target=2 timing=9 parameter1=0 parameter2=ds_st_package special=1 resist_dispel=2
  END
BUT_ONLY

COPY_EXISTING ~weapprof.2da~ ~override~
  COUNT_2DA_COLS ds_cols
  COUNT_2DA_ROWS ds_cols ds_rows
  FOR (ds_r = 0; ds_r < ds_rows; ++ds_r) BEGIN
    READ_2DA_ENTRY ds_r 1 ds_cols ds_id
    PATCH_IF (ds_id = 125 || ds_id = 134) BEGIN
      PATCH_IF (ds_id = 134) BEGIN SET ds_str = RESOLVE_STR_REF(@5) END
      ELSE BEGIN SET ds_str = RESOLVE_STR_REF(@6) END
      SET_2DA_ENTRY ds_r 2 ds_cols ds_str
      SET_2DA_ENTRY ds_r 3 ds_cols ds_str
      FOR (ds_c = 4; ds_c < ds_cols; ++ds_c) BEGIN
        SET_2DA_ENTRY ds_r ds_c ds_cols 1
      END
    END
  END
  PRETTY_PRINT_2DA
BUT_ONLY

COPY_EXISTING ~profs.2da~ ~override~
  COUNT_2DA_ROWS 3 ds_rows
  FOR (ds_r = 0; ds_r < ds_rows; ++ds_r) BEGIN
    READ_2DA_ENTRY ds_r 1 3 ds_first
    PATCH_IF IS_AN_INT ds_first BEGIN
      SET_2DA_ENTRY ds_r 1 3 (ds_first + 1)
    END
  END
BUT_ONLY

OUTER_SPRINT ds_txt_drow @200
OUTER_SPRINT ds_txt_elf_or_drow @201
OUTER_SPRINT ds_txt_elf @202
OUTER_SPRINT ds_txt_subrace_title @203
OUTER_SPRINT ds_txt_subraces_title @204
OUTER_SPRINT ds_txt_choose_subrace @205
OUTER_SPRINT ds_txt_drow_button @206
OUTER_SPRINT ds_txt_drow_desc @207
OUTER_SPRINT ds_txt_bio_old @208
OUTER_SPRINT ds_txt_bio_new @209
ACTION_GET_STRREF 15891 ds_bio_elf
ACTION_IF (INDEX (CASE_SENSITIVE EXACT_MATCH ~%ds_txt_bio_old%~ ~%ds_bio_elf%~) < 0) BEGIN
  OUTER_SPRINT ds_txt_bio_old ~~
  OUTER_SPRINT ds_txt_bio_new ~~
END
COPY ~drowsaga/lib/DSTXT.tpl~ ~override/DSTXT.lua~ EVALUATE_BUFFER
COPY ~drowsaga/lib/DSCOM.lua~ ~override/DSCOM.lua~

EXTEND_TOP ~BALDUR.BCS~ ~drowsaga/baf/ds_locals_test.baf~
ACTION_IF FILE_EXISTS_IN_GAME ~BDBALDUR.BCS~ BEGIN
  EXTEND_TOP ~BDBALDUR.BCS~ ~drowsaga/baf/ds_locals_test.baf~
END
EXTEND_TOP ~BALDUR.BCS~ ~drowsaga/baf/ds_import_runtime.baf~
ACTION_IF FILE_EXISTS_IN_GAME ~BDBALDUR.BCS~ BEGIN
  EXTEND_TOP ~BDBALDUR.BCS~ ~drowsaga/baf/ds_import_runtime.baf~
END
EXTEND_TOP ~BALDUR.BCS~ ~drowsaga/baf/ds_party_slots.baf~
EXTEND_TOP ~BALDUR.BCS~ ~drowsaga/baf/ds_viconia_label.baf~
ACTION_IF FILE_EXISTS_IN_GAME ~BDBALDUR.BCS~ BEGIN
  EXTEND_TOP ~BDBALDUR.BCS~ ~drowsaga/baf/ds_party_slots.baf~
  EXTEND_TOP ~BDBALDUR.BCS~ ~drowsaga/baf/ds_viconia_label.baf~
END
ACTION_IF (GAME_IS ~bg2ee~) AND (FILE_EXISTS_IN_GAME ~BALDUR25.BCS~) BEGIN
  EXTEND_TOP ~BALDUR25.BCS~ ~drowsaga/baf/ds_locals_test.baf~
  EXTEND_TOP ~BALDUR25.BCS~ ~drowsaga/baf/ds_import_runtime.baf~
  EXTEND_TOP ~BALDUR25.BCS~ ~drowsaga/baf/ds_party_slots.baf~
  EXTEND_TOP ~BALDUR25.BCS~ ~drowsaga/baf/ds_viconia_label.baf~
END


BEGIN @10
DESIGNATED 10
LABEL ~DrowSaga-UI-Vanilla~
SUBCOMPONENT @11
REQUIRE_COMPONENT ~setup-drowsaga.tp2~ ~0~ @12

LAF ds_save_index END
COPY ~drowsaga/generated_save_index.lua~ ~override/DSIDX.lua~

ACTION_IF GAME_IS ~bg2ee~ BEGIN
  COPY ~drowsaga/ui/vanilla_bg2/UI.menu~ ~override/UI.menu~
END ELSE BEGIN
  COPY ~drowsaga/ui/vanilla/UI.menu~ ~override/UI.menu~
END
COPY ~drowsaga/lib/DSVAN.lua~ ~override/DSVAN.lua~

BEGIN @20
DESIGNATED 20
LABEL ~DrowSaga-UI-InfinityUI~
SUBCOMPONENT @11
REQUIRE_PREDICATE GAME_IS ~bgee bg2ee~ @21
REQUIRE_COMPONENT ~setup-drowsaga.tp2~ ~0~ @12
REQUIRE_PREDICATE MOD_IS_INSTALLED ~infinity_ui.tp2~ ~0~ @22
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~rgdspbut.bam~ @24

LAF ds_save_index END
OUTER_SET ds_qcount = 0
OUTER_SET ds_qcount_was = 0
ACTION_IF FILE_EXISTS_IN_GAME ~savename.2da~ BEGIN
  COPY_EXISTING ~savename.2da~ ~override~
    READ_2DA_ENTRY 1 3 4 ds_qcount
    PATCH_IF (ds_qcount > 4) BEGIN
      SET ds_qcount_was = ds_qcount
      SET_2DA_ENTRY 1 3 4 4
      SET ds_qcount = 4
    END
  BUT_ONLY
END
ACTION_IF (ds_qcount_was > 4) BEGIN
  PRINT @23
END
APPEND_OUTER ~drowsaga/generated_save_index.lua~ ~drowSagaQuickSlotCountInstalled = %ds_qcount%~ KEEP_CRLF
COPY ~drowsaga/generated_save_index.lua~ ~override/DSIDX.lua~

COPY ~drowsaga/ui/infinity_ui_14/UI.menu~ ~override/UI.menu~


BEGIN @30
DESIGNATED 30
LABEL ~DrowSaga-Contenu-BG1~
REQUIRE_PREDICATE GAME_IS ~bgee~ @31
REQUIRE_COMPONENT ~setup-drowsaga.tp2~ ~0~ @12

OUTER_SPRINT DS_DROW ~TriggerOverride(Player1,Global("DS_DROW","LOCALS",1))~
