INCLUDE ~drowsaga/contenu/e2/ds_e2_lib.tpa~
WITH_TRA ~drowsaga/tra/%LANGUAGE%/jetons.tra~ BEGIN
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@1) requis = 1 STR_VAR cle = ~DRIZZT~ dlg = ~DRIZZT~ aiguille = ~Notre décision est prise, drow !~ END
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@2) requis = 1 STR_VAR cle = ~VICMAL~ dlg = ~VICONJ~ aiguille = ~Vous, les drows, me rendez malade.~ END
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@3) requis = 1 STR_VAR cle = ~VICLOIN~ dlg = ~VICONJ~ aiguille = ~Restez loin de lui, drow.~ END
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@4) requis = 1 STR_VAR cle = ~VICFERM~ dlg = ~VICONJ~ aiguille = ~Fermez-la, drow. Je veux écouter ce que Rasaad a à dire.~ END
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@5) requis = 1 STR_VAR cle = ~B1A~ dlg = ~ELMINS4~ aiguille = ~Vous n'êtes pas plus un Elminster que je suis Drizzt le Drow~ END
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@6) requis = 1 STR_VAR cle = ~B1B~ dlg = ~ELMINS4~ aiguille = ~vous n'êtes pas plus Elminster que je ne suis Drizzt le Drow~ END
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@5) requis = 0 STR_VAR cle = ~B1J~ dlg = ~JAHEIJ~ aiguille = ~Vous n'êtes pas plus un Elminster que je suis Drizzt le Drow~ END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@7) requis = 1 STR_VAR cle = ~B2~ dlg = ~SHVERT~ aiguille = ~Rechtez où vous êtes, pâle enfant~ cibles = ~~ RET ds_b_cibles = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@8) requis = 1 STR_VAR cle = ~B3~ dlg = ~OGRELEAD~ aiguille = ~Petits êtres rosâtres, vous allez mourir~ cibles = ~~ RET ds_b_cibles = cibles END
  OUTER_SPRINT ds_rb ~~
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@9) requis = 1 STR_VAR cle = ~RB1~ dlg = ~VICONJ~ aiguille = ~Les femmes de mon espèce protègent~ cibles = EVAL ~%ds_rb%~ RET ds_rb = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@10) requis = 1 STR_VAR cle = ~RB1B~ dlg = ~VICONJ~ aiguille = ~leçon en la matière. Nous devrions discuter~ cibles = EVAL ~%ds_rb%~ RET ds_rb = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@11) requis = 1 STR_VAR cle = ~RB1C~ dlg = ~RASAADJ~ aiguille = ~Votre allure incite tout un chacun à vous approcher.~ cibles = EVAL ~%ds_rb%~ RET ds_rb = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@12) requis = 1 STR_VAR cle = ~RB2~ dlg = ~RASAADJ~ aiguille = ~Ceux qui demeurent dans l'Ombre~ cibles = EVAL ~%ds_rb%~ RET ds_rb = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@13) requis = 1 STR_VAR cle = ~RB3~ dlg = ~NEERAJ~ aiguille = ~pourquoi m'avez-vous aidée à échapper aux Magiciens Rouges~ cibles = EVAL ~%ds_rb%~ RET ds_rb = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@14) requis = 1 STR_VAR cle = ~RB4~ dlg = ~NEERAJ~ aiguille = ~ce qui n'est clairement pas le cas~ cibles = EVAL ~%ds_rb%~ RET ds_rb = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@15) requis = 1 STR_VAR cle = ~RB5A~ dlg = ~DORNJ~ aiguille = ~Personne n'oserait se moquer de mes origines~ cibles = EVAL ~%ds_rb%~ RET ds_rb = cibles END
  LAF ds_e2_redirige STR_VAR cibles = EVAL ~%ds_rb%~ END
  LAF ds_e2_dit_fin INT_VAR ref = RESOLVE_STR_REF(@16) requis = 1 STR_VAR cle = ~EE1~ dlg = ~BAELOTHJ~ aiguille = ~bien trop occupés à lorgner d'anciens manuscrits~ END
  OUTER_SPRINT ds_ee ~~
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@17) requis = 1 STR_VAR cle = ~EE2~ dlg = ~RASAAD~ aiguille = ~je peux comprendre pourquoi vous restez attach~ cibles = EVAL ~%ds_ee%~ RET ds_ee = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@18) requis = 1 STR_VAR cle = ~EE3~ dlg = ~DORN~ aiguille = ~Mon apparence effraie souvent ceux qui possèdent~ cibles = EVAL ~%ds_ee%~ RET ds_ee = cibles END
  LAF ds_e2_redirige STR_VAR cibles = EVAL ~%ds_ee%~ END
  OUTER_SPRINT ds_ctx ~~
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@19) requis = 1 STR_VAR cle = ~CK1~ dlg = ~CADDER~ aiguille = ~Votre visage m'est familier, mais je ne me rappelle plus~ cibles = EVAL ~%ds_ctx%~ RET ds_ctx = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@20) requis = 1 STR_VAR cle = ~CK2~ dlg = ~CARBOS~ aiguille = ~Ouais, vous correspondez à la description~ cibles = EVAL ~%ds_ctx%~ RET ds_ctx = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@21) requis = 1 STR_VAR cle = ~BE1~ dlg = ~VAI~ aiguille = ~Tout le sud ne parle que de votre travail à Nashkel~ plus = ~!ReputationLT(Player1,5)~ cibles = EVAL ~%ds_ctx%~ RET ds_ctx = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@22) requis = 1 STR_VAR cle = ~NA1~ dlg = ~OUBLEK~ aiguille = ~je savais que la justice ne se ferait pas attendre~ plus = ~!StateCheck(Myself,STATE_CHARMED)~ cibles = EVAL ~%ds_ctx%~ RET ds_ctx = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@23) requis = 1 STR_VAR cle = ~PB1~ dlg = ~ALATOS~ aiguille = ~et vous faites déjà sensation~ cibles = EVAL ~%ds_ctx%~ RET ds_ctx = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@24) requis = 1 STR_VAR cle = ~PB2~ dlg = ~DELTHY~ aiguille = ~Tout le monde croit que vous êtes des agents amniens~ cibles = EVAL ~%ds_ctx%~ RET ds_ctx = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@25) requis = 1 STR_VAR cle = ~PB3~ dlg = ~NILA~ aiguille = ~vous ne ressemblez pas aux autres invités~ plus = ~!StateCheck(Myself,STATE_CHARMED)~ cibles = EVAL ~%ds_ctx%~ RET ds_ctx = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@26) requis = 1 STR_VAR cle = ~PB5~ dlg = ~OGRMBA~ aiguille = ~Ils collectent les êtres roses de la surface~ cibles = EVAL ~%ds_ctx%~ RET ds_ctx = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@27) requis = 1 STR_VAR cle = ~PB6~ dlg = ~DESTUS~ aiguille = ~Pile à l'heure. Ravi de vous rencontrer~ cibles = EVAL ~%ds_ctx%~ RET ds_ctx = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@28) requis = 1 STR_VAR cle = ~PB7~ dlg = ~VAIL~ aiguille = ~Je sors d'un lourd sommeil et que vois-je~ cibles = EVAL ~%ds_ctx%~ RET ds_ctx = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@29) requis = 1 STR_VAR cle = ~PB8~ dlg = ~LAERTA~ aiguille = ~y a un croque-mitaine qui vient regarder~ cibles = EVAL ~%ds_ctx%~ RET ds_ctx = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@30) requis = 1 STR_VAR cle = ~PB9~ dlg = ~GAXIR~ aiguille = ~êtes une lumière qui entre dans l'obscurité~ plus = ~!CheckStatLT(LastTalkedToBy,6,LEVEL)~ cibles = EVAL ~%ds_ctx%~ RET ds_ctx = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@31) requis = 1 STR_VAR cle = ~RE1~ dlg = ~DRADEE~ aiguille = ~que vous soyez un elfe amnien obèse~ cibles = EVAL ~%ds_ctx%~ RET ds_ctx = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@32) requis = 1 STR_VAR cle = ~RE2~ dlg = ~FORESH~ aiguille = ~Quel habit vous portez là~ cibles = EVAL ~%ds_ctx%~ RET ds_ctx = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@33) requis = 1 STR_VAR cle = ~RE3~ dlg = ~JOPI~ aiguille = ~tout noirs avec les cheveux verts~ cibles = EVAL ~%ds_ctx%~ RET ds_ctx = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@34) requis = 1 STR_VAR cle = ~RE4~ dlg = ~SENDAI~ aiguille = ~vous les barbares du Nord~ cibles = EVAL ~%ds_ctx%~ RET ds_ctx = cibles END
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@35) requis = 1 garde = 1 tete = 1 vers = 7 STR_VAR cle = ~CK3~ dlg = ~SHISTA~ aiguille = ~Comment saviez-vous que j'étais à Bois-Manteau~ END
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@36) requis = 1 garde = 1 tete = 1 STR_VAR cle = ~CK4~ dlg = ~VOICE~ aiguille = ~Ogre ou pas, cette créature~ END
  LAF ds_e2_redirige STR_VAR cibles = EVAL ~%ds_ctx%~ END
END
COMPILE ~drowsaga/contenu/ds_bgee_contexte.d~ USING ~drowsaga/tra/%LANGUAGE%/jetons.tra~
