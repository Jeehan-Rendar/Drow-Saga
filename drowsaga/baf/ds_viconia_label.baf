
IF
    OR(2)
      Name("Viconia",Player1)
      Name("Baeloth",Player1)
    !Global("DS_UI_VIC_1","GLOBAL",1)
THEN
    RESPONSE #100
        SetGlobal("DS_UI_VIC_1","GLOBAL",1)
        Continue()
END

IF
    !Name("Viconia",Player1)
    !Name("Baeloth",Player1)
    Global("DS_UI_VIC_1","GLOBAL",1)
THEN
    RESPONSE #100
        SetGlobal("DS_UI_VIC_1","GLOBAL",0)
        Continue()
END

