IF
    TriggerOverride(Player1,Global("DS_DROW","LOCALS",1))
    !TriggerOverride(Player1,Global("DS_DROW_REP_APPLIED","LOCALS",1))
    Global("DS_LK1_RP","GLOBAL",0)
THEN
    RESPONSE #100
        SetGlobal("DS_LK1_RP","GLOBAL",1)
        ReputationInc(-2)
        ActionOverride(Player1,SetGlobal("DS_DROW_REP_APPLIED","LOCALS",1))
        SetGlobal("DS_DROW_REP_CAMPAIGN_APPLIED","GLOBAL",1)
        Continue()
END

