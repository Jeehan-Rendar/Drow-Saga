
IF
    Global("DS_DROW_PENDING","GLOBAL",1)
    !TriggerOverride(Player1,Global("DS_DROW","LOCALS",1))
    Global("DS_LK1_ID","GLOBAL",0)
THEN
    RESPONSE #100
        SetGlobal("DS_LK1_ID","GLOBAL",1)
        ActionOverride(Player1,SetGlobal("DS_DROW","LOCALS",1))
        SetGlobal("DS_UI_DROW","GLOBAL",1)
        SetGlobal("DS_DROW_PENDING","GLOBAL",0)
        Continue()
END

IF
    Global("DS_LK1_ID","GLOBAL",1)
    TriggerOverride(Player1,Global("DS_DROW","LOCALS",1))
THEN
    RESPONSE #100
        SetGlobal("DS_LK1_ID","GLOBAL",0)
        Continue()
END

IF
    TriggerOverride(Player1,Global("DS_DROW","LOCALS",1))
    Global("DS_UI_DROW","GLOBAL",0)
THEN
    RESPONSE #100
        SetGlobal("DS_UI_DROW","GLOBAL",1)
        Continue()
END

IF
    !TriggerOverride(Player1,Global("DS_DROW","LOCALS",1))
    Global("DS_UI_DROW","GLOBAL",1)
THEN
    RESPONSE #100
        SetGlobal("DS_UI_DROW","GLOBAL",0)
        Continue()
END

IF
    TriggerOverride(Player1,Global("DS_DROW","LOCALS",1))
    !TriggerOverride(Player1,Global("DS_DROW_STATS_APPLIED","LOCALS",1))
    Global("DS_LK1_ST","GLOBAL",0)
THEN
    RESPONSE #100
        SetGlobal("DS_LK1_ST","GLOBAL",1)
        ChangeStat(Player1,DEX,1,ADD)
        ChangeStat(Player1,INT,1,ADD)
        ActionOverride(Player1,SetGlobal("DS_DROW_STATS_APPLIED","LOCALS",1))
        Continue()
END

IF
    Global("DS_LK1_ST","GLOBAL",1)
    TriggerOverride(Player1,Global("DS_DROW_STATS_APPLIED","LOCALS",1))
THEN
    RESPONSE #100
        SetGlobal("DS_LK1_ST","GLOBAL",0)
        Continue()
END

IF
    TriggerOverride(Player1,Global("DS_DROW","LOCALS",1))
    !TriggerOverride(Player1,Global("DS_DROW_MR_APPLIED","LOCALS",1))
    Global("DS_LK1_MR","GLOBAL",0)
THEN
    RESPONSE #100
        SetGlobal("DS_LK1_MR","GLOBAL",1)
        ApplySpellRES("DSDROWMR",Player1)
        ActionOverride(Player1,SetGlobal("DS_DROW_MR_APPLIED","LOCALS",1))
        Continue()
END

