IF
    Global("DS_DROW_LIGHT_TRACKER_V2_READY","GLOBAL",0)
    !TriggerOverride(Player1,Global("DS_DROW_LIGHT_ACTIVE","LOCALS",1))
THEN
    RESPONSE #100
