IF
    TriggerOverride(Player1,Global("DS_DROW","LOCALS",1))
    !TriggerOverride(Player1,Global("DS_DROW_ACCLIMATED","LOCALS",1))
    LevelGT(Player1,8)
THEN
    RESPONSE #100
        ApplySpellRES("DSDROWCL",Player1)
        SetGlobal("DS_DROW_LIGHT_ACTIVE_G","GLOBAL",0)
        ActionOverride(Player1,SetGlobal("DS_DROW_ACCLIMATED","LOCALS",1))
        DisplayStringHead(Player1,@100)
        Continue()
END

IF
    TriggerOverride(Player1,Global("DS_DROW","LOCALS",1))
    !TriggerOverride(Player1,Global("DS_DROW_ACCLIMATED","LOCALS",1))
    !LevelGT(Player1,8)
    Global("DS_DROW_LIGHT_ACTIVE_G","GLOBAL",0)
    AreaType(OUTDOOR)
    TimeOfDay(DAY)
THEN
    RESPONSE #100
        ApplySpellRES("DSDROWLT",Player1)
        SetGlobal("DS_DROW_LIGHT_ACTIVE_G","GLOBAL",1)
        Continue()
END

IF
    TriggerOverride(Player1,Global("DS_DROW","LOCALS",1))
    !TriggerOverride(Player1,Global("DS_DROW_ACCLIMATED","LOCALS",1))
    !LevelGT(Player1,8)
    Global("DS_DROW_LIGHT_ACTIVE_G","GLOBAL",1)
    !TriggerOverride(Player1,Global("DS_DROW_LIGHT_NOTICE_SHOWN","LOCALS",1))
THEN
    RESPONSE #100
        ActionOverride(Player1,SetGlobal("DS_DROW_LIGHT_NOTICE_SHOWN","LOCALS",1))
        DisplayStringHead(Player1,@101)
        Continue()
END

IF
    TriggerOverride(Player1,Global("DS_DROW","LOCALS",1))
    Global("DS_DROW_LIGHT_ACTIVE_G","GLOBAL",1)
    !AreaType(OUTDOOR)
THEN
    RESPONSE #100
        ApplySpellRES("DSDROWCL",Player1)
        SetGlobal("DS_DROW_LIGHT_ACTIVE_G","GLOBAL",0)
        Continue()
END

IF
    TriggerOverride(Player1,Global("DS_DROW","LOCALS",1))
    Global("DS_DROW_LIGHT_ACTIVE_G","GLOBAL",1)
    !TimeOfDay(DAY)
THEN
    RESPONSE #100
        ApplySpellRES("DSDROWCL",Player1)
        SetGlobal("DS_DROW_LIGHT_ACTIVE_G","GLOBAL",0)
        Continue()
END


IF
    Global("DS_DROW_EARLY_REPAIR","GLOBAL",1)
    TriggerOverride(Player1,Global("DS_DROW","LOCALS",1))
    TriggerOverride(Player1,Global("DS_DROW_STATS_APPLIED","LOCALS",1))
    TriggerOverride(Player1,Global("DS_DROW_MR_APPLIED","LOCALS",1))
    TriggerOverride(Player1,Global("DS_DROW_XP_APPLIED","LOCALS",1))
    TriggerOverride(Player1,Global("DS_DROW_REP_APPLIED","LOCALS",1))
    TriggerOverride(Player1,Global("DS_DROW_THIEF_OFFSETS_APPLIED","LOCALS",1))
THEN
