    Global("DS_DROW_FRESH_BOOTSTRAP","GLOBAL",0)
    Global("DS_DROW_PENDING","GLOBAL",0)
    !TriggerOverride(Player1,Global("DS_DROW","LOCALS",1))
    OR(2)
        !TriggerOverride(Player2,Global("DS_DROW","LOCALS",1))
        TriggerOverride(Player2,Global("DS_DROW_REP_APPLIED","LOCALS",1))
    OR(2)
        !TriggerOverride(Player3,Global("DS_DROW","LOCALS",1))
        TriggerOverride(Player3,Global("DS_DROW_REP_APPLIED","LOCALS",1))
    OR(2)
        !TriggerOverride(Player4,Global("DS_DROW","LOCALS",1))
        TriggerOverride(Player4,Global("DS_DROW_REP_APPLIED","LOCALS",1))
    OR(2)
        !TriggerOverride(Player5,Global("DS_DROW","LOCALS",1))
        TriggerOverride(Player5,Global("DS_DROW_REP_APPLIED","LOCALS",1))
    Global("DS_LK6_RP","GLOBAL",0)
THEN
    RESPONSE #100
        SetGlobal("DS_LK6_RP","GLOBAL",1)
        ReputationInc(-2)
        SetGlobal("DS_DROW_REP_CAMPAIGN_APPLIED","GLOBAL",1)
