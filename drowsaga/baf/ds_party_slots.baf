        ActionOverride(Player2,SetGlobal("DS_DROW_LIGHT_ACTIVE","LOCALS",0))
        ActionOverride(Player2,SetGlobal("DS_DROW_ACCLIMATED","LOCALS",1))
        DisplayStringHead(Player2,@100)
        Continue()
END

