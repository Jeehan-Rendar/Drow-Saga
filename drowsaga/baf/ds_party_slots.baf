

IF
    Global("DS_DROW_PENDING_2","GLOBAL",1)
    Exists(Player2)
    !TriggerOverride(Player2,Global("DS_DROW","LOCALS",1))
    Global("DS_LK2_ID","GLOBAL",0)
THEN
    RESPONSE #100
        SetGlobal("DS_LK2_ID","GLOBAL",1)
        SetGlobal("DS_DROW_FRESH_2","GLOBAL",1)
        ActionOverride(Player2,SetGlobal("DS_DROW","LOCALS",1))
        ApplySpellRES("DSDROWID",Player2)
        SetGlobal("DS_DROW_PENDING_2","GLOBAL",0)
        Continue()
END

IF
    Global("DS_LK2_ID","GLOBAL",1)
    TriggerOverride(Player2,Global("DS_DROW","LOCALS",1))
THEN
