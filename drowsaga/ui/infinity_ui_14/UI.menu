		actionDbl "Infinity_OnPortraitDblClick(0); rgInvId = id"
		actiondrag "Infinity_SwapWithPortrait(0)"
		actionEnter "mouseOverPortrait = 0"
		actionExit "mouseOverPortrait = -1"--; rgUpdateSlotsOnExit()"
