charNameEdit = ""
`
menu
{
	name 'CHARGEN_NAME'
	modal
	align center center
	ignoreesc
	onopen 
	"
		charNameEdit = ''
		Infinity_FocusTextEdit('charNameEditArea')
	"
	
	button
	{
		on escape
		area 235 75 400 75
		bam		rgdmbut2
		sequence lua "RgUISkin"
		ScaleToClip
		pad 10 8 10 8
		text "BACK_BUTTON"
		text style "button"
		action "Infinity_PopMenu(); createCharScreen:OnCancelButtonClick()"
	}
	button
	{
		on return
		area 235 150 400 75
		bam		rgdmbut2
		sequence lua "RgUISkin"
		ScaleToClip
		pad 10 8 10 8
		text "DONE_BUTTON"
		text style "button"
		clickable lua "createCharScreen:IsDoneButtonClickable()"
		action "
			drowSagaFinalizeNativeChargenIdentity();
			Infinity_PopMenu(); 
			createCharScreen:OnDoneButtonClick(); 
			if rgGameEngine ~= 3 then
				if drowSagaChargenBioRaceCommit then drowSagaChargenBioRaceCommit() end
				createCharScreen:AcceptCharacter(-1)
			end
		"
	}
	
	label
	{
		area 0 0 300 300
		bam rgdpopup
		sequence lua "RgUISkin"
		ScaleToClip
	}
	label
	{
		area 50 70 200 50
		text "ENTER_NAME_LABEL"
		text style "button"
		text color B
	}
	label
	{
		area 40 128 220 44
		fill            112 111 111 64
	}
	edit
	{
		name		"charNameEditArea"
		area		46 132 208 40
		var			charNameEdit
		text style	"normal"
		maxlines	1
		maxchars	20
	}
	button 
	{
		area		110 186 80 80
		bam 		'rgdcgen3'
		sequence lua "RgUISkin"
		scaleToClip
		action "
			if toggleMale == 1 then
				charNameEdit = rgMaleNames[math.random(1, 98)]
			elseif toggleFemale == 1 then
				charNameEdit = rgFemaleNames[math.random(1, 100)]
			end
		"
	}
	

}
