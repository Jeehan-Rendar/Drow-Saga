function rgUnlockInvId()
	rgInvId = id
end

function rgInvGetPlayerLooksLikeDrow()
	if EEex_GameState_GetGlobalInt == nil then
		return 0
	end
	local success, value = pcall(function() return EEex_GameState_GetGlobalInt("PlayerLooksLikeDrow") end)
	if success and value ~= nil then
		return value
	end
	return 0
end

function rgGetInvPaperdollBam()
	
	local bam = ''
	if EEex_Active == nil then
		for i=1,#rgIpNpc,1 do
			if rgIpNpc[i].name:lower() == t(characters[rgInvId].name):lower() then 
				return 'rgdipnpc'
			end
		end
		bam = 'rgdip'
		if characters[rgInvId].gender == 15729635 then
			bam = bam .. 'f'
		else
			bam = bam .. 'm'
		end
		if characters[rgInvId].race == 1096 or characters[rgInvId].race == 2828 then
			bam = bam .. 'h'
		elseif  characters[rgInvId].race == 1097 or characters[rgInvId].race == 1098 or characters[rgInvId].race == 8330 then
			bam = bam .. 'e'
		elseif  characters[rgInvId].race == 1100 then
			bam = bam .. 'd'
		elseif  characters[rgInvId].race == 1101 then
			bam = bam .. 'l'
		elseif  characters[rgInvId].race == 1099 then
			bam = bam .. 'g'
		elseif  characters[rgInvId].race == 53212 then
			bam = bam .. 'o'
		else
			bam = bam .. 'h'
		end
	else
		local data = rgEEexPlayerData
		if data.paperdollBamDerived == '-' then
			bam = 'rgdippol'
		else
			if rgPlayerLooksLikeDrow == 1 then
				if characters[rgInvId].gender == 15729635 then
					return 'rgdipfx'
				else
					return 'rgdipmx'
				end
			else
				for i=1,#rgIpNpc,1 do
					if rgIpNpc[i].name:lower() == t(characters[rgInvId].name):lower() then 
						return 'rgdipnpc'
					end
				end
				bam = data.paperdollBamDerived
			end
		end
	end
	
	return bam
end


function rgGetInvPaperdollSeq()
	local ret = 0
		for i=1,#rgIpNpc,1 do
			if rgIpNpc[i].name:lower() == t(characters[rgInvId].name):lower() then 
				return rgIpNpc[i].frame
			end
		end
	if EEex_Active == nil then
		for i=1,#rgIpAppearance,1 do
			if rgGetGameEngineString(rgIpAppearance[i].strref[1],rgIpAppearance[i].strref[2],rgIpAppearance[i].strref[3],rgIpAppearance[i].strref[4]):lower() == rgGetClassLevelInvString(1):lower() then 
				ret = rgIpAppearance[i].level
				break
			end
		end
	else
		local data = rgEEexPlayerData
		ret = data.paperdollSequenceDerived
	end
	return ret
end

function rgGetInvPaperdollFrame()
	local ret = 0
	if EEex_Active == nil then
		local isRobe = 0
		if rgGetInvPaperdollBam() == 'rgdipnpc' and (rgGetInvPaperdollSeq() == 0 or rgGetInvPaperdollSeq() == 3 or rgGetInvPaperdollSeq() == 7 or rgGetInvPaperdollSeq() == 12 or rgGetInvPaperdollSeq() >= 18) then
			isRobe = 1
		end
		if rgGetInvPaperdollBam() ~= 'rgdipnpc' and rgGetInvPaperdollSeq() == 3 then
			isRobe = 1
		end
		
		if isRobe == 1 then
		ret = 0
			for i=1,#rgIpRobe,1 do
				if rgGetGameEngineString(rgIpRobe[i].strref[1],rgIpRobe[i].strref[2],rgIpRobe[i].strref[3],rgIpRobe[i].strref[4]) == characters[rgInvId].equipment.armor.item.name then 
					ret = rgIpRobe[i].level
					break
				end
			end
		else
		ret = 0
			for i=1,#rgIpArmor,1 do
				if rgGetGameEngineString(rgIpArmor[i].strref[1],rgIpArmor[i].strref[2],rgIpArmor[i].strref[3],rgIpArmor[i].strref[4]) == characters[rgInvId].equipment.armor.item.name then 
					ret = rgIpArmor[i].level
					break
				end
			end
		end
	else
		local data = rgEEexPlayerData
		if data.paperdollBamDerived == '-' then
			local code = string.format("0x%04X", tonumber(data.animationID) or 0)
			for i=1,#rgEEexPolymorph,1 do
				if rgEEexPolymorph[i].name == code then 
					return rgEEexPolymorph[i].frame
				end
			end
		else
			ret = data.paperdollFrameDerived
		end
	end
	return ret
end
function rgGetAllClassInvString()
	local ret = rgGetClassLevelInvString(1)
	if characters[rgInvId].classlevel.second ~= nil then
		ret = ret .. ' / ' .. rgGetClassLevelInvString(2)
	end
	if characters[rgInvId].classlevel.third ~= nil then
		ret = ret .. ' / ' .. rgGetClassLevelInvString(3)
	end
	return ret
end
function rgGetClassLevelInvString(num)
	local rgClass = ''
	local rgLevel = ''
	local rgLevelXP = ''
	if num == 1 then 
		rgClass = ',' .. characters[rgInvId].classlevel.first.details
	elseif num == 2 then
		rgClass = ',' .. characters[rgInvId].classlevel.second.details
	else
		rgClass = ',' .. characters[rgInvId].classlevel.third.details 
	end
    local rgClass1 = string.match(rgClass, ',.-:')
	local out = string.match(rgClass1, '[^,:]+')
    return out
end
function rgGetInvShield()
	local ret = 0
	local details = characters[rgInvId].AC.details
	local shield = characters[rgInvId].equipment.shield.item.name
	if not string.find(details, shield, 1, true) then
        return 0
    end
	
	for i=1,#rgIpShield,1 do
		if rgGetGameEngineString(rgIpShield[i].strref[1],rgIpShield[i].strref[2],rgIpShield[i].strref[3],rgIpShield[i].strref[4]) == characters[rgInvId].equipment.shield.item.name then 
			ret = rgIpShield[i].level
			break
		end
	end
	return ret
end
function rgGetInvPaperdollOffhandFrame()
	if EEex_Active == nil then
		local shield = rgGetInvShield()
		if shield > 0 then
			return shield
		end
		
		if characters[rgInvId].damage.minOffhand then
			local name = characters[rgInvId].equipment.shield.item.name
			for i=1,#rgIpWeaponSpecial,1 do
				if rgGetGameEngineString(rgIpWeaponSpecial[i].strref[1],rgIpWeaponSpecial[i].strref[2],rgIpWeaponSpecial[i].strref[3],rgIpWeaponSpecial[i].strref[4]) == name then 
					return rgIpWeaponSpecial[i].frameOffhand
				end
			end
			local desc = characters[rgInvId].equipment.shield.item.description
			local startIdx = string.find(desc, getUiString('RG_ITM_COMP_ST'))
			
			if not startIdx then
				startIdx = 0
			end
			
			local substring = string.sub(desc, startIdx)
			
			for _, item in ipairs(rgIpWeaponOffHand) do
				local fetchedString = rgGetGameEngineString(item.strref[1],item.strref[2],item.strref[3],item.strref[4])
				local cleanDetails = string.lower(substring)
				local cleanFetched = string.lower(fetchedString or "")
				
				if cleanFetched ~= "" and string.find(cleanDetails, cleanFetched, 1, true) then
					return item.frame
				end
			end
		end
	else
		local data = rgEEexPlayerData
		local code = tostring(data.shieldEquippedAppearance)
		for i=1,#rgEEexOffHand,1 do
			if rgEEexOffHand[i].name == code and data.shieldSlotActive == true and data.paperdollBamDerived ~= '-' and ((characters[rgInvId].damage.minOffhand and rgEEexOffHand[i].shield == false) or rgEEexOffHand[i].shield == true) then 
				return rgEEexOffHand[i].frame
			end
		end
	end
    
    return 0
end
function rgGetInvPaperdollWeaponFrame()
	if EEex_Active == nil then
		local nameString = rgGetWeaponNameFromDetails()
		for i=1,#rgIpWeaponSpecial,1 do
			if rgGetGameEngineString(rgIpWeaponSpecial[i].strref[1],rgIpWeaponSpecial[i].strref[2],rgIpWeaponSpecial[i].strref[3],rgIpWeaponSpecial[i].strref[4]) == nameString then 
				return rgIpWeaponSpecial[i].frame
			end
		end
		local inputString = rgGetWeaponDescriptionFromDetails()
		local startIdx = string.find(inputString, getUiString('RG_ITM_COMP_ST'))
		
		if not startIdx then
			startIdx = 0
		end
		
		local substring = string.sub(inputString, startIdx)
		
		for _, item in ipairs(rgIpWeapon) do
			local fetchedString = rgGetGameEngineString(item.strref[1],item.strref[2],item.strref[3],item.strref[4])
			local cleanDetails = string.lower(substring)
			local cleanFetched = string.lower(fetchedString or "")
			
			if cleanFetched ~= "" and string.find(cleanDetails, cleanFetched, 1, true) then
				return item.frame
			end
		end
	else
		local data = rgEEexPlayerData
		local code = tostring(data.weaponEquippedAppearance)
		for i=1,#rgEeexMainHand,1 do
			if rgEeexMainHand[i].name == code then 
				return rgEeexMainHand[i].frame
			end
		end
	end
    
    return nil
end
function rgGetWeaponDescriptionFromDetails()
    local details = characters[rgInvId].damage.details
    if not details or details == "" then return nil end

    local weaponSlots = {
        characters[rgInvId].equipment.weapon0,
        characters[rgInvId].equipment.weapon1,
        characters[rgInvId].equipment.weapon2,
        characters[rgInvId].equipment.weapon3
    }

    for _, slot in ipairs(weaponSlots) do
        if slot and slot.item and slot.item.name and slot.item.name ~= "" then
            if string.find(details, slot.item.name, 1, true) then
                return slot.item.description
            end
        end
    end

    for _, slot in ipairs(weaponSlots) do
        if slot and slot.abilities then
            for _, ability in ipairs(slot.abilities) do
                if ability and ability.text and ability.text ~= "" then
                    if string.find(details, ability.text, 1, true) then
                        return slot.item.description
                    end
                end
            end
        end
    end
    
    return nil
end
function rgGetWeaponNameFromDetails()
    local details = characters[rgInvId].damage.details
    if not details or details == "" then return nil end

    local weaponSlots = {
        characters[rgInvId].equipment.weapon0,
        characters[rgInvId].equipment.weapon1,
        characters[rgInvId].equipment.weapon2,
        characters[rgInvId].equipment.weapon3
    }

    for _, slot in ipairs(weaponSlots) do
        if slot and slot.item and slot.item.name and slot.item.name ~= "" then
            if string.find(details, slot.item.name, 1, true) then
                return slot.item.name
            end
        end
    end

    return nil
end
function rgGetInvPaperdollHelmetFrame()
