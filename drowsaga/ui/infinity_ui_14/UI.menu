		sequence lua "RgUISkin"
		ScaleToClip
		text "BACK_BUTTON"
		text style "button"
		action "
			Infinity_PopMenu(); 
			createCharScreen:OnCancelButtonClick()
			if rgGameEngine == 3 and e:GetActiveEngine() == createCharScreen then
				createCharScreen:OnMainCancelButtonClick()
			end
			"
	}
	button
	{
		on return
		area 818 660 448 70	
		bam		rgdmbut2
		sequence lua "RgUISkin"
		ScaleToClip
		text "DONE_BUTTON"
		text style "button"
		clickable lua "createCharScreen:IsDoneButtonClickable()"
		action "
			if CurrentlyInGame() then
				
				local i = 1
				local curr = rgCustomizedPortraitList[currentCusPortrait]
				while i > 0 do
					local port = createCharScreen:GetCurrentPortrait()
					if curr == port then break end
					createCharScreen:IncCurrentPortrait()
				end
				
				
			else 
				for index = 1, currentPortrait-1, 1 do
					createCharScreen:IncCurrentPortrait()
				end
			end
			
			Infinity_PopMenu(); 
			createCharScreen:OnDoneButtonClick()
			"
	}
	

}

`
drowSagaInfinityUiDrowSelected = drowSagaInfinityUiDrowSelected or false
drowSagaFreshChargenDrow = drowSagaFreshChargenDrow or false
drowSagaImportedChrDrow = drowSagaImportedChrDrow or false
drowSagaChrRecapActive = drowSagaChrRecapActive or false

drowSagaUiPassportSection = "Drow Saga UI Passport v3"
drowSagaChrFilePassportSection = "Drow Saga CHR File Passport v1"
drowSagaChrIndexCacheSection = "Drow Saga CHR Index Cache v1"
drowSagaChrImportSelectedIndex = drowSagaChrImportSelectedIndex or nil
drowSagaChrImportIndexResolved = drowSagaChrImportIndexResolved or false
drowSagaSodFixedSaveResolved = drowSagaSodFixedSaveResolved or false
drowSagaSodFixedSaveDrow = drowSagaSodFixedSaveDrow or false
drowSagaSodFixedSaveNeedsEarlyRepair = drowSagaSodFixedSaveNeedsEarlyRepair or false
drowSagaFreshNativeChargen = drowSagaFreshNativeChargen or false
drowSagaNativeRaceId = drowSagaNativeRaceId or nil

drowSagaFixedSaveIdentity = drowSagaFixedSaveIdentity or {}
drowSagaFixedSaveNeedsEarlyRepair = drowSagaFixedSaveNeedsEarlyRepair or {}
if not drowSagaSaveIndexLoaded then
    drowSagaSaveIndexLoaded = true
    if Infinity_DoFile then
        pcall(function() Infinity_DoFile("DSIDX") end)
    end
end


function drowSagaSaveHash(text, multiplier)
    if type(text) ~= "string" then text = tostring(text or "") end
    local h = 0
    local m = tonumber(multiplier) or 131
    for i = 1, #text do
        h = ((h * m) + string.byte(text, i)) % 2147483647
    end
    return h
end




function drowSagaIsEarlySaveBasename(saveBasename)
    if type(saveBasename) ~= "string" then return false end
    local upper = string.upper(saveBasename)
    return (string.sub(upper, 1, 10) == "000000007-") or
           (string.sub(upper, 1, 10) == "000000000-")
end

function drowSagaEarlyNormalizedBasenameFromEntry(v)
    if type(v) ~= "table" or type(v.fileName) ~= "string" then return nil end
    local base = drowSagaSavePathBasename(v.fileName)
    if not base then return nil end
    base = string.upper(base)
    if not drowSagaIsEarlySaveBasename(base) then return nil end
    return base
end

function drowSagaEarlySlotCode(saveBasename)
    if type(saveBasename) ~= "string" then return nil end
    local upper = string.upper(saveBasename)
    if string.sub(upper, 1, 10) == "000000007-" then return 7 end
    if string.sub(upper, 1, 10) == "000000000-" then return 0 end
    return nil
end

function drowSagaEarlyFingerprint(entry)
    local base = drowSagaEarlyNormalizedBasenameFromEntry(entry)
    if not base then return nil, nil end
    local material = table.concat({
        base,
        tostring(entry.time or ""),
        tostring(entry.sName or ""),
        tostring(entry.slotName or "")
    }, "|")
    return drowSagaSaveHash(material, 131), drowSagaSaveHash(material, 257)
end

function drowSagaHandleWorldOpenEarlySlot()
    pcall(drowSagaOccHandleWorldOpen)
    pcall(drowSagaWorldBootstrapDrow)
    drowSagaFreshNativeChargen = false
end








drowSagaShadowSourceSection = "Drow Saga I23 Shadow Source Tx v2"
drowSagaShadowSourceKey = drowSagaShadowSourceKey or "<none>"
drowSagaShadowLiveEpoch = drowSagaShadowLiveEpoch or 0

local function drowSagaShadowHash(text)
    if type(text) ~= "string" or text == "" then return 0 end
    local h = 0
    for i = 1, #text do
        h = ((h * 131) + string.byte(text, i)) % 2147483647
    end
    return h
end

local function drowSagaShadowSet(field, value)
    Infinity_SetINIValue(drowSagaShadowSourceSection, field, tonumber(value) or 0)
end

local function drowSagaShadowGet(field)
    return tonumber(Infinity_GetINIValue(drowSagaShadowSourceSection, field, 0)) or 0
end

function drowSagaShadowBegin(kind, key)
    local epoch = drowSagaShadowGet("EPOCH") + 1
    if epoch > 2000000000 then epoch = 1 end
    drowSagaShadowSourceKey = (type(key) == "string" and key ~= "") and key or "<unknown>"
    drowSagaShadowSet("ACTIVE", 1)
    drowSagaShadowSet("EPOCH", epoch)
    drowSagaShadowSet("KIND", kind or 0) -- 1=NATIVE 2=CHR 3=SAVE
    drowSagaShadowSet("KEYHASH", drowSagaShadowHash(drowSagaShadowSourceKey))
    drowSagaShadowSet("IDENTITY", 0) -- 0=UNKNOWN 1=DROW 2=ELF
    drowSagaShadowSet("EXACT", 0)
    drowSagaShadowSet("ORIGIN", 0)
    drowSagaShadowSet("EARLY", 0)
    drowSagaShadowLiveEpoch = epoch
    return epoch
end

function drowSagaSourceTxIsLive()
    if tonumber(drowSagaShadowLiveEpoch or 0) <= 0 then return false end
    if drowSagaShadowGet("ACTIVE") ~= 1 then return false end
    return drowSagaShadowGet("EPOCH") == tonumber(drowSagaShadowLiveEpoch or 0)
end

function drowSagaSourceTxKind()
    if not drowSagaSourceTxIsLive() then return 0 end
    return drowSagaShadowGet("KIND")
end

function drowSagaSourceTxIdentity()
    if not drowSagaSourceTxIsLive() then return 0 end
    local identity = drowSagaShadowGet("IDENTITY")
    if identity == 1 or identity == 2 then return identity end
    return 0
end

function drowSagaShadowRekey(key)
    if type(key) ~= "string" or key == "" then return false end
    drowSagaShadowSourceKey = key
    drowSagaShadowSet("KEYHASH", drowSagaShadowHash(key))
    return true
end

function drowSagaShadowResolve(identity, exact, origin, early)
    drowSagaShadowSet("IDENTITY", identity or 0)
    drowSagaShadowSet("EXACT", exact and 1 or 0)
    drowSagaShadowSet("ORIGIN", origin or 0)
    drowSagaShadowSet("EARLY", early and 1 or 0)
    local kind = drowSagaShadowGet("KIND")
    if kind == 1 or kind == 2 then
        local k = tonumber(drowSagaPartySlot) or 1
        if type(drowSagaPartyIdentity) ~= "table" then drowSagaPartyIdentity = {} end
        drowSagaPartyIdentity[k] = { identity = tonumber(identity) or 0, exact = exact and 1 or 0 }
        if k > 1 then drowSagaPartyUsed = true end
    end
end



function drowSagaShadowCaptureExplicitNativeRaceChoice()
    if not createCharScreen or not createCharScreen.GetImportState then return end
    if createCharScreen:GetImportState() ~= 0 then return end
    local race = chargen and chargen.races and chargen.races[currentChargenRace] or nil
    if not race then return end
    drowSagaNativeRaceId = tonumber(race.id) or race.id
    drowSagaShadowBegin(1, "NATIVE:CHARGEN")
    if race.id == 2 then
        drowSagaShadowResolve(2, true, 1, false)
    else
        drowSagaShadowResolve(0, false, 1, false)
    end
end



drowSagaOccSection = "Drow Saga I43 Early Slot Occupancy v1"

local function drowSagaOccGet(field, default)
    return tonumber(Infinity_GetINIValue(drowSagaOccSection, field, default or 0)) or (default or 0)
end

local function drowSagaOccSet(field, value)
    Infinity_SetINIValue(drowSagaOccSection, field, tonumber(value) or 0)
end

local function drowSagaOccNormIdentity(v)
    v = tonumber(v) or 0
    if v == 1 or v == 2 then return v end
    return 0
end

function drowSagaOccCurrentCampaign()
    if type(startEngine) ~= "userdata" and type(startEngine) ~= "table" then return 0 end
    local ok, c = pcall(function() return startEngine:GetCampaign() end)
    if not ok or c == nil then return 0 end
    if rgGameEngine == 1 then
        if type(const) == "table" and const.START_CAMPAIGN_BG ~= nil then
            return (c == const.START_CAMPAIGN_BG) and 1 or 2
        end
        return 0
    elseif rgGameEngine == 0 then
        return (c == 1) and 1 or 2
    end
    return 0
end

local function drowSagaOccMarkSeen(identity)
    identity = drowSagaOccNormIdentity(identity)
    if identity == 1 then drowSagaOccSet("SEEN_D", 1)
    elseif identity == 2 then drowSagaOccSet("SEEN_E", 1)
    else drowSagaOccSet("SEEN_U", 1) end
end



function drowSagaQF(name, k)
    if not k or k == 1 then return name end
    return name .. "_" .. tostring(k)
end

function drowSagaQuickSlotIndex(basename)
    if type(basename) ~= "string" then return nil end
    if drowSagaSaveFolderNumber(basename) ~= 1 then return nil end
    local n = tonumber(string.match(basename, "%-(%d+)$"))
    if n and n >= 2 and n <= 9 then return n end
    return 1
end

function drowSagaQuickSlotCount()
    local n = tonumber(drowSagaQuickSlotCountInstalled or 0) or 0
    local seen = drowSagaOccGet("QMAXK", 1)
    if seen > n then n = seen end
    if n < 1 then n = 1 end
    if n > 4 then n = 4 end
    return n
end

function drowSagaQuickSlotsBeyondFolder()
    return (tonumber(drowSagaQuickSlotCountInstalled or 0) or 0) > 4
end

function drowSagaOccPredictQuickSlot()
    if drowSagaQuickSlotsBeyondFolder() then return nil end
    local count = drowSagaQuickSlotCount()
    if count == 1 then return 1 end
    if drowSagaOccGet("QOBS", 0) ~= 1 then return nil end
    for k = 1, count do
        if drowSagaOccGet(drowSagaQF("QEX", k), 0) ~= 1 then return k end
    end
    if drowSagaOccGet("QAGE_OK", 0) ~= 1 then return nil end
    local best, bestSeq = nil, nil
    for k = 1, count do
        local seq = drowSagaOccGet(drowSagaQF("QSEQ", k), 0)
        if seq <= 0 then return nil end
        if not bestSeq or seq < bestSeq then best, bestSeq = k, seq end
    end
    return best
end

function drowSagaOccQuickSaveDetected()
    local id = (tonumber(Infinity_GetScriptVarInt("DS_UI_DROW") or 0) == 1) and 1 or 2
    drowSagaOccSet("QB_N", drowSagaOccGet("QB_N", 0) + 1)
    local k = drowSagaOccPredictQuickSlot()
    local function seen(j)
        if id == 1 then drowSagaOccSet(drowSagaQF("QSEEN_D", j), 1)
        else drowSagaOccSet(drowSagaQF("QSEEN_E", j), 1) end
    end
    if k then
        drowSagaOccSet(drowSagaQF("QB_ARM", k), 1)
        drowSagaOccSet(drowSagaQF("QB_ID", k), id)
        drowSagaOccSet(drowSagaQF("QB_MIX", k), 0)
        seen(k)
        local top = drowSagaOccGet("QSEQMAX", 0) + 1
        drowSagaOccSet("QSEQMAX", top)
        drowSagaOccSet(drowSagaQF("QSEQ", k), top)
        drowSagaOccSet(drowSagaQF("QEX", k), 1)
        drowSagaOccSet("QPRED", k)
    else
        for j = 1, drowSagaQuickSlotCount() do
            if drowSagaOccGet(drowSagaQF("QB_ARM", j), 0) == 1 and drowSagaOccGet(drowSagaQF("QB_ID", j), 0) ~= id then
                drowSagaOccSet(drowSagaQF("QB_MIX", j), 1)
            end
            seen(j)
        end
        drowSagaOccSet("QAGE_OK", 0)
        drowSagaOccSet("QPRED", -1)
    end
end

function drowSagaOccJourneySeen(ui)
    drowSagaOccSet("AT_ARM", 1)
    drowSagaOccSet("AT_ID", (ui == 1) and 1 or 2)
    drowSagaOccSet("AT_N", drowSagaOccGet("AT_N", 0) + 1)
    drowSagaOccSet("AT_SRC", 0)
end

function drowSagaQuickSaveAltClick()
    for k = 1, drowSagaQuickSlotCount() do
        if drowSagaOccGet(drowSagaQF("QB_ARM", k), 0) == 1 then drowSagaOccSet(drowSagaQF("QB_MIX", k), 1) end
    end
    drowSagaOccSet("QB_ALT", drowSagaOccGet("QB_ALT", 0) + 1)
end

local function drowSagaOccSingleSeenQ(k)
    local d, e, u = drowSagaOccGet(drowSagaQF("QSEEN_D", k), 0), drowSagaOccGet(drowSagaQF("QSEEN_E", k), 0), drowSagaOccGet(drowSagaQF("QSEEN_U", k), 0)
    if u == 0 and d == 1 and e == 0 then return 1 end
    if u == 0 and e == 1 and d == 0 then return 2 end
    return 0
end

local function drowSagaOccClearSeenQ(k)
    drowSagaOccSet(drowSagaQF("QSEEN_D", k), 0)
    drowSagaOccSet(drowSagaQF("QSEEN_E", k), 0)
    drowSagaOccSet(drowSagaQF("QSEEN_U", k), 0)
end

local function drowSagaOccSingleSeen()
    local d, e, u = drowSagaOccGet("SEEN_D", 0), drowSagaOccGet("SEEN_E", 0), drowSagaOccGet("SEEN_U", 0)
    if u == 0 and d == 1 and e == 0 then return 1 end
    if u == 0 and e == 1 and d == 0 then return 2 end
    return 0
end

local function drowSagaOccClearSeen()
    drowSagaOccSet("SEEN_D", 0)
    drowSagaOccSet("SEEN_E", 0)
    drowSagaOccSet("SEEN_U", 0)
end

function drowSagaOccBeginNewGameFlow()
    drowSagaOccSet("NG_FLOW", 1)
    drowSagaOccSet("NG_CAMP", drowSagaOccCurrentCampaign())
    drowSagaOccSet("LOAD_ARM", 0)
    drowSagaPartyIdentity = {}
    drowSagaPartyUsed = false
    return true
end

local function drowSagaOccNewGameIdentity()
    if drowSagaPartyUsed == true then
        local r = type(drowSagaPartyIdentity) == "table" and drowSagaPartyIdentity[1] or nil
        if r and r.exact == 1 then return drowSagaOccNormIdentity(r.identity) end
        return 0
    end
    local kind = drowSagaShadowGet("KIND")
    if kind ~= 1 and kind ~= 2 then return 0 end
    if drowSagaShadowGet("EXACT") ~= 1 then return 0 end
    return drowSagaOccNormIdentity(drowSagaShadowGet("IDENTITY"))
end

function drowSagaOccHandleWorldOpen()
    local session = nil
    if drowSagaOccGet("NG_FLOW", 0) == 1 then
        local identity = drowSagaOccNewGameIdentity()
        if drowSagaOccGet("NG_CAMP", 0) ~= 2 then
            drowSagaOccSet("C7", identity)
            drowSagaOccSet("W7", 1)
            drowSagaOccSet("C0", identity)
            drowSagaOccSet("W0", 1)
            drowSagaOccSet("P0", 1)
            drowSagaOccClearSeen()
            drowSagaOccSet("AT_ARM", 0)
        end
        session = (identity ~= 0) and identity or 3
    elseif drowSagaOccGet("LOAD_ARM", 0) == 4 then
        local ui = tonumber(Infinity_GetScriptVarInt("DS_UI_DROW") or 0) or 0
        session = (ui == 1) and 1 or 3
        drowSagaOccSet("CT_UI", ui)
        drowSagaOccSet("CT_LAST", session)
    elseif drowSagaOccGet("LOAD_ARM", 0) ~= 0 then
        session = drowSagaOccGet("LOAD_ARM", 0)
    end

    if session ~= nil then
        drowSagaOccSet("NG_FLOW", 0)
        drowSagaOccSet("LOAD_ARM", 0)
        drowSagaOccSet("SESSION", session)
        drowSagaOccSet("UI1", 0)
        drowSagaOccMarkSeen(session)
        return true
    end

    local s = drowSagaOccGet("SESSION", 0)
    local ui = tonumber(Infinity_GetScriptVarInt("DS_UI_DROW") or 0) or 0
    if s == 2 and ui == 1 then
        drowSagaOccSet("SESSION", 3)
        drowSagaOccMarkSeen(0)
    elseif s == 1 then
        if ui == 1 then
            drowSagaOccSet("UI1", 1)
        elseif drowSagaOccGet("UI1", 0) == 1 then
            drowSagaOccSet("SESSION", 3)
            drowSagaOccMarkSeen(0)
        end
    end
    return false
end

function drowSagaOccContinueClick()
    drowSagaOccSet("NG_FLOW", 0)
    drowSagaOccSet("LOAD_ARM", 4)
    drowSagaOccSet("CT_N", drowSagaOccGet("CT_N", 0) + 1)
    drowSagaOccSet("CT_LAST", 0)
    drowSagaOccSet("CT_UI", -1)
end

function drowSagaOccReconcileAutoSave()
    local list = nil
    if type(gameSaves) == "table" and type(gameSaves.files) == "table" then
        list = gameSaves.files
    elseif type(rgLoadFiltered) == "table" then
        list = rgLoadFiltered
    end
    if not list then return false end

    local e0 = nil
    for _, v in ipairs(list) do
        local base = drowSagaEarlyNormalizedBasenameFromEntry(v)
        if base and drowSagaEarlySlotCode(base) == 0 then e0 = v; break end
    end
    if e0 then
        local f1, f2 = drowSagaEarlyFingerprint(e0)
        if f1 and f2 then
            local single = drowSagaOccSingleSeen()
            local changed = (drowSagaOccGet("F0", -1) ~= f1) or (drowSagaOccGet("G0", -1) ~= f2)
            local journeyId = (drowSagaOccGet("AT_ARM", 0) == 1) and drowSagaOccGet("AT_ID", 0) or 0
            if journeyId == 1 or journeyId == 2 then
                drowSagaOccSet("C0", journeyId)
                drowSagaOccSet("W0", 1)
                drowSagaOccSet("P0", 0)
                drowSagaOccSet("AT_SRC", 1)
            elseif drowSagaOccGet("P0", 0) == 1 then
                if not (single ~= 0 and single == drowSagaOccGet("C0", 0)) then
                    drowSagaOccSet("C0", 0)
                end
                drowSagaOccSet("P0", 0)
                drowSagaOccSet("W0", 1)
            elseif drowSagaOccGet("W0", 0) == 1 then
                if changed then drowSagaOccSet("C0", single) end
            elseif drowSagaOccGet("B0", 0) == 1 then
                if changed then
                    drowSagaOccSet("C0", single)
                    drowSagaOccSet("W0", 1)
                end
            end
            drowSagaOccSet("F0", f1)
            drowSagaOccSet("G0", f2)
            drowSagaOccSet("B0", 1)
        end
    end
    drowSagaOccSet("AT_ARM", 0)
    drowSagaOccClearSeen()
    return true
end

local function drowSagaOccQuickFingerprint(entry)
    local material = table.concat({
        string.upper(drowSagaSavePathBasename(entry.fileName) or ""),
        tostring(entry.time or ""), tostring(entry.sName or ""), tostring(entry.slotName or "")
    }, "|")
    return drowSagaSaveHash(material, 131), drowSagaSaveHash(material, 257)
end

function drowSagaOccReconcileQuickSlot(list, k, e1)
    local f1, f2 = -1, -1
    if e1 then f1, f2 = drowSagaOccQuickFingerprint(e1) end
    local changed = (drowSagaOccGet(drowSagaQF("F1", k), -2) ~= f1) or (drowSagaOccGet(drowSagaQF("G1", k), -2) ~= f2)
    local single = drowSagaOccSingleSeenQ(k)
    local ft = e1 and tonumber(e1.fileTime) or nil
    if ft == -1 then ft = nil end
    local armed = (drowSagaOccGet(drowSagaQF("QB_ARM", k), 0) == 1) and (drowSagaOccGet(drowSagaQF("QB_MIX", k), 0) ~= 1)
    local armedId = drowSagaOccGet(drowSagaQF("QB_ID", k), 0)
    local function finish()
        drowSagaOccSet(drowSagaQF("F1", k), f1); drowSagaOccSet(drowSagaQF("G1", k), f2)
        drowSagaOccSet(drowSagaQF("QB_ARM", k), 0); drowSagaOccSet(drowSagaQF("QB_MIX", k), 0)
        drowSagaOccClearSeenQ(k)
        return true
    end
    if e1 and ft then
        local lastFt = drowSagaOccGet(drowSagaQF("QFT", k), -1)
        local stale = drowSagaOccGet(drowSagaQF("QFT_STALE", k), 0) == 1
        drowSagaOccSet(drowSagaQF("QFT", k), ft)
        drowSagaOccSet(drowSagaQF("QFT_STALE", k), 0)
        if lastFt ~= -1 or drowSagaOccGet(drowSagaQF("W1", k), 0) == 1 or drowSagaOccGet(drowSagaQF("B1", k), 0) == 1 then
            if lastFt == ft then
                drowSagaOccSet(drowSagaQF("B1", k), 1)
                return finish()
            elseif lastFt ~= -1 and stale and not armed then
                drowSagaOccSet(drowSagaQF("B1", k), 1)
                drowSagaOccSet(drowSagaQF("QSRC", k), 4)
                return finish()
            elseif lastFt ~= -1 then
                local id = armed and armedId or single
                drowSagaOccSet(drowSagaQF("C1", k), id); drowSagaOccSet(drowSagaQF("W1", k), 1); drowSagaOccSet(drowSagaQF("B1", k), 1)
                drowSagaOccSet(drowSagaQF("QSRC", k), armed and 2 or 3)
                return finish()
            end
        end
    end
    if e1 and armed then
        drowSagaOccSet(drowSagaQF("C1", k), armedId); drowSagaOccSet(drowSagaQF("W1", k), 1); drowSagaOccSet(drowSagaQF("B1", k), 1)
        drowSagaOccSet(drowSagaQF("QSRC", k), 2)
        drowSagaOccSet(drowSagaQF("QFT_STALE", k), 1)
        return finish()
    end
    drowSagaOccSet(drowSagaQF("QSRC", k), 1)
    local function otherSessionThan(current)
        local d, e, u = drowSagaOccGet(drowSagaQF("QSEEN_D", k), 0), drowSagaOccGet(drowSagaQF("QSEEN_E", k), 0), drowSagaOccGet(drowSagaQF("QSEEN_U", k), 0)
        if u == 1 then return true end
        if current == 1 then return e == 1 end
        if current == 2 then return d == 1 end
        return (d == 1 or e == 1)
    end
    if drowSagaOccGet(drowSagaQF("W1", k), 0) == 1 then
        if changed and e1 then
            drowSagaOccSet(drowSagaQF("C1", k), single)
        elseif e1 and otherSessionThan(drowSagaOccGet(drowSagaQF("C1", k), 0)) then
            drowSagaOccSet(drowSagaQF("C1", k), 0)
        end
    elseif drowSagaOccGet(drowSagaQF("B1", k), 0) == 1 then
        if changed and e1 then
            drowSagaOccSet(drowSagaQF("C1", k), single)
            drowSagaOccSet(drowSagaQF("W1", k), 1)
        elseif e1 then
            local base = string.upper(drowSagaSavePathBasename(e1.fileName) or "")
            local idx = drowSagaFixedSaveIdentity and drowSagaFixedSaveIdentity[base]
            local current = (idx == true) and 1 or ((idx == false) and 2 or 0)
            if otherSessionThan(current) then
                drowSagaOccSet(drowSagaQF("C1", k), 0)
                drowSagaOccSet(drowSagaQF("W1", k), 1)
            end
        end
    else
        drowSagaOccSet(drowSagaQF("B1", k), 1)
    end
    drowSagaOccSet(drowSagaQF("F1", k), f1)
    drowSagaOccSet(drowSagaQF("G1", k), f2)
    drowSagaOccSet(drowSagaQF("QB_ARM", k), 0)
    drowSagaOccSet(drowSagaQF("QB_MIX", k), 0)
    drowSagaOccClearSeenQ(k)
    return true
end

function drowSagaOccReconcileQuickSave()
    local list = nil
    if type(gameSaves) == "table" and type(gameSaves.files) == "table" then
        list = gameSaves.files
    elseif type(rgLoadFiltered) == "table" then
        list = rgLoadFiltered
    end
    if not list then return false end
    local entries, maxk = {}, 1
    for _, v in ipairs(list) do
        if type(v) == "table" and type(v.fileName) == "string" then
            local base = drowSagaSavePathBasename(v.fileName)
            local k = base and drowSagaQuickSlotIndex(base)
            if k and not entries[k] then
                entries[k] = v
                if k > maxk then maxk = k end
            end
        end
    end
    if maxk > drowSagaOccGet("QMAXK", 1) then drowSagaOccSet("QMAXK", maxk) end
    local count = drowSagaQuickSlotCount()
    local timed, allTimed = {}, true
    for k = 1, count do
        local e = entries[k]
        drowSagaOccSet(drowSagaQF("QEX", k), e and 1 or 0)
        if e then
            local ft = tonumber(e.fileTime)
            if ft and ft ~= -1 then table.insert(timed, { k = k, ft = ft }) else allTimed = false end
        end
    end
    drowSagaOccSet("QOBS", 1)
    if allTimed and #timed > 0 then
        table.sort(timed, function(x, y) return x.ft < y.ft end)
        for rank, t in ipairs(timed) do drowSagaOccSet(drowSagaQF("QSEQ", t.k), rank) end
        drowSagaOccSet("QSEQMAX", #timed)
        drowSagaOccSet("QAGE_OK", 1)
    end
    for k = 1, count do
        drowSagaOccReconcileQuickSlot(list, k, entries[k])
    end
    return true
end


function drowSagaOccResolveQuick(k)
    if drowSagaOccGet(drowSagaQF("W1", k), 0) ~= 1 then return nil, false end
    return drowSagaOccNormIdentity(drowSagaOccGet(drowSagaQF("C1", k), 0)), true
end

function drowSagaOccResolveEarly(slotCode)
    if slotCode == 7 then
        if drowSagaOccGet("W7", 0) ~= 1 then return nil, false end
        return drowSagaOccNormIdentity(drowSagaOccGet("C7", 0)), true
    elseif slotCode == 0 then
        if drowSagaOccGet("W0", 0) ~= 1 then return nil, false end
        return drowSagaOccNormIdentity(drowSagaOccGet("C0", 0)), true
    elseif slotCode == 1 then
        if drowSagaOccGet("W1", 0) ~= 1 then return nil, false end
        return drowSagaOccNormIdentity(drowSagaOccGet("C1", 0)), true
    end
    return nil, false
end

drowSagaManualRegSection = "Drow Saga I46 Manual Save Registry v1"

local function drowSagaMrGet(field, default)
    return tonumber(Infinity_GetINIValue(drowSagaManualRegSection, field, default or 0)) or (default or 0)
end
local function drowSagaMrSet(field, value)
    Infinity_SetINIValue(drowSagaManualRegSection, field, tonumber(value) or 0)
end

function drowSagaSaveFolderNumber(basename)
    if type(basename) ~= "string" then return nil end
    local digits = string.match(basename, "^(%d+)%-")
    if not digits then return nil end
    return tonumber(digits)
end

local function drowSagaMrEntryNumber(entry)
    if type(entry) ~= "table" or type(entry.fileName) ~= "string" then return nil end
    local base = drowSagaSavePathBasename(entry.fileName)
    return base and drowSagaSaveFolderNumber(base) or nil
end

local function drowSagaMrFingerprint(entry)
    if type(entry) ~= "table" or type(entry.fileName) ~= "string" then return nil, nil end
    local material = table.concat({
        string.upper(drowSagaSavePathBasename(entry.fileName) or ""),
        tostring(entry.time or ""), tostring(entry.sName or ""), tostring(entry.slotName or "")
    }, "|")
    return drowSagaSaveHash(material, 131), drowSagaSaveHash(material, 257)
end

local function drowSagaMrNameHash(name)
    return drowSagaSaveHash(tostring(name or ""), 131)
end

local function drowSagaMrSaveList()
    if type(gameSaves) == "table" and type(gameSaves.files) == "table" then return gameSaves.files end
    if type(rgLoadFiltered) == "table" then return rgLoadFiltered end
    return nil
end

local function drowSagaMrSyncPresence(list)
    if not list then return false end
    local present, maxn = {}, drowSagaMrGet("MAXN", 0)
    for _, v in ipairs(list) do
        local n = drowSagaMrEntryNumber(v)
        if n then
            present[n] = true; if n > maxn then maxn = n end
            local f1, f2 = drowSagaMrFingerprint(v)
            if f1 and f2 then drowSagaMrSet("F" .. n, f1); drowSagaMrSet("G" .. n, f2) end
        end
    end
    if maxn > 5000 then maxn = 5000 end
    for n = 0, maxn do
        local want = present[n] and 1 or 0
        if drowSagaMrGet("P" .. n, 0) ~= want then
            drowSagaMrSet("P" .. n, want)
            if want == 0 then drowSagaMrSet("I" .. n, 0) end
        end
    end
    drowSagaMrSet("MAXN", maxn)
    return true
end

local function drowSagaMrWorldIdentity()
    return (tonumber(Infinity_GetScriptVarInt("DS_UI_DROW") or 0) == 1) and 1 or 2
end

function drowSagaManualSaveWrite(name, overwriteEntry, requestedIndex)
    drowSagaManualSaveReconcile()
    local identity = drowSagaMrWorldIdentity()
    local pred = -1
    if requestedIndex ~= nil then
        for _, v in ipairs(drowSagaMrSaveList() or {}) do
            if tonumber(v.slotIndex) == tonumber(requestedIndex) then
                pred = drowSagaMrEntryNumber(v) or -1
            end
        end
    end
    drowSagaMrSet("PRED", pred)
    local n = overwriteEntry and drowSagaMrEntryNumber(overwriteEntry) or nil
    if n then
        drowSagaMrSet("I" .. n, identity)
    end
    local k = drowSagaMrGet("PN", 0) + 1
    drowSagaMrSet("PN", k)
    drowSagaMrSet("PI" .. k, identity)
    drowSagaMrSet("PH" .. k, drowSagaMrNameHash(name))
    drowSagaMrSet("PO" .. k, n and 1 or 0)
    return true
end

function drowSagaManualSaveReconcile()
    local list = drowSagaMrSaveList()
    if not list then return false end
    local pn = drowSagaMrGet("PN", 0)
    if pn > 0 then
        local newByName = {}
        for _, v in ipairs(list) do
            local n = drowSagaMrEntryNumber(v)
            local base = (type(v.fileName) == "string") and drowSagaSavePathBasename(v.fileName) or nil
            local rewritten = false
            if n and drowSagaMrGet("P" .. n, 0) == 1 then
                local f1, f2 = drowSagaMrFingerprint(v)
                rewritten = (f1 ~= nil) and (drowSagaMrGet("F" .. n, -1) ~= f1 or drowSagaMrGet("G" .. n, -1) ~= f2)
            end
            if n and base and not drowSagaIsEarlySaveBasename(string.upper(base))
               and (drowSagaMrGet("P" .. n, 0) ~= 1 or rewritten) then
                local h = drowSagaMrNameHash(v.slotName)
                newByName[h] = newByName[h] or {}
                table.insert(newByName[h], n)
            end
        end
        local pend, hasNew = {}, {}
        for k = 1, pn do
            local h = drowSagaMrGet("PH" .. k, 0)
            pend[h] = pend[h] or {}
            table.insert(pend[h], drowSagaMrGet("PI" .. k, 0))
            if drowSagaMrGet("PO" .. k, 0) ~= 1 then hasNew[h] = true end
        end
        for h, ids in pairs(pend) do
            local candidates = newByName[h] or {}
            local same = true
            for i = 2, #ids do if ids[i] ~= ids[1] then same = false end end
            for _, n in ipairs(candidates) do
                if same and (ids[1] == 1 or ids[1] == 2) then
                    drowSagaMrSet("I" .. n, ids[1])
                else
                    drowSagaMrSet("I" .. n, 3)
                end
                drowSagaMrSet("ACT", n)
            end
            if #candidates == 0 and hasNew[h] then
                for _, v in ipairs(list) do
                    local n = drowSagaMrEntryNumber(v)
                    if n and drowSagaMrNameHash(v.slotName) == h then
                        local cur = drowSagaMrGet("I" .. n, 0)
                        if not (same and cur == ids[1]) then drowSagaMrSet("I" .. n, 3) end
                    end
                end
                drowSagaMrSet("ACT", -2)
            end
        end
        for k = 1, pn do drowSagaMrSet("PI" .. k, 0); drowSagaMrSet("PH" .. k, 0); drowSagaMrSet("PO" .. k, 0) end
        drowSagaMrSet("PN", 0)
    end
    drowSagaMrSyncPresence(list)
    return true
end

function drowSagaManualSaveResolve(basename)
    local n = drowSagaSaveFolderNumber(basename)
    if not n then return nil end
    local s = drowSagaMrGet("I" .. n, 0)
    if s == 1 or s == 2 or s == 3 then return s end
    return nil
end


drowSagaQKSig = nil
drowSagaQKLen = nil
drowSagaQKLast = nil
drowSagaQKFirst = nil
drowSagaQKPrev = nil


function drowSagaQuickKeyWatchCore()
    if type(combatLog) ~= "table" then return end
    if drowSagaQKSig == nil then
        local s = Infinity_FetchString(10237)
        drowSagaQKSig = (type(s) == "string" and s ~= "") and s or false
    end
    if not drowSagaQKSig then return end
    local n = #combatLog
    local first = combatLog[1]
    local last = combatLog[n]
    if drowSagaQKLen == nil then
        drowSagaQKLen = n; drowSagaQKFirst = first; drowSagaQKLast = last
        local copy = {}
        for i = 1, n do copy[i] = combatLog[i] end
        drowSagaQKPrev = copy
        return
    end
    if n == drowSagaQKLen and first == drowSagaQKFirst and last == drowSagaQKLast then return end
    local from = 1
    if n > drowSagaQKLen then
        from = drowSagaQKLen + 1
    elseif n == drowSagaQKLen then
        local prev = drowSagaQKPrev or {}
        local shift = n
        for t = 1, n - 1 do
            local same = true
            for i = 1, n - t do
                if combatLog[i] ~= prev[i + t] then same = false; break end
            end
            if same then shift = t; break end
        end
        from = n - shift + 1
    else
    end
    for i = from, n do
        local e = combatLog[i]
        pcall(drowSagaAutoTravelProbe, e)
        if type(e) == "string" and string.find(e, drowSagaQKSig, 1, true) then
            pcall(drowSagaOccQuickSaveDetected)
            local ui = tonumber(Infinity_GetScriptVarInt("DS_UI_DROW") or 0) or 0
        end
    end
    drowSagaQKLen = n; drowSagaQKFirst = first; drowSagaQKLast = last
    local copy = {}
    for i = 1, n do copy[i] = combatLog[i] end
    drowSagaQKPrev = copy
end

function drowSagaQuickKeyWatch()
    pcall(drowSagaQuickKeyWatchCore)
    return false
end


drowSagaATSig = nil

function drowSagaAutoTravelProbe(e)
    if type(e) ~= "string" then return end
    if drowSagaATSig == nil then
        local s = Infinity_FetchString(10689)
        if type(s) == "string" then
            local cut = string.find(s, "<", 1, true)
            local dig = string.find(s, "%d")
            if dig and (not cut or dig < cut) then cut = dig end
            if cut then s = string.sub(s, 1, cut - 1) end
            s = string.gsub(s, "%s+$", "")
        end
        drowSagaATSig = (type(s) == "string" and string.len(s) >= 4) and s or false
    end
    if not drowSagaATSig then return end
    if string.find(e, drowSagaATSig, 1, true) then
        local ui = tonumber(Infinity_GetScriptVarInt("DS_UI_DROW") or 0) or 0
        pcall(drowSagaOccJourneySeen, ui)
    end
end



function drowSagaCaptureFixedSaveIdentity()
    local isLoad = (drowSagaOccGet("NG_FLOW", 0) ~= 1)
    drowSagaOccSet("NG_FLOW", 0)
    drowSagaOccSet("LOAD_ARM", 0)
    drowSagaOccReconcileAutoSave()
    drowSagaOccReconcileQuickSave()
    drowSagaManualSaveReconcile()
    local result = drowSagaCaptureFixedSaveIdentityCore()
    local arm = 3
    if drowSagaSodFixedSaveResolved == true then
        arm = (drowSagaSodFixedSaveDrow == true) and 1 or 2
    end
    drowSagaOccSet("LOAD_ARM", arm)
    return result
end



function drowSagaCaptureFixedSaveIdentityCore()
    drowSagaSodFixedSaveResolved = false
    drowSagaSodFixedSaveDrow = false
    drowSagaSodFixedSaveNeedsEarlyRepair = false
    drowSagaImportedChrDrow = false
    drowSagaChrRecapActive = false

    local v = nil
    if currentSave and rgLoadFiltered then v = rgLoadFiltered[currentSave] end
    drowSagaCapturedSaveProtagonist = (v and type(v.sName) == "string" and v.sName ~= "") and v.sName or nil
    drowSagaSaveImportCharName = nil
    drowSagaSaveImportProtagonistCount = nil
    if not v or type(v.fileName) ~= "string" then
        return false
    end
    local wanted = drowSagaSavePathBasename(v.fileName)
    if not wanted then
        return false
    end
    wanted = string.upper(wanted)
    drowSagaShadowBegin(3, wanted)

    local isEarlySave = drowSagaIsEarlySaveBasename(wanted)
    if isEarlySave then
        local occState, occWritten = drowSagaOccResolveEarly(drowSagaEarlySlotCode(wanted))
        if occState == 1 or occState == 2 then
            local isDrow = (occState == 1)
            drowSagaSodFixedSaveResolved = true
            drowSagaSodFixedSaveDrow = isDrow
            drowSagaSodFixedSaveNeedsEarlyRepair = false
            drowSagaShadowResolve(occState, true, 11, true)
            return true
        end
        if occWritten then
            drowSagaShadowResolve(0, false, 12, true)
            return false
        end
    end

    if not isEarlySave and drowSagaSaveFolderNumber(wanted) == 1 then
        local qState, qWritten = drowSagaOccResolveQuick(drowSagaQuickSlotIndex(wanted) or 1)
        if qState == 1 or qState == 2 then
            local isDrow = (qState == 1)
            drowSagaSodFixedSaveResolved = true
            drowSagaSodFixedSaveDrow = isDrow
            drowSagaSodFixedSaveNeedsEarlyRepair = false
            drowSagaShadowResolve(qState, true, 17, false)
            return true
        end
        if qWritten then
            drowSagaShadowResolve(0, false, 18, false)
            return false
        end
    end

    local manualState = nil
    if not isEarlySave then
        manualState = drowSagaManualSaveResolve(wanted)
    end
    if manualState == 1 or manualState == 2 then
        local isDrow = (manualState == 1)
        drowSagaSodFixedSaveResolved = true
        drowSagaSodFixedSaveDrow = isDrow
        drowSagaSodFixedSaveNeedsEarlyRepair = false
        drowSagaShadowResolve(manualState, true, 15, false)
        return true
    end
    if manualState == 3 then
        drowSagaShadowResolve(0, false, 16, false)
        return false
    end

    local isDrow = drowSagaFixedSaveIdentity[wanted]
    if isDrow ~= nil then
        local early = (isDrow == true and drowSagaFixedSaveNeedsEarlyRepair[wanted] == true)
        drowSagaSodFixedSaveResolved = true
        drowSagaSodFixedSaveDrow = (isDrow == true)
        drowSagaSodFixedSaveNeedsEarlyRepair = early
        drowSagaShadowResolve(isDrow == true and 1 or 2, true, 6, early)
        return true
    end

    drowSagaShadowResolve(0, false, 7, false)
    return false
end

function drowSagaChrFileKey(filename)
	if type(filename) ~= "string" or filename == "" then return nil end
	local h = ""
	for i = 1, #filename do
		h = h .. string.format("%02X", string.byte(filename, i))
	end
	return "F" .. h
end

function drowSagaCurrentExportIsDrow()
	if drowSagaFreshChargenDrow == true then return true end
	if drowSagaChrRecapActive == true then return drowSagaImportedChrDrow == true end
	if CurrentlyInGame and CurrentlyInGame() then
		return tonumber(Infinity_GetScriptVarInt("DS_UI_DROW") or 0) == 1
	end
	return false
end

function drowSagaRefreshChrFileIndexCache()
	local list = list_GUIREC_13_0
	if type(list) ~= "table" then return false end
	for i, filename in ipairs(list) do
		local key = drowSagaChrFileKey(filename)
		local state = -1
		if key then
			state = tonumber(Infinity_GetINIValue(drowSagaChrFilePassportSection, key, -1)) or -1
		end
		Infinity_SetINIValue(drowSagaChrIndexCacheSection, "I" .. tostring(i), state)
	end
	Infinity_SetINIValue(drowSagaChrIndexCacheSection, "COUNT", #list)
	return true
end

function drowSagaRegisterChrExport(filename)
	if type(filename) ~= "string" or filename == "" then return false end
	local key = drowSagaChrFileKey(filename)
	if not key then return false end
	local state = drowSagaCurrentExportIsDrow() and 1 or 0
	Infinity_SetINIValue(drowSagaChrFilePassportSection, key, state)

	local list = list_GUIREC_13_0
	if type(list) == "table" then
		drowSagaRefreshChrFileIndexCache()
		local wanted = string.upper(filename)
		local slot = nil
		for i, existing in ipairs(list) do
			if type(existing) == "string" and string.upper(existing) == wanted then
				slot = i
				break
			end
		end
		if not slot then slot = #list + 1 end
		Infinity_SetINIValue(drowSagaChrIndexCacheSection, "I" .. tostring(slot), state)
		if slot > #list then
			Infinity_SetINIValue(drowSagaChrIndexCacheSection, "COUNT", slot)
		end
	end
	return true
end

function drowSagaSelectChrImportIndex(index)
	if createCharScreen and createCharScreen.GetImportState and createCharScreen:GetImportState() == 2 then
		drowSagaSaveImportCharName = nil
		drowSagaSaveImportProtagonistCount = nil
		local idx = tonumber(index)
		if type(list_GUICG_20_2) == "table" and idx and list_GUICG_20_2[idx] then
			drowSagaSaveImportCharName = tostring(list_GUICG_20_2[idx])
			local c = 0
			for _, n in ipairs(list_GUICG_20_2) do
				if drowSagaCapturedSaveProtagonist and tostring(n) == drowSagaCapturedSaveProtagonist then c = c + 1 end
			end
			drowSagaSaveImportProtagonistCount = c
		end
		drowSagaChrRecapActive = false
		drowSagaChrImportSelectedIndex = nil
		drowSagaChrImportIndexResolved = false
		drowSagaImportedChrDrow = false
		return false
	end

	drowSagaChrImportSelectedIndex = tonumber(index)
	if not drowSagaChrImportSelectedIndex or drowSagaChrImportSelectedIndex < 1 then return false end

	drowSagaConfirmChrImportRecap()

	local shadowChrName = nil
	if type(list_GUICG_20_2) == "table" and drowSagaChrImportSelectedIndex then
		shadowChrName = list_GUICG_20_2[drowSagaChrImportSelectedIndex]
	end
	local shadowChrKey = nil
	if type(shadowChrName) == "string" and shadowChrName ~= "" then
		shadowChrKey = "CHR:" .. shadowChrName
	elseif drowSagaChrImportSelectedIndex then
		shadowChrKey = "CHR:INDEX:" .. tostring(drowSagaChrImportSelectedIndex)
	end
	if shadowChrKey then
		if not drowSagaSourceTxIsLive() or drowSagaShadowGet("KIND") ~= 2 then
			drowSagaShadowBegin(2, shadowChrKey)
		else
			drowSagaShadowRekey(shadowChrKey)
		end
	end
	local state = tonumber(Infinity_GetINIValue(drowSagaChrIndexCacheSection, "I" .. tostring(drowSagaChrImportSelectedIndex), -1))
	if state == 0 or state == 1 then
		drowSagaImportedChrDrow = (state == 1)
		drowSagaChrImportIndexResolved = true
		drowSagaShadowResolve(state == 1 and 1 or 2, true, 2, false)
		return true
	end
	drowSagaShadowResolve(0, false, 0, false)
	return false
end

function drowSagaUiPassportHex(text)
	if type(text) ~= "string" or text == "" then return nil end
	local out = ""
	for i = 1, #text do
		out = out .. string.format("%02X", string.byte(text, i))
	end
	return out
end

function drowSagaUiPassportKey(name, portrait)
	local n = drowSagaUiPassportHex(name)
	local p = drowSagaUiPassportHex(portrait)
	if not n or not p then return nil end
	return "N" .. n .. "P" .. p
end

function drowSagaPersistUiPassport(name, portrait)
	local key = drowSagaUiPassportKey(name, portrait)
	if not key then return false end
	Infinity_SetINIValue(drowSagaUiPassportSection, key, 1)
	return true
end

function drowSagaHasPersistentUiPassport(name, portrait)
	local key = drowSagaUiPassportKey(name, portrait)
	if not key then return false end
	return tonumber(Infinity_GetINIValue(drowSagaUiPassportSection, key, 0)) == 1
end

function drowSagaRefreshImportedChrIdentity()
	if drowSagaChrRecapActive == true and drowSagaChrImportIndexResolved == true then
		return drowSagaImportedChrDrow == true
	end

	local name = chargen and chargen.name or nil
	local portrait = chargen and chargen.portrait or nil
	local hit = drowSagaHasPersistentUiPassport(name, portrait)

	drowSagaImportedChrDrow = (drowSagaFreshChargenDrow ~= true) and hit
	if drowSagaChrRecapActive == true and drowSagaChrImportIndexResolved ~= true then
		if hit then
			drowSagaShadowResolve(1, false, 3, false)
		else
			drowSagaShadowResolve(0, false, 3, false)
		end
	end
	return drowSagaImportedChrDrow
end

function drowSagaResolveOwnedChrIdentity()
	if not drowSagaSourceTxIsLive() or drowSagaSourceTxKind() ~= 2 then return 0 end
	local identity = drowSagaSourceTxIdentity()
	if identity == 1 or identity == 2 then return identity end
	if drowSagaChrRecapActive == true then
		drowSagaRefreshImportedChrIdentity()
		identity = drowSagaSourceTxIdentity()
	end
	if identity == 1 or identity == 2 then return identity end
	return 0
end

function drowSagaSaveImportIsCompanion()
	local sel = drowSagaSaveImportCharName
	local prot = drowSagaCapturedSaveProtagonist
	if type(sel) ~= "string" or type(prot) ~= "string" then return false end
	if sel ~= prot then return true end
	return (tonumber(drowSagaSaveImportProtagonistCount) or 0) ~= 1
end

function drowSagaArmSodSaveImportContext()
	local isSaveImport = (createCharScreen:GetImportState() == 2)
	local isDrowPassport = false
	if isSaveImport and drowSagaSodFixedSaveResolved == true then
		isDrowPassport = (drowSagaSodFixedSaveDrow == true)
	else
		isDrowPassport = drowSagaRefreshImportedChrIdentity() == true
	end
	if isSaveImport and not isDrowPassport then
		local okC, comp = pcall(drowSagaSaveImportIsCompanion)
		if okC and comp then isDrowPassport = true end
	end
	if isSaveImport and isDrowPassport then
		C:SetGlobal("DS_SOD_SAVE_IMPORT_CONTEXT","GLOBAL",1)
	else
		C:SetGlobal("DS_SOD_SAVE_IMPORT_CONTEXT","GLOBAL",0)
	end
end

drowSagaPartySlot = drowSagaPartySlot or 1

function drowSagaSetPending(v)
    local name = drowSagaPendingVar()
    if name == "DS_DROW_PENDING" then
        C:SetGlobal("DS_DROW_PENDING","GLOBAL", v)
    else
        C:SetGlobal(name, "GLOBAL", v)
    end
end

function drowSagaResetPartySlots()
    drowSagaPartySlot = 1
    for k = 2, 6 do C:SetGlobal("DS_DROW_PENDING_" .. k, "GLOBAL", 0) end
    C:SetGlobal("DS_DROW_PARTY_PENDING_ARMED", "GLOBAL", 0)
    drowSagaPartyIdentity = {}
    drowSagaPartyUsed = false
end



function drowSagaBeginNativeChargenSession(startNewProfile)
	drowSagaFreshNativeChargen = true
	drowSagaNativeRaceId = nil
	drowSagaSubraceSelected = 1
	drowSagaSubracePending = 1
	drowSagaFreshChargenDrow = false
	drowSagaChargenIsDrow = false
	drowSagaInfinityUiDrowSelected = false
	drowSagaDefaultAppearanceApplied = false
	drowSagaSetPending(0)
	drowSagaShadowBegin(1, "NATIVE:CHARGEN")
	drowSagaShadowResolve(0, false, 1, false)
	return true
end

function drowSagaCaptureNativeRaceSnapshot()
	if not drowSagaFreshNativeChargen then return false end
	if not drowSagaSourceTxIsLive() or drowSagaSourceTxKind() ~= 1 then return false end
	if createCharScreen and createCharScreen.GetImportState and createCharScreen:GetImportState() ~= 0 then return false end
	local race = chargen and chargen.races and chargen.races[currentChargenRace] or nil
	if not race or race.id == nil then return false end
	drowSagaNativeRaceId = tonumber(race.id) or race.id
	return true
end

function drowSagaFinalizeNativeChargenIdentity()
	drowSagaResolveNativeFromSessionState()
	if not drowSagaFreshNativeChargen then return true end
	if createCharScreen and createCharScreen.GetImportState and createCharScreen:GetImportState() ~= 0 then return true end

	local race = chargen and chargen.races and chargen.races[currentChargenRace] or nil
	local raceId = race and (tonumber(race.id) or race.id) or nil
	if raceId ~= nil then drowSagaNativeRaceId = raceId end
	if raceId == nil then raceId = tonumber(drowSagaNativeRaceId) or drowSagaNativeRaceId end
	if raceId == nil then return false end

	if not drowSagaSourceTxIsLive() or drowSagaSourceTxKind() ~= 1 then
		drowSagaShadowBegin(1, "NATIVE:CHARGEN")
	end

	if raceId == 2 then
		local isDrow = (drowSagaFreshChargenDrow == true) or
			(drowSagaChargenIsDrow == true) or
			(tonumber(drowSagaSubraceSelected or 1) == 2)
		local identity = isDrow and 1 or 2
		drowSagaShadowResolve(identity, true, 1, false)
		drowSagaSetPending(isDrow and 1 or 0)
	else
		drowSagaShadowResolve(0, false, 1, false)
		drowSagaSetPending(0)
	end
	return true
end

function drowSagaResetFreshChargenState()
	drowSagaChrRecapActive = false
	drowSagaImportedChrDrow = false
	drowSagaFreshChargenDrow = false
	drowSagaInfinityUiDrowSelected = false
	drowSagaChrImportSelectedIndex = nil
	drowSagaChrImportIndexResolved = false
end

function drowSagaBeginChrImportRecap()
	return true
end

function drowSagaConfirmChrImportRecap()
	drowSagaSubraceSelected = 1
	drowSagaSubracePending = 1
	drowSagaFreshChargenDrow = false
	drowSagaChargenIsDrow = false
	drowSagaInfinityUiDrowSelected = false
	drowSagaDefaultAppearanceApplied = false
	drowSagaSetPending(0)

	drowSagaChrRecapActive = true
	drowSagaImportedChrDrow = false
	drowSagaChrImportIndexResolved = false
end


function drowSagaInfinityIsElfSelected()
	local race = chargen.races[currentChargenRace]
	return race ~= nil and race.id == 2
end

function drowSagaInfinityDrowHighlight()
	local skin = (RgUISkin * 2)
	if drowSagaInfinityUiDrowSelected or drowSagaChargenIsDrow == true then
		return skin + 1
	end
	return skin
end

drowSagaSubraceSelected = drowSagaSubraceSelected or 1
drowSagaSubracePending = drowSagaSubraceSelected
drowSagaChargenIsDrow = drowSagaChargenIsDrow or false
drowSagaDefaultAppearanceApplied = drowSagaDefaultAppearanceApplied or false

function drowSagaCommitSubraceChoice()
	drowSagaSubraceSelected = drowSagaSubracePending or 1
	drowSagaFreshChargenDrow = (drowSagaSubraceSelected == 2)
	drowSagaChargenIsDrow = drowSagaFreshChargenDrow
	drowSagaShadowBegin(1, "NATIVE:CHARGEN")
	drowSagaShadowResolve(drowSagaFreshChargenDrow and 1 or 2, true, 1, false)
	if drowSagaChargenIsDrow then
		drowSagaSetPending(1)
	else
		drowSagaSetPending(0)
	end
end

function drowSagaSetElfAsDefaultSubrace()
	drowSagaSubraceSelected = 1
	drowSagaSubracePending = 1
	drowSagaFreshChargenDrow = false
	drowSagaChargenIsDrow = false
	drowSagaInfinityUiDrowSelected = false
	drowSagaDefaultAppearanceApplied = false
	drowSagaSetPending(0)
end

function drowSagaWorldBootstrapDrow()
	if Infinity_GetScriptVarInt("DS_DROW_PENDING") == 1 then
		drowSagaSetCanonicalIdentityOnPlayer1()
	end
	pcall(function()
		for k = 2, 6 do
			if Infinity_GetScriptVarInt("DS_DROW_PENDING_" .. k) == 1 then
				C:SetGlobal("DS_DROW_FRESH_" .. k, "GLOBAL", 1)
				C:Eval('ActionOverride(Player' .. k .. ',SetGlobal("DS_DROW","LOCALS",1))')
				C:Eval('ApplySpellRES("DSDROWID",Player' .. k .. ')')
			end
		end
	end)
end

function drowSagaIsChargenDrow()
	return drowSagaFreshChargenDrow == true
end

drowSagaMarkProf = 134
drowSagaReserveProf = 125

drowSagaProfTable = drowSagaProfTable or {}
function drowSagaAbilityDisplayRoll(row)
	local ability = chargen.ability and chargen.ability[row] or nil
	if not ability then return "" end
	local value = tonumber(ability.roll)
	if not value then return ability.roll end
	if drowSagaFreshChargenDrow == true and (row == 2 or row == 4) then
		value = value + 1
	end
	return value
end

local function drowSagaReplaceAbilityValue(info, row, delta)
	local ability = chargen.ability and chargen.ability[row] or nil
	if not ability then return info end
	local label = getUiString(ability.name)
	if not label or label == "" then return info end
	local _, labelEnd = string.find(info, label, 1, true)
	if not labelEnd then return info end
	local numberSearchStart = labelEnd + 1
	local window = string.sub(info, numberSearchStart, math.min(#info, numberSearchStart + 48))
	local nStart, nEnd = string.find(window, "%d+")
	if not nStart then return info end
	local raw = tonumber(string.sub(window, nStart, nEnd))
	if not raw then return info end
	local absoluteStart = numberSearchStart + nStart - 1
	local absoluteEnd = numberSearchStart + nEnd - 1
	return string.sub(info, 1, absoluteStart - 1) .. tostring(raw + delta) .. string.sub(info, absoluteEnd + 1)
end

local function drowSagaInfoAbilityValue(info, row)
	local ability = chargen.ability and chargen.ability[row] or nil
	if not ability then return nil end
	local label = getUiString(ability.name)
	if not label or label == "" then return nil end
	local _, labelEnd = string.find(info, label, 1, true)
	if not labelEnd then return nil end
	local numberSearchStart = labelEnd + 1
	local window = string.sub(info, numberSearchStart, math.min(#info, numberSearchStart + 48))
	local nStart, nEnd = string.find(window, "%d+")
	if not nStart then return nil end
	return tonumber(string.sub(window, nStart, nEnd))
end


local function drowSagaFixEarlySodImportRecap(info)
	if drowSagaImportedChrDrow ~= true then return info end
	if not createCharScreen or createCharScreen:GetImportState() ~= 2 then return info end

	local dex = drowSagaInfoAbilityValue(info, 2)
	local intv = drowSagaInfoAbilityValue(info, 4)
	if dex ~= 19 or intv ~= 18 then return info end

	info = drowSagaReplaceAbilityValue(info, 2, 1)
	info = drowSagaReplaceAbilityValue(info, 4, 1)

	local recapDeltas = {-2, 5, 0, 10, -7, 0, 5}
	local numericRow = 0
	local thiefRow = 0
	local rebuilt = {}
	for line in string.gmatch(info .. "\n", "([^\n]*)\n") do
		local prefix, raw = string.match(line, "^(.-)(%-?%d+)%s*$")
		if prefix and raw then
			numericRow = numericRow + 1
			if numericRow > 6 and thiefRow < 7 then
				thiefRow = thiefRow + 1
				local delta = recapDeltas[thiefRow] or 0
				if delta ~= 0 then
					line = prefix .. tostring(tonumber(raw) + delta)
				end
			end
		end
		table.insert(rebuilt, line)
	end
	if thiefRow == 7 then
		info = table.concat(rebuilt, "\n")
	end

	return info
end

drowSagaEngineRecapRaceIdLast = drowSagaEngineRecapRaceIdLast or nil
drowSagaEngineRecapRaceCount = drowSagaEngineRecapRaceCount or -1
drowSagaEngineRecapRaceLine = drowSagaEngineRecapRaceLine or ""
drowSagaRaceNameCache = drowSagaRaceNameCache or {}

local function drowSagaTrimAll(s)
    s = tostring(s or "")
    s = string.gsub(s, "\194\160", " ")   -- UTF-8 no-break space
    s = string.gsub(s, "\160", " ")       -- Latin-1 no-break space
    return (string.gsub(s, "^%s*(.-)%s*$", "%1"))
end

function drowSagaEngineRecapRaceId()
    local info = (chargen and type(chargen.information) == "string") and chargen.information or ""
    local count = 0
    if chargen and type(chargen.races) == "table" then
        for _, race in ipairs(chargen.races) do
            count = count + 1
            if race and race.id ~= nil and race.name ~= nil then
                local n = drowSagaTrimAll(Infinity_FetchString(race.name))
                if n ~= "" then drowSagaRaceNameCache[n] = tonumber(race.id) or race.id end
            end
        end
    end
    drowSagaEngineRecapRaceCount = count
    local lines = {}
    for l in string.gmatch(info, "[^\r\n]+") do
        table.insert(lines, l)
        if #lines >= 6 then break end
    end
    drowSagaEngineRecapRaceLine = lines[2] or ""
    for i = 1, #lines do
        local value = drowSagaTrimAll(string.match(lines[i], ":([^:]*)$") or "")
        if value ~= "" then
            if drowSagaRaceNameCache[value] ~= nil then return drowSagaRaceNameCache[value] end
            if value == "Elfe" or value == "Elf" or value == "ELFE" or value == "ELF" then return 2 end
        end
    end
    return nil
end

local function drowSagaNativeOwnedByNewGame()
    if drowSagaOccGet("NG_FLOW", 0) ~= 1 then return false end
    if not drowSagaSourceTxIsLive() then return false end
    return drowSagaSourceTxKind() == 1
end

function drowSagaNativeSessionIsDrow()
    return (drowSagaFreshChargenDrow == true) or
        (drowSagaChargenIsDrow == true) or
        (tonumber(drowSagaSubraceSelected or 1) == 2)
end

function drowSagaResolveNativeFromSessionState()
    drowSagaEngineRecapRaceIdLast = drowSagaEngineRecapRaceId()
    if not drowSagaNativeOwnedByNewGame() then return false end
    local identity = drowSagaNativeSessionIsDrow() and 1 or 2
    if drowSagaShadowGet("IDENTITY") == identity and drowSagaShadowGet("EXACT") == 1 then
        return true
    end
    drowSagaShadowResolve(identity, true, 14, false)
    return true
end

function drowSagaNeutralRaceInfo(info)
	local elfName = nil
	for _, race in ipairs(chargen.races or {}) do
		if race.id == 2 then elfName = Infinity_FetchString(race.name); break end
	end
	local candidates = { "Elfe", "ELFE", "Elf", "ELF" }
	if type(elfName) == "string" and elfName ~= "" then table.insert(candidates, 1, elfName) end
	for _, label in ipairs(candidates) do
		local esc = label:gsub("(%W)", "%%%1")
		local out, n = info:gsub(esc, (string.gsub(drowSagaT("elf_or_drow"), "%%", "%%%%")), 1)
		if n > 0 then return out end
	end
	return info
end

function drowSagaChargenInformation()
	local info = chargen.information or ""
	drowSagaResolveNativeFromSessionState()

	local sourceLive = drowSagaSourceTxIsLive()
	local sourceKind = drowSagaSourceTxKind()
	local sourceIdentity = drowSagaSourceTxIdentity()
	local showDrowRace = false

	if sourceLive and sourceKind == 1 then
		drowSagaImportedChrDrow = false
		showDrowRace = (sourceIdentity == 1)
	elseif sourceLive and sourceKind == 2 then
		sourceIdentity = drowSagaResolveOwnedChrIdentity()
		drowSagaImportedChrDrow = (sourceIdentity == 1)
		showDrowRace = (sourceIdentity == 1)
		if sourceIdentity ~= 1 and sourceIdentity ~= 2 then
			local okN, neutral = pcall(drowSagaNeutralRaceInfo, info)
			if okN and type(neutral) == "string" then info = neutral end
		end
	elseif sourceLive and sourceKind == 3 then
		local okC, comp = pcall(drowSagaSaveImportIsCompanion)
		if okC and comp then sourceIdentity = 0 end
		drowSagaImportedChrDrow = (sourceIdentity == 1)
		showDrowRace = (sourceIdentity == 1)
		if sourceIdentity ~= 1 and sourceIdentity ~= 2 then
			local okN, neutral = pcall(drowSagaNeutralRaceInfo, info)
			if okN and type(neutral) == "string" then info = neutral end
		end
	else
		drowSagaImportedChrDrow = false
		showDrowRace = false
	end

	local ownedFreshDrow = false
	local ownedImportedDrow = false
	if sourceLive then
		ownedFreshDrow = (sourceKind == 1 and sourceIdentity == 1)
		ownedImportedDrow = ((sourceKind == 2 or sourceKind == 3) and sourceIdentity == 1)
	else
		ownedFreshDrow = (drowSagaFreshChargenDrow == true)
		ownedImportedDrow = (drowSagaImportedChrDrow == true)
	end

	if not showDrowRace then return info end

	if ownedFreshDrow then
		drowSagaPersistUiPassport(chargen and chargen.name or nil, chargen and chargen.portrait or nil)
	end

	local elfName = nil
	for _, race in ipairs(chargen.races or {}) do
		if race.id == 2 then
			elfName = Infinity_FetchString(race.name)
			break
		end
	end

	local replaced = false
	if elfName and elfName ~= "" then
		local out, n = string.gsub(info, elfName, (string.gsub(drowSagaT("drow"), "%%", "%%%%")), 1)
		if n > 0 then info = out; replaced = true end
	end

	if not replaced then
		for _, label in ipairs({"Elfe","ELFE","Elf","ELF"}) do
			local out, n = string.gsub(info, label, (string.gsub(drowSagaT("drow"), "%%", "%%%%")), 1)
			if n > 0 then info = out; break end
		end
	end

	if ownedFreshDrow then
		info = drowSagaReplaceAbilityValue(info, 2, 1)
		info = drowSagaReplaceAbilityValue(info, 4, 1)
		local okT, fixed = pcall(drowSagaFixRecapThiefSkills, info)
		if okT and type(fixed) == "string" then info = fixed end
	elseif ownedImportedDrow then
		info = drowSagaFixEarlySodImportRecap(info)
	end

	return info
end

function drowSagaInfinityDrowHelp()
	return drowSagaT("drow_desc")
end

function raceOrGeneralHelp()
	if drowSagaInfinityUiDrowSelected and drowSagaInfinityIsElfSelected() then
		return drowSagaInfinityDrowHelp()
	end
	race = chargen.races[currentChargenRace]
	if race then
		return Infinity_FetchString(race.desc)
	else
		return Infinity_FetchString(17237)
	end
end

