	elseif data.paperdollBamDerived == 'RGDIPFH' or data.paperdollBamDerived == 'RGDIPFO' then
		Infinity_SetArea("rgHelmetPaperdoll", 505,275,90,90)
	elseif data.paperdollBamDerived == 'RGDIPMO' then
		Infinity_SetArea("rgHelmetPaperdoll", 503,266,95,95)
	elseif data.paperdollBamDerived == 'RGDIPME' or data.paperdollBamDerived == 'RGDIPFE' then
		Infinity_SetArea("rgHelmetPaperdoll", 504,288,85,85)
	elseif data.paperdollBamDerived == 'RGDIPFL' or data.paperdollBamDerived == 'RGDIPML' then
		Infinity_SetArea("rgHelmetPaperdoll", 502,298,100,100)
	elseif data.paperdollBamDerived == 'RGDIPMD' then
		Infinity_SetArea("rgHelmetPaperdoll", 502,297,100,100)
	elseif data.paperdollBamDerived == 'RGDIPFD' then
		Infinity_SetArea("rgHelmetPaperdoll", 504,297,100,100)
	elseif data.paperdollBamDerived == 'RGDIPMG' or data.paperdollBamDerived == 'RGDIPFG' then
		Infinity_SetArea("rgHelmetPaperdoll", 503,297,100,100)
	else
		Infinity_SetArea("rgHelmetPaperdoll", 0 ,0 ,0,0)
	end
	
	for i=1,#rgIpNpc,1 do
		if rgIpNpc[i].name:lower() == characters[rgInvId].name:lower() and rgIpNpc[i].helmX > 0 then 
			Infinity_SetArea("rgHelmetPaperdoll", rgIpNpc[i].helmX,rgIpNpc[i].helmY,rgIpNpc[i].helmW,rgIpNpc[i].helmW)
		end
	end
end
