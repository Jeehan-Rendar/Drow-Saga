rgScrollWorldMapOnce = 0
function rgScrollWorldMap()
	if rgScrollWorldMapOnce == 0 then
		local w, h = Infinity_GetScreenSize()
		local n = h-768+150
		local m = 500
		if w < 1470 then
			local o = 1470 - w
			m = 500 - o
		end
		worldMapScreen:OnMapMouseDown(0,0)
		worldMapScreen:OnMapMouseMove(m,n)
		rgScrollWorldMapOnce = 1
	end
end
`

