		ScaleToClip
		text "INFORMATION_BUTTON"
		text style "button"
		toggle "levelUpInfoToggle"
		action
		"
			currentChargenProficiency = nil
			currentChargenThiefSkill = nil
		"
	}
	button
	{
		name "rgdlvlInfoButt1"
		enabled "chargen.levelingUp"
