function rgGetFullBodyPortrait(portrait)
    if portrait:sub(-1) == "L" then
        return portrait:sub(1, -2) .. "R"
    else
        return portrait
    end
end
function rgGetSpriteSlotArea()
    if RgInvPaperdolls == 4 then
		Infinity_SetArea("slot_inv_1" , 380, 380, nil ,nil)
		Infinity_SetArea("slot_inv_2" , 380, 440, nil ,nil)
