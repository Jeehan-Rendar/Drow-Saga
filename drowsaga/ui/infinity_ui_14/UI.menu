function rgInvGetSpriteByCharacterID(characterID)
	if EEex_GameObject_Get == nil or characterID == nil then
		return nil
	end
	return EEex_GameObject_Get(characterID)
end

function rgInvGetItemType(itemResref)
	if itemResref == nil or itemResref == "" or EEex_Resource_Demand == nil then
		return -1
	end
	local success, itemType = pcall(function()
		local header = EEex_Resource_Demand(itemResref, "ITM")
		if header == nil then
			return nil
		end
		return EEex_ReadU16(EEex_UDToPtr(header) + 0x1C)
	end)
	if success and itemType ~= nil then
		return itemType
	end
	return -1
end

rgInvLauncherItemTypes = {[15] = true, [18] = true, [27] = true}

function rgInvGetActiveWeaponInfo(character, sprite)
	local out = {slot = "-", name = "-", index = -1, ammoSlot = "-"}
	if character == nil then
		return out
	end

	local selectedWeaponIndex = -1
	if sprite ~= nil and sprite.m_equipment ~= nil and sprite.m_equipment.m_selectedWeapon ~= nil then
		selectedWeaponIndex = sprite.m_equipment.m_selectedWeapon
	end
	out.index = selectedWeaponIndex

	local function setFromSlot(slotName)
		out.slot = slotName
		local slot = character.equipment ~= nil and character.equipment[slotName] or nil
		if slot ~= nil and slot.item ~= nil and slot.item.name ~= nil and slot.item.name ~= "" then
			out.name = slot.item.name
		end
	end

	if selectedWeaponIndex >= 35 and selectedWeaponIndex <= 38 then
		setFromSlot("weapon" .. tostring(selectedWeaponIndex - 35))
	elseif selectedWeaponIndex >= 11 and selectedWeaponIndex <= 14 then
		out.ammoSlot = "quiver" .. tostring(selectedWeaponIndex - 11)
		if character.equipment ~= nil then
			for i = 0, 3 do
				local weaponSlot = "weapon" .. tostring(i)
				local slot = character.equipment[weaponSlot]
				if slot ~= nil and slot.item ~= nil and rgInvLauncherItemTypes[rgInvGetItemType(slot.item.res)] then
					setFromSlot(weaponSlot)
					break
				end
			end
		end
	elseif selectedWeaponIndex == 10 then
		out.slot = "fist"
	elseif selectedWeaponIndex == 34 then
		out.slot = "magic"
	end

	return out
end

function rgInvGetItemWeight(item)
	if item == nil or item.res == nil or item.res == "" or EEex_Resource_Demand == nil then
		return 0
	end
	local success, weight = pcall(function()
		local header = EEex_Resource_Demand(item.res, "ITM")
		if header == nil then
			return nil
		end
		return EEex_ReadU32(EEex_UDToPtr(header) + 0x4C)
	end)
	if not success or weight == nil then
		return 0
	end

	local count = tonumber(item.count)
	if count ~= nil and count > 1 then
		return weight * count
	end
	return weight
end

rgInvCarriedSlotNames = {
	"armor", "gauntlets", "helmet", "amulet", "belt", "ringleft", "ringright", "cloak", "boots", "shield",
	"weapon0", "weapon1", "weapon2", "weapon3",
	"quiver0", "quiver1", "quiver2", "quiver3",
	"personal0", "personal1", "personal2", "personal3",
}
for i = 0, 15 do
	table.insert(rgInvCarriedSlotNames, "group" .. tostring(i))
end

function rgInvGetTotalCarriedWeight(character)
	if character == nil or character.equipment == nil then
		return 0
	end
	local totalWeight = 0
	for _, slotName in ipairs(rgInvCarriedSlotNames) do
		local slotData = character.equipment[slotName]
		if slotData ~= nil and slotData.item ~= nil then
			totalWeight = totalWeight + rgInvGetItemWeight(slotData.item)
		end
	end
	return totalWeight
end

function rgInvGetAnimationID(sprite)
	if sprite == nil or sprite.m_animation == nil or sprite.m_animation.m_animation == nil then
		return -1
	end
	return sprite.m_animation.m_animation.m_animationID or -1
end

rgInvAnimateIDS = nil

function rgInvGetAnimateIDS()
	if rgInvAnimateIDS == nil and EEex_Resource_LoadIDS ~= nil then
		local success, ids = pcall(function() return EEex_Resource_LoadIDS("ANIMATE") end)
		if success then
			rgInvAnimateIDS = ids
		end
	end
	return rgInvAnimateIDS
end

function rgInvGetAnimationSymbol(animationID)
	if animationID == nil or animationID < 0 then
		return "-"
	end
	local ids = rgInvGetAnimateIDS()
	if ids == nil then
		return "-"
	end
	local success, symbol = pcall(function() return ids:getStart(animationID) end)
	if success and symbol ~= nil and symbol ~= "" then
		return symbol
	end
	return "-"
end

function rgInvGetPaperdollBamFromAnimationSymbol(animationSymbol)
	if animationSymbol == nil or animationSymbol == "-" then
		return "-"
	end
	local symbol = string.upper(animationSymbol)
	local sexCode = nil
	if string.find(symbol, "FEMALE", 1, true) ~= nil then
		sexCode = "F"
	elseif string.find(symbol, "MALE", 1, true) ~= nil then
		sexCode = "M"
	end
	local raceCode = nil
	if string.find(symbol, "HALF_ORC", 1, true) ~= nil or string.find(symbol, "HALFORC", 1, true) ~= nil then
		raceCode = "O"
	elseif string.find(symbol, "HALFLING", 1, true) ~= nil then
		raceCode = "L"
	elseif string.find(symbol, "DWARF", 1, true) ~= nil then
		raceCode = "D"
	elseif string.find(symbol, "ELF", 1, true) ~= nil then
		raceCode = "E"
	elseif string.find(symbol, "GNOME", 1, true) ~= nil then
		raceCode = "G"
	elseif string.find(symbol, "HUMAN", 1, true) ~= nil then
		raceCode = "H"
	end
	if sexCode == nil or raceCode == nil then
		return "-"
	end
	return "RGDIP" .. sexCode .. raceCode
end

function rgInvGetPaperdollSequenceFromAnimationSymbol(animationSymbol)
	if animationSymbol == nil or animationSymbol == "-" then
		return 0
	end
	local symbol = string.upper(animationSymbol)
	if string.find(symbol, "MONK", 1, true) ~= nil or string.find(symbol, "CLERIC", 1, true) ~= nil then
		return 0
	elseif string.find(symbol, "FIGHTER", 1, true) ~= nil then
		return 1
	elseif string.find(symbol, "THIEF", 1, true) ~= nil then
		return 2
	elseif string.find(symbol, "MAGE", 1, true) ~= nil then
		return 3
	end
	return 0
end

function rgInvGetPaperdollFrameFromAnimationSymbol(animationSymbol, armorAppearance)
	if armorAppearance == nil or armorAppearance == "" or armorAppearance == "-" then
		return 0
	end
	local symbol = string.upper(animationSymbol or "")
	local isMage = string.find(symbol, "MAGE", 1, true) ~= nil
	local frameMap = { ["2A"] = 1, ["3A"] = 2, ["4A"] = 3, ["2W"] = 1, ["3W"] = 2, ["4W"] = 3 }
	local appearance = string.upper(armorAppearance)
	local frame = frameMap[appearance]
	if frame == nil then
		return 0
	end
	if isMage then
		return string.sub(appearance, 2, 2) == "W" and frame or 0
	else
		return string.sub(appearance, 2, 2) == "A" and frame or 0
	end
end

function rgInvGetDerivedPaperdollInfo(animationID, armorAppearance)
	local animationSymbol = rgInvGetAnimationSymbol(animationID)
	return {
		animationSymbol = animationSymbol,
		animationIDSLine = string.format("0x%04X %s", tonumber(animationID) or 0, animationSymbol),
		bam = rgInvGetPaperdollBamFromAnimationSymbol(animationSymbol),
		sequence = rgInvGetPaperdollSequenceFromAnimationSymbol(animationSymbol),
		frame = rgInvGetPaperdollFrameFromAnimationSymbol(animationSymbol, armorAppearance),
	}
end

function rgInvGetItemEquippedAppearance(itemResref)
	if itemResref == nil or itemResref == "" or EEex_Resource_Demand == nil then
		return "-"
	end
	local success, appearance = pcall(function()
		local header = EEex_Resource_Demand(itemResref, "ITM")
		if header == nil then
			return nil
		end
		local address = EEex_UDToPtr(header) + 0x22
		local out = ""
		for i = 0, 1 do
			local byte = EEex_ReadU8(address + i)
			if byte ~= 0 then
				out = out .. string.char(byte)
			end
		end
		return out
	end)
	if success and appearance ~= nil and appearance ~= "" then
		return appearance
	end
	return "-"
end

function rgInvGetSlotEquippedAppearance(character, slotName)
	if character == nil or character.equipment == nil or slotName == nil or character.equipment[slotName] == nil or character.equipment[slotName].item == nil then
		return "-", "-"
	end
	local itemResref = character.equipment[slotName].item.res
	if itemResref == nil or itemResref == "" then
		return "-", "-"
	end
	return rgInvGetItemEquippedAppearance(itemResref), itemResref
end

function rgInvGetArmorEquippedAppearance(character)
	return rgInvGetSlotEquippedAppearance(character, "armor")
end

function rgInvIsItemTwoHanded(itemResref)
	if itemResref == nil or itemResref == "" or itemResref == "-" or EEex_Resource_Demand == nil then
		return false
	end
	local success, flags = pcall(function()
		local header = EEex_Resource_Demand(itemResref, "ITM")
		if header == nil then
			return nil
		end
		return EEex_ReadU32(EEex_UDToPtr(header) + 0x18)
	end)
	if success and flags ~= nil then
		return EEex_BAnd(flags, 0x2) ~= 0
	end
	return false
end

function rgInvGetSpriteOrderableInfo(sprite)
	local heldValue = 0
	local generalState = -1
	if sprite ~= nil then
		local okHeld, retHeld = pcall(function() return sprite:getStat(58) end)
		if okHeld and retHeld ~= nil then
			heldValue = retHeld
		end
		local okState, retState = pcall(function() return sprite:getState() end)
		if okState and retState ~= nil then
			generalState = retState
		end
	end
	return {
		held = heldValue ~= 0,
		heldValue = heldValue,
		orderableApprox = heldValue == 0,
		generalState = generalState,
	}
end

function rgInvGetSelectedCharacterData()
	local character = nil
	if characters ~= nil then
		character = characters[rgInvId]
	end
	if character == nil then
		return nil
	end

	local sprite = rgInvGetSpriteByCharacterID(rgInvId)
	local activeWeapon = rgInvGetActiveWeaponInfo(character, sprite)
	local animationID = rgInvGetAnimationID(sprite)
	local armorAppearance, armorResref = rgInvGetArmorEquippedAppearance(character)
	local paperdollInfo = rgInvGetDerivedPaperdollInfo(animationID, armorAppearance)
	local helmetAppearance, helmetResref = rgInvGetSlotEquippedAppearance(character, "helmet")
	local shieldAppearance, shieldResref = rgInvGetSlotEquippedAppearance(character, "shield")
	local weaponAppearance, weaponResref = "-", "-"
	if string.sub(activeWeapon.slot, 1, 6) == "weapon" then
		weaponAppearance, weaponResref = rgInvGetSlotEquippedAppearance(character, activeWeapon.slot)
	end
	activeWeapon.twoHanded = rgInvIsItemTwoHanded(weaponResref)

	local majorColor = "-"
	local minorColor = "-"
	if sprite ~= nil and sprite.m_baseStats ~= nil and sprite.m_baseStats.m_colors ~= nil then
		minorColor = tostring(sprite.m_baseStats.m_colors:get(1))
		majorColor = tostring(sprite.m_baseStats.m_colors:get(2))
	end

	local topLevelKeys = {}
	for key, _ in pairs(character) do
		table.insert(topLevelKeys, tostring(key))
	end
	table.sort(topLevelKeys)
	rgEEexPlayerData =
	{
		characterID = rgInvId,
		name = character.name or "-",
		class = character.class or "-",
		activeWeapon = activeWeapon,
		animationID = animationID,
		animationSymbol = paperdollInfo.animationSymbol,
		animationIDSLine = paperdollInfo.animationIDSLine,
		paperdollBamDerived = paperdollInfo.bam,
		paperdollSequenceDerived = paperdollInfo.sequence,
		paperdollFrameDerived = paperdollInfo.frame,
		armorResref = armorResref,
		armorEquippedAppearance = armorAppearance,
		helmetResref = helmetResref,
		helmetEquippedAppearance = helmetAppearance,
		shieldResref = shieldResref,
		shieldEquippedAppearance = shieldAppearance,
		weaponResref = weaponResref,
		weaponEquippedAppearance = weaponAppearance,
		weaponTwoHanded = activeWeapon.twoHanded,
		shieldSlotActive = not activeWeapon.twoHanded,
		paperdollColorMajor = majorColor,
		paperdollColorMinor = minorColor,
		totalCarriedWeight = rgInvGetTotalCarriedWeight(character),
		availableTopLevelKeys = topLevelKeys,
		character = character,
		sprite = sprite,
	}
	rgGetInvPaperdollOffhandOffset()
	rgGetInvPaperdollHelmetOffset()
end

function rgInvGetSelectedCharacterTooltip()
	local data = rgEEexPlayerData
	local maxWeight = rgGetMaxEncumberance()
	if data == nil then
		return "No selected character data"
	end

	local activeWeaponLine = data.activeWeapon.name
	activeWeaponLine = activeWeaponLine .. " (slot: " .. data.activeWeapon.slot .. ", SLOTS.IDS: " .. tostring(data.activeWeapon.index)
	if data.activeWeapon.ammoSlot ~= "-" then
		activeWeaponLine = activeWeaponLine .. ", ammo: " .. data.activeWeapon.ammoSlot
	end
	activeWeaponLine = activeWeaponLine .. ")"

	return "EEex / IUI++ snapshot\n"
		.. "ID: " .. tostring(data.characterID) .. "\n"
		.. "Animation ID: " .. string.format("0x%04X", tonumber(data.animationID) or 0) .. " (" .. tostring(data.animationID) .. ")\n"
		.. "Animation IDS: " .. tostring(data.animationIDSLine) .. "\n"
		.. "Derived paperdoll: bam=" .. tostring(data.paperdollBamDerived) .. ", seq=" .. tostring(data.paperdollSequenceDerived) .. ", frame=" .. tostring(data.paperdollFrameDerived) .. "\n"
		.. "Armor: " .. tostring(data.armorResref) .. ", " .. tostring(data.armorEquippedAppearance) .. "\n"
		.. "Helmet: " .. tostring(data.helmetResref) .. ", " .. tostring(data.helmetEquippedAppearance) .. "\n"
		.. "Shield: " .. tostring(data.shieldResref) .. ", " .. tostring(data.shieldEquippedAppearance) .. "\n"
		.. "Weapon: " .. tostring(data.weaponResref) .. ", " .. tostring(data.weaponEquippedAppearance) .. "\n"
		.. "Shield slot active: " .. tostring(data.shieldSlotActive) .. "\n"
		.. "Paperdoll major/minor color: " .. tostring(data.paperdollColorMajor) .. " / " .. tostring(data.paperdollColorMinor) .. "\n"
		.. "Total carried item weight: " .. tostring(data.totalCarriedWeight) .. "\n"
		.. "Weight allowance: " .. maxWeight
end

