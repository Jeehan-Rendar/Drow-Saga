function rgSetUIZoomText()
	local t = 100 - (RgSettingEEexZoomUI * 3)
	return t .. ' %'
end
function rgSetUIZoomWidth()
	local res = 1365 + (82 * RgSettingEEexZoomUI)
	return res
end
function rgGetUISkinString()
	if rgUISkin == 0 then
		return getUiString('RG_SET_SKIN_SOD')
	elseif rgUISkin == 1 then
		return getUiString('RG_SET_SKIN_IWD')
	elseif rgUISkin == 2 then
		return getUiString('RG_SET_SKIN_BG1')
	else
		return getUiString('RG_SET_SKIN_BG2')
	end
end

function rgGetSelectedUiOption(opt)
	
	if rgUiOptSelected == opt then
		return (RgUISkin*2) + 1
	else
		return RgUISkin*2
	end
end

function rgGetUiOptDescription()
	
	if rgUiOptSelected == 0 then
		return getUiString('RG_SET_DESC')
	elseif rgUiOptSelected == 1 then
		return getUiString('RG_SET_FREE_MSGBOX_D')
	elseif rgUiOptSelected == 2 then
		return getUiString('RG_SET_MODERN_HUD_D')
	elseif rgUiOptSelected == 3 then
		return getUiString('RG_SET_MODERN_HUD_R_D')
	elseif rgUiOptSelected == 4 then
		return getUiString('RG_SET_HOTKEY_BUTT_D')
	elseif rgUiOptSelected == 5 then
		return getUiString('RG_SET_BOTTOM_QLOOT_D')
	elseif rgUiOptSelected == 6 then
		return getUiString('RG_SET_INV_LOAD_D')
	elseif rgUiOptSelected == 7 then
		return getUiString('RG_SET_SPACE_DLG_D')
	elseif rgUiOptSelected == 8 then
		return getUiString('RG_SET_QLOOT_ROWS_D')
	elseif rgUiOptSelected == 9 then
		return getUiString('RG_SET_SKIN_D')
	elseif rgUiOptSelected == 10 then
		return getUiString('RG_SET_EEEX_ZOOM_D')
	elseif rgUiOptSelected == 11 then
		return getUiString('RG_SET_BEST_KOEF_D')
	elseif rgUiOptSelected == 12 then
		return getUiString('RG_SET_LARGE_PORT_D')
	elseif rgUiOptSelected == 13 then
		return getUiString('RG_SET_CENTER_QLOOT_D')
	elseif rgUiOptSelected == 14 then
		return getUiString('RG_SET_EEEX_PCEFF_D')
	elseif rgUiOptSelected == 15 then
		return getUiString('RG_SET_EEEX_NPCBAR_D')
	elseif rgUiOptSelected == 16 then
		return getUiString('RG_SET_INV_SPRITE_D')
	elseif rgUiOptSelected == 17 then
		return getUiString('RG_SET_EEEX_ITEMCOMP_D')
	else
		return getUiString('RG_SET_DESC')
	end
end

function rgIsRightHudClickable()
	
	if rgIsModernHud == 1 and rgMessageboxUnlocked == 1 then
		return true
	else
		return false
	end
end

function rgGetNewPaperdollString()
	if rgInvPaperdolls == 0 then
		return getUiString('RG_SET_INV_SPRITE_OLD')
	elseif rgInvPaperdolls == 1 then
		return getUiString('RG_SET_INV_SPRITE_NEW')
	elseif rgInvPaperdolls == 2 then
		return getUiString('RG_SET_INV_SPRITE_POR')
	elseif rgInvPaperdolls == 3 then
		return getUiString('RG_SET_INV_SPRITE_FBP')
	else
		return getUiString('RG_SET_INV_SPRITE_NON')
	end
end

`
