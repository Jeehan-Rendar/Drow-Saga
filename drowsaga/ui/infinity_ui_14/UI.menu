    if RgInvPartyModeHover == 1 and rgInventoryMode == 0 then
	
		if rgCurChar ~= rgInvChar then
			rgCurChar = rgInvChar
			Infinity_PressKeyboardButton(rgInvChar) 
			
		end
	end
end

