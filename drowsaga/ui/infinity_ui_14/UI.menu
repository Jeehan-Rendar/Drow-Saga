		local code = tostring(data.helmetEquippedAppearance)
		for i=1,#rgEEexHelmets,1 do
			if rgEEexHelmets[i].name == code then 
				return rgEEexHelmets[i].frame
			end
		end
    return nil
end

function rgGetInvPaperdollHelmetOffset()
	local data = rgEEexPlayerData
	if data.paperdollBamDerived == 'RGDIPMH' then
