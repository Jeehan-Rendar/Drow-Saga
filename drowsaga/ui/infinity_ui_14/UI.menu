rgChooseSpellsMenuList2PlaceHolder = {}
rgChooseSpellsMenuList3PlaceHolder = {}
rgChooseSpellsMenuList4PlaceHolder = {}
rgChooseSpellsMenuList5PlaceHolder = {}
