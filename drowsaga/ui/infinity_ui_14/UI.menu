	[15] = "weapon", [16] = "weapon", [17] = "weapon", [18] = "weapon", [19] = "weapon", [20] = "weapon",
	[21] = "weapon", [22] = "weapon", [23] = "weapon", [24] = "weapon", [25] = "weapon", [26] = "weapon",
	[27] = "weapon", [28] = "weapon", [29] = "weapon", [30] = "weapon", [44] = "weapon", [57] = "weapon",
	[69] = "weapon",
}
function rgInvSlotHasItem(character, slotName)
	local slot = character.equipment[slotName]
	return slot ~= nil and slot.item ~= nil and slot.item.name ~= nil and slot.item.name ~= ""
end
function rgGetTempItemRes()
	if tempStats[rgInvId] == nil then return nil end
	for i = #rgItemDescList, 1, -1 do
		if rgItemDescList[i][1] == tempStats[rgInvId].tempItem then
			return rgItemDescList[i][3]
		end
	end
	return nil
end
function rgGetCurrentItemSlotName()
	local character = characters[rgInvId]
	if character == nil or character.equipment == nil then return nil end
	local category = rgInvItemTypeToSlot[rgInvGetItemType(rgGetTempItemRes())]
	if category == nil then return nil end

	if category == "weapon" then
		local info = rgInvGetActiveWeaponInfo(character, rgInvGetSpriteByCharacterID(rgInvId))
		if string.sub(info.slot, 1, 6) == "weapon" then return info.slot end
		for i = 0, 3 do
			if rgInvSlotHasItem(character, "weapon" .. i) then return "weapon" .. i end
		end
		return nil
	elseif category == "quiver" then
		local info = rgInvGetActiveWeaponInfo(character, rgInvGetSpriteByCharacterID(rgInvId))
		if info.ammoSlot ~= "-" and rgInvSlotHasItem(character, info.ammoSlot) then return info.ammoSlot end
		for i = 0, 2 do
			if rgInvSlotHasItem(character, "quiver" .. i) then return "quiver" .. i end
		end
		return nil
	elseif category == "ring" then
		if rgInvSlotHasItem(character, "ringleft") then return "ringleft" end
		if rgInvSlotHasItem(character, "ringright") then return "ringright" end
		return nil
	end

	if rgInvSlotHasItem(character, category) then return category end
	return nil
end

function rgGetSkinContrast()
	if RgUISkin == 1 or RgUISkin == 2 then
		return 1
	else
		return 0
	end
end
function rgGetTempStatColor(txt)
	if txt:find("^R", 1, true) == 1 then
		return "^G"
	elseif txt:find("^G", 1, true) == 1 then
		return "^R"
	else
		if RgUISkin == 1 or RgUISkin == 2 then
			return '^5'
		else
			return '^B'
		end
	end
end
function rgGetTempStatNeutralColor()
	if RgUISkin == 1 or RgUISkin == 2 then
		return '^5'
	else
		return '^B'
	end
end

rgItemComparisonList = {}
function rgGetFullItemComparison()
	if tempStats[rgInvId] == nil then
		rgItemComparisonList = {}
		return false
	end
	local head = '^D'
	local body = '^B'
	if RgUISkin == 1 or RgUISkin == 2 then
		head = '^M'
		body = '^5'
	end
	rgItemComparisonList = {}
	local slotName = rgGetCurrentItemSlotName()
	local item = {}
	local curHeader = ''
	local curDesc = ''
	if slotName ~= nil then
		item = characters[rgInvId].equipment[slotName].item
		curHeader = head .. item.name
		curDesc = body .. '\n' .. rgSplitByDoubleLine(item.description or "")	
	else
		curHeader = head .. t('RG_INV_EMPTY_SLOT')
	end
	
	local newDesc = ''
	local newHeader = ''
	for i=1,#rgItemDescList,1 do
		if rgItemDescList[i][1] == tempStats[rgInvId].tempItem  then
			newHeader =  head .. tempStats[rgInvId].tempItem
			newDesc = body .. '\n' .. rgSplitByDoubleLine(rgItemDescList[i][2])
			break
		end
	end
	
	table.insert(rgItemComparisonList, {0,curHeader,newHeader}) 
	
	local cur = ''
	local new = ''
	if rgGetTempAC() ~= "-" then
		cur = '     ' .. rgGetTempStatColor(rgGetTempAC()) .. characters[rgInvId].AC.current
		new = '     ' .. rgGetTempAC()
		table.insert(rgItemComparisonList, {1,cur,new}) 
	end
	if rgGetTempHP() ~= "-" then
		cur = '     ' .. rgGetTempStatColor(rgGetTempHP()) .. characters[rgInvId].HP.current .. '/' .. characters[rgInvId].HP.max
		new = '     ' .. rgGetTempHP()
		table.insert(rgItemComparisonList, {2,cur,new}) 
	end
	if rgGetTempTHAC0() ~= "-" then
		cur = '     ' .. rgGetTempStatColor(rgGetTempTHAC0()) .. characters[rgInvId].THAC0.current --rgGetTHAC0simleInv(rgInvId)
		new = '     ' .. rgGetTempTHAC0()
		table.insert(rgItemComparisonList, {3,cur,new}) 
	end
	if rgGetTempDamage() ~= "-" then
		local dmgMinClr = rgGetTempStatColor(getTempStat(characters[rgInvId].damage.min,'dmgMin',1))
		local dmgMaxClr = rgGetTempStatColor(getTempStat(characters[rgInvId].damage.max,'dmgMax',1))
		cur = '     ' .. dmgMinClr .. characters[rgInvId].damage.min .. rgGetTempStatNeutralColor() .. ' - ' .. dmgMaxClr .. characters[rgInvId].damage.max --rgGetDamagesimleInv(rgInvId)
		new = '     ' .. rgGetTempDamage()
		table.insert(rgItemComparisonList, {4,cur,new}) 
	end
	if rgGetTempAPR() ~= "-" then
		cur = '     ' .. rgGetTempStatColor(rgGetTempAPR()) .. characters[rgInvId].proficiencies.numAttacks.current
		new = '     ' .. rgGetTempAPR()
		table.insert(rgItemComparisonList, {5,cur,new}) 
	end
	
	table.insert(rgItemComparisonList, {0,curDesc,newDesc}) 
	
	if tempStats[rgInvId].tempItem == '' then
		rgItemDescList = {}
		rgItemComparisonList = {}
	end
	
	return true
end
function rgTrimString(str)
	return (str:gsub("^%s+", ""):gsub("%s+$", ""))
end
function rgGetWeaponProficiencyPips(weaponName)
	local profs = characters[rgInvId].proficiencies.weapons.current
	if profs == nil or weaponName == nil then return nil end
	local wanted = string.lower(rgTrimString(weaponName:gsub("%^.", "")))
	for line in string.gmatch(profs, "[^\r\n]+") do
		line = line:gsub(" / ", " ")
		line = line:gsub("/", " ")
		local clean = line:gsub("%^.", "")
		local pips = clean:match("(%++)%s*$") or ""
		local name = rgTrimString(clean:gsub("%++%s*$", ""):gsub("[:%s]+$", ""))
		if string.lower(name) == wanted then
			return pips
		end
	end
	return nil
end
function rgAddProficiencyPips(line)
	
	local name = rgTrimString(line)
	if name == "" then return line end
	local pips = rgGetWeaponProficiencyPips(name)
	if pips == nil or pips == "" then pips = "-" end
	return line:gsub("%s+$", "") .. " (" .. pips .. ")"
end
function rgSplitByDoubleLine(str) 
	local Lines = {}
	local finLines = {}
	local stat = false
	str = str:gsub("/", " ")
	for i in string.gmatch(str, "[^\r\n\r\n]+") do
		if rgStringStart(i,getUiString("RG_ITM_COMP_ST")) then
			stat = true
		elseif rgStringStart(i,getUiString("RG_ITM_COMP_WE")) or rgStringStart(i,getUiString("RG_ITM_COMP_RE")) then
			stat = false
		elseif rgStringStart(i,"THAC0") then
			i = i:gsub("THAC0", "\nTHAC0")
		end
		local isProfLine = rgStringStart(i,getUiString("RG_ITM_COMP_PR"))
		i = i:gsub(getUiString("RG_ITM_COMP_PR"), "")
		if isProfLine then
			i = rgAddProficiencyPips(i)
		end
		i = i:gsub(getUiString("RG_ITM_COMP_DA"), "")
		i = i:gsub(getUiString("RG_ITM_COMP_TY"), "")
		if stat == true  then --and not rgStringStart(i,"STAT")
			table.insert(Lines, i);
		end
	end	
	
	table.remove(Lines, 1) 
	local x = table.concat(Lines, "\n") 
	local part1, part2 = x:match("^(.-)\r?\n\r?\n(.*)$")
	if part1 and part2 then
		return part2 .. "\n\n" .. part1
	end
	
	
	
	return trim(table.concat(Lines, "\n") )
end
function rgStringStart(str,start)
    return str:find('^' .. start) ~= nil
end

