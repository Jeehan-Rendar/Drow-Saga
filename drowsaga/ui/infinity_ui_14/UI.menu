end

function rgGetXPLevelTable()
	if rgXPLevelTable ~= nil then return rgXPLevelTable end
	if not EEex_Active or EEex_Resource_Load2DA == nil then return nil end
	local ok, result = pcall(function()
		local array = EEex_Resource_Load2DA("XPLEVEL")
		local sizeX, sizeY = array:getDimensions()
		local out = { _order = {} }
		for row = 0, sizeY - 1 do
			local label = string.upper(array:getRowLabel(row))
			local values = {}
			for col = 0, sizeX - 2 do
				local v = tonumber(array:getAtPoint(col, row))
				if v == nil then break end
				values[col + 1] = v
			end
			if label ~= "" and #values > 0 then
				out[label] = values
				table.insert(out._order, label)
			end
		end
		return out
	end)
	if ok and result ~= nil and #result._order > 0 then
		rgXPLevelTable = result
	end
	return rgXPLevelTable
end
function rgGetEngineXPList(classIndex, preferredRows, staticList)
	local xpTable = rgGetXPLevelTable()
	if xpTable == nil then return staticList end
	local classKeys = { "first", "second", "third" }
	local classLevel = characters[currentID].classlevel[classKeys[classIndex]]
	local level = rgGetClassLevelInt(classIndex)
	if classLevel == nil or level == nil then return staticList end

	local candidates = {}
	for _, label in ipairs(preferredRows or {}) do table.insert(candidates, label) end
	for _, label in ipairs(xpTable._order) do table.insert(candidates, label) end

	for _, label in ipairs(candidates) do
		local values = xpTable[label]
		if values ~= nil and values[level] ~= nil and values[level + 1] == classLevel.nextLvlXp then
			return values
		end
	end
	for _, label in ipairs(preferredRows or {}) do
		if xpTable[label] ~= nil then return xpTable[label] end
	end
	return staticList
end

function rgGetEngineClassRows(characterID)
	if not EEex_Active or EEex_GameObject_Get == nil or EEex_Resource_LoadIDS == nil then return nil end
	local ok, rows = pcall(function()
		local sprite = EEex_GameObject_Get(characterID)
		if sprite == nil then return nil end
		if rgClassIDS == nil then rgClassIDS = EEex_Resource_LoadIDS("CLASS") end
		local symbol = rgClassIDS:getStart(sprite.m_typeAI.m_Class)
		if symbol == nil or symbol == "" then return nil end
		local out = {}
		for part in string.gmatch(string.upper(symbol), "[^_]+") do
			table.insert(out, part)
		end
		return out
	end)
	if ok then return rows end
	return nil
end
function rgBuildXPRowCandidates(engineRows, classIndex, fallbackRows)
	local out = {}
	if engineRows ~= nil then
		if engineRows[classIndex] ~= nil then table.insert(out, engineRows[classIndex]) end
		for i, label in ipairs(engineRows) do
			if i ~= classIndex then table.insert(out, label) end
		end
	end
	for _, label in ipairs(fallbackRows or {}) do table.insert(out, label) end
	return out
end

