`
function drowSagaDrowThiefSkillDelta(rowNumber)
		local dexAbility = chargen.ability and chargen.ability[2] or nil
		local engineDex = dexAbility and tonumber(dexAbility.roll) or nil

		local raceDelta = { -5, 5, 0, -5, -10, 0, 0 }

		local skillDex = {
			[9]  = {-15,-10,-10,-20,-10,0,-10},
			[10] = {-10,-5,-10,-15,-5,0,-10},
			[11] = {-5,0,-5,-10,0,0,-5},
			[12] = {0,0,0,-5,0,0,0},
			[13] = {0,0,0,0,0,0,0},
			[14] = {0,0,0,0,0,0,0},
			[15] = {0,0,0,0,0,0,0},
			[16] = {0,5,0,0,0,0,0},
			[17] = {5,10,0,5,5,0,0},
			[18] = {10,15,5,10,10,0,5},
			[19] = {15,20,10,15,15,0,10},
			[20] = {20,25,15,18,18,0,15}
		}

		local delta = raceDelta[rowNumber] or 0
		if engineDex and skillDex[engineDex] and skillDex[engineDex + 1] then
			delta = delta + skillDex[engineDex + 1][rowNumber] - skillDex[engineDex][rowNumber]
		end
		return delta
end

function drowSagaThiefSkillValue(rowNumber)
	local value = chargen.thief_skill[rowNumber].value

	if drowSagaChargenIsDrow and not chargen.levelingUp and not drowSagaImportRecapMode then
		value = value + drowSagaDrowThiefSkillDelta(rowNumber)
	end

	return value
end

function drowSagaFixRecapThiefSkills(info)
	if type(info) ~= "string" or not chargen or type(chargen.thief_skill) ~= "table" then return info end
	for row, skill in ipairs(chargen.thief_skill) do
		local name = skill and skill.name and Infinity_FetchString(skill.name) or nil
		local engineValue = skill and tonumber(skill.value) or nil
		if name and name ~= "" and engineValue then
			local delta = drowSagaDrowThiefSkillDelta(row)
			if delta ~= 0 then
				local esc = name:gsub("(%W)", "%%%1")
				info = info:gsub("(" .. esc .. "%s*:%s*)(%d+)", function(head, num)
					if tonumber(num) == engineValue then return head .. tostring(engineValue + delta) end
					return head .. num
				end, 1)
			end
		end
	end
	return info
end

function proficiencyOrGeneralHelp()
	local prof = chargen.proficiency[currentChargenProficiency]
	local skill = chargen.thief_skill[currentChargenThiefSkill]
	if prof and prof.desc ~= -1 then
		return Infinity_FetchString(prof.desc)
	elseif skill and skill.desc ~= -1 then
		return Infinity_FetchString(skill.description)
	else
		if(chargen.levelingUp) then
			if(levelUpInfoToggle == 1) then
				return chargen.charInfo
			else
				return chargen.levelInfo
			end
		else
		return rgGetGameEngineString(24315,24315,9588,9588) 
	end
	end
end

function getProficienciesTitle()
	if(chargen.levelingUp) then
		return getUiString("LEVEL_UP_TITLE")
	else
		return getUiString("SKILLS_LABEL")
	end
end

function isChargenProficienciesBackButtonClickable()
	return ((not chargen.levelingUp) and createCharScreen:GetCurrentStep() ~= const.STEP_DUALCLASS_PROFICIENCIES)
end

function rgGetProficiencyElementsArea()
	if chargen.levelingUp then
		Infinity_SetArea('proficiencyText',nil,nil,nil,486)
	else
		Infinity_SetArea('proficiencyText',nil,nil,nil,538)
	end
	
	if chargen.levelingUp and rgGameEngine == 2 then
		Infinity_SetArea('chargenProfBackButton',204,nil,nil,nil)
		Infinity_SetArea('chargenProfDoneButton',844,nil,nil,nil)
	else
		Infinity_SetArea('chargenProfBackButton',316,nil,nil,nil)
		Infinity_SetArea('chargenProfDoneButton',732,nil,nil,nil)
	end
end
`

