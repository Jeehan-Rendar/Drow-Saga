ACTION_IF (ds_bebe_ok = 2) AND FILE_EXISTS_IN_GAME ~AERIEBAB.ITM~ AND FILE_EXISTS_IN_GAME ~CUT245A.BCS~ BEGIN
  OUTER_SET ds_cut_ok = 0
  COPY_EXISTING ~CUT245A.BCS~ ~override/DSCUT245.BCS~
    DECOMPILE_AND_PATCH BEGIN
      SET a1 = INDEX_BUFFER (CASE_INSENSITIVE EXACT_MATCH ~"aeriebab"~)
      SET a2 = RINDEX_BUFFER (CASE_INSENSITIVE EXACT_MATCH ~"aeriebab"~)
      PATCH_IF (a1 >= 0) AND (a1 = a2) BEGIN
        REPLACE_TEXTUALLY CASE_INSENSITIVE EXACT_MATCH ~"aeriebab"~ ~"dsaerbab"~
        SET ds_cut_ok = 1
      END
    END
  LAF ds_e2_cherche STR_VAR dlg = ~BAERIE25~ aiguille = ~si vous restez près de moi~ RET n RET_ARRAY ds_e2_et END
  ACTION_IF (ds_cut_ok = 1) AND (n = 1) BEGIN
    COPY_EXISTING ~AERIEBAB.ITM~ ~override/DSAERBAB.ITM~
      WRITE_ASCII 0x3a ~DSAERBI~ #8
      WRITE_ASCII 0x44 ~DSAERBG~ #8
    OUTER_SET ds_bebe_e = $ds_e2_et(~0~)
    LAF ds_e2_compile STR_VAR fichier = ~drowsaga/contenu/e2/tmp_bebe.d~ texte = EVAL ~EXTEND_BOTTOM #T#BAERIE25#T# %ds_bebe_e% IF #T#GlobalGT("DS_P1_DROW","GLOBAL",0)#T# THEN DO #T#SetGlobal("AerieHadBaby","GLOBAL",1) StartCutSceneMode() StartCutScene("dscut245")#T# EXIT END~ END
  END ELSE BEGIN
    WARN ~Drow Saga : naissance d'Aerie inattendue (CUT245A ou BAERIE25), bébé laissé tel quel.~
  END
END
