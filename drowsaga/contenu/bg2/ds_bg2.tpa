EXTEND_TOP ~BALDUR.BCS~ ~drowsaga/contenu/bg2/ds_bg2_soa.baf~
ACTION_IF FILE_EXISTS_IN_GAME ~BALDUR25.BCS~ BEGIN
  EXTEND_TOP ~BALDUR25.BCS~ ~drowsaga/contenu/bg2/ds_bg2.baf~
END

INCLUDE ~drowsaga/contenu/e2/ds_e2_lib.tpa~

WITH_TRA ~drowsaga/tra/%LANGUAGE%/bg2.tra~ BEGIN
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@5) requis = 1 STR_VAR cle = ~E1_4R~ dlg = ~BYOSHIM~ aiguille = ~J'ai beaucoup appris auprès des moines et des érudits~ END
  OUTER_SPRINT ds_bg2_cibles ~~
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@1) requis = 1 STR_VAR cle = ~E1_1~ dlg = ~IMOEN10~ aiguille = ~Vous étiez avec Gorion. Il me semble que je suis arrivée plus tard~ cibles = EVAL ~%ds_bg2_cibles%~ RET ds_bg2_cibles = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@2) requis = 1 STR_VAR cle = ~E1_2~ dlg = ~IMOEN10~ aiguille = ~Je suis Imoen. Nous avons vécu ensemble pendant des années~ cibles = EVAL ~%ds_bg2_cibles%~ RET ds_bg2_cibles = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@4) requis = 1 STR_VAR cle = ~E1_4~ dlg = ~BYOSHIM~ aiguille = ~Comment était-ce d'y grandir avec votre père adoptif~ cibles = EVAL ~%ds_bg2_cibles%~ RET ds_bg2_cibles = cibles END
  LAF ds_e2_redirige STR_VAR cibles = EVAL ~%ds_bg2_cibles%~ END
  LAF ds_e2_dit_fin INT_VAR ref = RESOLVE_STR_REF(@3) STR_VAR cle = ~E1_3~ dlg = ~YOSHIMO~ aiguille = ~Ainsi, il y a donc un peu de bon sens au cœur de cette folie~ END
  LAF ds_e2_dit_fin INT_VAR ref = RESOLVE_STR_REF(@6) STR_VAR cle = ~E1_6~ dlg = ~ILYICH~ aiguille = ~'Tention les gars, v'là de la compagnie~ END
END

ACTION_IF FILE_EXISTS_IN_GAME ~sevbar01.dlg~ BEGIN
  LAF ds_e2_compile STR_VAR fichier = ~drowsaga/contenu/e2/tmp_sevbar.d~ texte = ~APPEND #T#SEVBAR01#T# IF WEIGHT #-9 #T#CheckSpellState(LastTalkedToBy,DS_DROW_PASSPORT)#T# THEN BEGIN #T#DS_E2_SEVBAR#T# SAY #47381 IF #T##T# THEN EXIT END END~ END
END

COPY_EXISTING ~IMOEN10.DLG~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    REPLACE_TEXTUALLY CASE_SENSITIVE EXACT_MATCH ~!GlobalGT("DS_P1_DROW","GLOBAL",0)~ ~!CheckSpellState(Player1,DS_DROW_PASSPORT)~
    REPLACE_TEXTUALLY CASE_SENSITIVE EXACT_MATCH ~GlobalGT("DS_P1_DROW","GLOBAL",0)~ ~CheckSpellState(Player1,DS_DROW_PASSPORT)~
  END
BUT_ONLY


WITH_TRA ~drowsaga/tra/%LANGUAGE%/bg2.tra~ BEGIN
  COMPILE EVALUATE_BUFFER ~drowsaga/contenu/bg2/ds_lot4.d~ USING ~drowsaga/tra/%LANGUAGE%/bg2.tra~

DEFINE_ACTION_FUNCTION ds_jour_bg2
  STR_VAR dlg = ~~ paires = ~~
BEGIN
  ACTION_CLEAR_ARRAY ds_jb_o
  ACTION_CLEAR_ARRAY ds_jb_n
  OUTER_SET nb = 0
  OUTER_PATCH ~%paires%~ BEGIN
    REPLACE_EVALUATE ~\([0-9]+\):\([0-9]+\)~ BEGIN
      SET $ds_jb_o(~%nb%~) = MATCH1
      SET $ds_jb_n(~%nb%~) = MATCH2
      SET nb = nb + 1
    END ~%MATCH0%~
  END
  ACTION_IF FILE_EXISTS_IN_GAME ~%dlg%.dlg~ BEGIN
    ACTION_CLEAR_ARRAY ds_jb_i
    ACTION_CLEAR_ARRAY ds_jb_j
    OUTER_SET n = 0
    COPY_EXISTING ~%dlg%.dlg~ ~override~
      READ_LONG 0x08 ns
      READ_LONG 0x0c so
      READ_LONG 0x14 to
      READ_LONG 0x28 ao
      FOR (i = ns - 1; i >= 0; --i) BEGIN
        READ_LONG (so + i * 0x10 + 0x04) ft
        READ_LONG (so + i * 0x10 + 0x08) nt
        FOR (j = nt - 1; j >= 0; --j) BEGIN
          SET t = to + (ft + j) * 0x20
          READ_LONG t fl
          SET jr = 0 - 1
          PATCH_IF ((fl BAND 0x10) = 0x10) BEGIN READ_SLONG (t + 0x08) jr END
          SPRINT ac ~~
          PATCH_IF ((fl BAND 4) = 4) BEGIN
            READ_LONG (t + 0x10) ai
            READ_LONG (ao + ai * 8) o
            READ_LONG (ao + ai * 8 + 4) l
            READ_ASCII o ac (l)
          END
          SET hit = 0
          FOR (k = 0; k < nb; ++k) BEGIN
            SET old = $ds_jb_o(~%k%~)
            PATCH_IF (jr = old) BEGIN SET hit = 1 END
            PATCH_IF (INDEX (CASE_SENSITIVE EXACT_MATCH ~JournalEntry(%old%,~ ~%ac%~) >= 0) BEGIN SET hit = 1 END
            PATCH_IF (INDEX (CASE_SENSITIVE EXACT_MATCH ~JournalEntry(%old%)~ ~%ac%~) >= 0) BEGIN SET hit = 1 END
          END
          PATCH_IF hit BEGIN
            SET $ds_jb_i(~%n%~) = i
            SET $ds_jb_j(~%n%~) = j
            SET n = n + 1
          END
        END
      END
    BUT_ONLY
    OUTER_SPRINT d1 ~~
    OUTER_SPRINT d2 ~~
    OUTER_SET fait = 0
    OUTER_FOR (h = 0; h < n; ++h) BEGIN
      OUTER_SET s = $ds_jb_i(~%h%~)
      OUTER_SET j = $ds_jb_j(~%h%~)
      LAF ds_e2_lit_trans INT_VAR etat = s trans = j STR_VAR dlg ajout = ~GlobalGT("DS_P1_DROW","GLOBAL",0)~ RET corps tr ver_dlg ver_etat END
      ACTION_IF (INDEX (CASE_SENSITIVE EXACT_MATCH ~DS_P1_DROW~ ~%tr%~) < 0) BEGIN
        OUTER_FOR (k = 0; k < nb; ++k) BEGIN
          OUTER_SET old = $ds_jb_o(~%k%~)
          OUTER_SET new = $ds_jb_n(~%k%~)
          OUTER_PATCH_SAVE corps ~%corps%~ BEGIN
            REPLACE_TEXTUALLY CASE_SENSITIVE ~JOURNAL #%old%\b~ ~JOURNAL #%new%~
            REPLACE_TEXTUALLY CASE_SENSITIVE EXACT_MATCH ~AddJournalEntry(%old%,~ ~AddJournalEntry(%new%,~
            REPLACE_TEXTUALLY CASE_SENSITIVE EXACT_MATCH ~EraseJournalEntry(%old%)~ ~EraseJournalEntry(%old%) EraseJournalEntry(%new%)~
          END
        END
        ACTION_IF (~%ver_dlg%~ STRING_EQUAL ~~) BEGIN
          OUTER_SPRINT fin ~EXIT~
        END ELSE BEGIN
          OUTER_SPRINT fin ~EXTERN #T#%ver_dlg%#T# %ver_etat%~
        END
        OUTER_SPRINT d1 ~%d1% ADD_TRANS_TRIGGER #T#%dlg%#T# %s% #T#!GlobalGT("DS_P1_DROW","GLOBAL",0)#T# DO %j%~
        OUTER_SPRINT d2 ~%d2% EXTEND_TOP #T#%dlg%#T# %s% #%j% %corps% %fin% END~
        OUTER_SET fait = fait + 1
      END
    END
    ACTION_IF NOT (~%d1%~ STRING_EQUAL ~~) BEGIN
      LAF ds_e2_compile STR_VAR fichier = ~drowsaga/contenu/e2/tmp_jbg1.d~ texte = EVAL ~%d1%~ END
      LAF ds_e2_compile STR_VAR fichier = ~drowsaga/contenu/e2/tmp_jbg2.d~ texte = EVAL ~%d2%~ END
    END
    PRINT ~Drow Saga E5 : journal de l'Ombre-Terre, %dlg% : %fait% transition(s) doublée(s) pour le drow~
  END
END
  OUTER_SET ds_j97315 = RESOLVE_STR_REF(@698)
  OUTER_SET ds_j15797 = RESOLVE_STR_REF(@699)
  OUTER_SET ds_j97319 = RESOLVE_STR_REF(@700)
  OUTER_SET ds_j61412 = RESOLVE_STR_REF(@701)
  OUTER_SET ds_j57856 = RESOLVE_STR_REF(@702)
  OUTER_SET ds_j57566 = RESOLVE_STR_REF(@703)
  OUTER_SET ds_j57567 = RESOLVE_STR_REF(@704)
  OUTER_SET ds_j57568 = RESOLVE_STR_REF(@705)
  OUTER_SET ds_j57569 = RESOLVE_STR_REF(@706)
  OUTER_SET ds_j57570 = RESOLVE_STR_REF(@707)
  OUTER_SET ds_j11722 = RESOLVE_STR_REF(@708)
  OUTER_SET ds_j7148 = RESOLVE_STR_REF(@709)
  OUTER_SPRINT ds_jpaires ~97315:%ds_j97315% 15797:%ds_j15797% 97319:%ds_j97319% 61412:%ds_j61412% 57856:%ds_j57856% 57566:%ds_j57566% 57567:%ds_j57567% 57568:%ds_j57568% 57569:%ds_j57569% 57570:%ds_j57570% 11722:%ds_j11722% 7148:%ds_j7148%~
  ACTION_FOR_EACH ds_jd IN UDDUER01 UDSILVER UDDOOR01 UDSVIR04 UDSVIR05 UDDEMON UDPHAE01 UDPHAE02 UDSOLA02 UDVITH C6ELHAN C6ELHAN1 SOBELHAN GHELDE UDARDUL BEGIN
    LAF ds_jour_bg2 STR_VAR dlg = EVAL ~%ds_jd%~ paires = EVAL ~%ds_jpaires%~ END
  END
  ACTION_IF FILE_EXISTS_IN_GAME ~bgee.lua~ BEGIN
    COPY_EXISTING ~bgee.lua~ ~override~
      REPLACE_TEXTUALLY CASE_SENSITIVE ~\({[ 	]*\)97315\(,[ 	]*[0-9]+,[ 	]*[0-9]+,[ 	]*[0-9]+,[ 	]*'[^']*',[ 	]*-?[0-9]+}\)~ ~\197315\2,%WNL%    \1%ds_j97315%\2~
      REPLACE_TEXTUALLY CASE_SENSITIVE ~\(createEntry[ 	]*([ 	]*[0-9]+,[ 	]*-?[0-9]+,[ 	]*\)97315\(,[ 	]*{},[ 	]*nil[ 	]*)\)~ ~\197315\2%WNL%    \1%ds_j97315%\2~
      REPLACE_TEXTUALLY CASE_SENSITIVE ~\({[ 	]*\)15797\(,[ 	]*[0-9]+,[ 	]*[0-9]+,[ 	]*[0-9]+,[ 	]*'[^']*',[ 	]*-?[0-9]+}\)~ ~\115797\2,%WNL%    \1%ds_j15797%\2~
      REPLACE_TEXTUALLY CASE_SENSITIVE ~\(createEntry[ 	]*([ 	]*[0-9]+,[ 	]*-?[0-9]+,[ 	]*\)15797\(,[ 	]*{},[ 	]*nil[ 	]*)\)~ ~\115797\2%WNL%    \1%ds_j15797%\2~
      REPLACE_TEXTUALLY CASE_SENSITIVE ~\({[ 	]*\)97319\(,[ 	]*[0-9]+,[ 	]*[0-9]+,[ 	]*[0-9]+,[ 	]*'[^']*',[ 	]*-?[0-9]+}\)~ ~\197319\2,%WNL%    \1%ds_j97319%\2~
      REPLACE_TEXTUALLY CASE_SENSITIVE ~\(createEntry[ 	]*([ 	]*[0-9]+,[ 	]*-?[0-9]+,[ 	]*\)97319\(,[ 	]*{},[ 	]*nil[ 	]*)\)~ ~\197319\2%WNL%    \1%ds_j97319%\2~
      REPLACE_TEXTUALLY CASE_SENSITIVE ~\({[ 	]*\)61412\(,[ 	]*[0-9]+,[ 	]*[0-9]+,[ 	]*[0-9]+,[ 	]*'[^']*',[ 	]*-?[0-9]+}\)~ ~\161412\2,%WNL%    \1%ds_j61412%\2~
      REPLACE_TEXTUALLY CASE_SENSITIVE ~\(createEntry[ 	]*([ 	]*[0-9]+,[ 	]*-?[0-9]+,[ 	]*\)61412\(,[ 	]*{},[ 	]*nil[ 	]*)\)~ ~\161412\2%WNL%    \1%ds_j61412%\2~
      REPLACE_TEXTUALLY CASE_SENSITIVE ~\({[ 	]*\)57856\(,[ 	]*[0-9]+,[ 	]*[0-9]+,[ 	]*[0-9]+,[ 	]*'[^']*',[ 	]*-?[0-9]+}\)~ ~\157856\2,%WNL%    \1%ds_j57856%\2~
      REPLACE_TEXTUALLY CASE_SENSITIVE ~\(createEntry[ 	]*([ 	]*[0-9]+,[ 	]*-?[0-9]+,[ 	]*\)57856\(,[ 	]*{},[ 	]*nil[ 	]*)\)~ ~\157856\2%WNL%    \1%ds_j57856%\2~
      REPLACE_TEXTUALLY CASE_SENSITIVE ~\({[ 	]*\)57566\(,[ 	]*[0-9]+,[ 	]*[0-9]+,[ 	]*[0-9]+,[ 	]*'[^']*',[ 	]*-?[0-9]+}\)~ ~\157566\2,%WNL%    \1%ds_j57566%\2~
      REPLACE_TEXTUALLY CASE_SENSITIVE ~\(createEntry[ 	]*([ 	]*[0-9]+,[ 	]*-?[0-9]+,[ 	]*\)57566\(,[ 	]*{},[ 	]*nil[ 	]*)\)~ ~\157566\2%WNL%    \1%ds_j57566%\2~
      REPLACE_TEXTUALLY CASE_SENSITIVE ~\({[ 	]*\)57567\(,[ 	]*[0-9]+,[ 	]*[0-9]+,[ 	]*[0-9]+,[ 	]*'[^']*',[ 	]*-?[0-9]+}\)~ ~\157567\2,%WNL%    \1%ds_j57567%\2~
      REPLACE_TEXTUALLY CASE_SENSITIVE ~\(createEntry[ 	]*([ 	]*[0-9]+,[ 	]*-?[0-9]+,[ 	]*\)57567\(,[ 	]*{},[ 	]*nil[ 	]*)\)~ ~\157567\2%WNL%    \1%ds_j57567%\2~
      REPLACE_TEXTUALLY CASE_SENSITIVE ~\({[ 	]*\)57568\(,[ 	]*[0-9]+,[ 	]*[0-9]+,[ 	]*[0-9]+,[ 	]*'[^']*',[ 	]*-?[0-9]+}\)~ ~\157568\2,%WNL%    \1%ds_j57568%\2~
      REPLACE_TEXTUALLY CASE_SENSITIVE ~\(createEntry[ 	]*([ 	]*[0-9]+,[ 	]*-?[0-9]+,[ 	]*\)57568\(,[ 	]*{},[ 	]*nil[ 	]*)\)~ ~\157568\2%WNL%    \1%ds_j57568%\2~
      REPLACE_TEXTUALLY CASE_SENSITIVE ~\({[ 	]*\)57569\(,[ 	]*[0-9]+,[ 	]*[0-9]+,[ 	]*[0-9]+,[ 	]*'[^']*',[ 	]*-?[0-9]+}\)~ ~\157569\2,%WNL%    \1%ds_j57569%\2~
      REPLACE_TEXTUALLY CASE_SENSITIVE ~\(createEntry[ 	]*([ 	]*[0-9]+,[ 	]*-?[0-9]+,[ 	]*\)57569\(,[ 	]*{},[ 	]*nil[ 	]*)\)~ ~\157569\2%WNL%    \1%ds_j57569%\2~
      REPLACE_TEXTUALLY CASE_SENSITIVE ~\({[ 	]*\)57570\(,[ 	]*[0-9]+,[ 	]*[0-9]+,[ 	]*[0-9]+,[ 	]*'[^']*',[ 	]*-?[0-9]+}\)~ ~\157570\2,%WNL%    \1%ds_j57570%\2~
      REPLACE_TEXTUALLY CASE_SENSITIVE ~\(createEntry[ 	]*([ 	]*[0-9]+,[ 	]*-?[0-9]+,[ 	]*\)57570\(,[ 	]*{},[ 	]*nil[ 	]*)\)~ ~\157570\2%WNL%    \1%ds_j57570%\2~
      REPLACE_TEXTUALLY CASE_SENSITIVE ~\({[ 	]*\)11722\(,[ 	]*[0-9]+,[ 	]*[0-9]+,[ 	]*[0-9]+,[ 	]*'[^']*',[ 	]*-?[0-9]+}\)~ ~\111722\2,%WNL%    \1%ds_j11722%\2~
      REPLACE_TEXTUALLY CASE_SENSITIVE ~\(createEntry[ 	]*([ 	]*[0-9]+,[ 	]*-?[0-9]+,[ 	]*\)11722\(,[ 	]*{},[ 	]*nil[ 	]*)\)~ ~\111722\2%WNL%    \1%ds_j11722%\2~
      REPLACE_TEXTUALLY CASE_SENSITIVE ~\({[ 	]*\)7148\(,[ 	]*[0-9]+,[ 	]*[0-9]+,[ 	]*[0-9]+,[ 	]*'[^']*',[ 	]*-?[0-9]+}\)~ ~\17148\2,%WNL%    \1%ds_j7148%\2~
      REPLACE_TEXTUALLY CASE_SENSITIVE ~\(createEntry[ 	]*([ 	]*[0-9]+,[ 	]*-?[0-9]+,[ 	]*\)7148\(,[ 	]*{},[ 	]*nil[ 	]*)\)~ ~\17148\2%WNL%    \1%ds_j7148%\2~
    BUT_ONLY
  END
