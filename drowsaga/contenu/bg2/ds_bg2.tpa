  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@154) requis = 1 STR_VAR cle = ~E2_BELR14~ dlg = ~BELMIN~ aiguille = ~Ni moi ni mes frères~ END
  OUTER_SPRINT ds_e2b_cibles ~~
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@100) requis = 1 STR_VAR cle = ~E2_BYST3~ dlg = ~BYSTAND2~ aiguille = ~Ah, j'ai pensé que vous étiez des étrangers~ cibles = EVAL ~%ds_e2b_cibles%~ RET ds_e2b_cibles = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@102) requis = 1 STR_VAR cle = ~E2_BEL15~ dlg = ~BELMIN~ aiguille = ~Je suis Belmin Gergas, elfe~ cibles = EVAL ~%ds_e2b_cibles%~ RET ds_e2b_cibles = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@103) requis = 1 STR_VAR cle = ~E2_BEL16~ dlg = ~BELMIN~ aiguille = ~Je n'ai pas peur de vous, elfe~ cibles = EVAL ~%ds_e2b_cibles%~ RET ds_e2b_cibles = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@104) requis = 1 STR_VAR cle = ~E2_BEL17~ dlg = ~BELMIN~ aiguille = ~Maudite peste aux oreilles pointues~ cibles = EVAL ~%ds_e2b_cibles%~ RET ds_e2b_cibles = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@105) requis = 1 STR_VAR cle = ~E2_BEL18~ dlg = ~BELMIN~ aiguille = ~Créature pervertie pour semer le mal~ cibles = EVAL ~%ds_e2b_cibles%~ RET ds_e2b_cibles = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@107) requis = 1 STR_VAR cle = ~E2_BEL19~ dlg = ~BELMIN~ aiguille = ~MOUREZ, ELFE~ cibles = EVAL ~%ds_e2b_cibles%~ RET ds_e2b_cibles = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@108) requis = 1 STR_VAR cle = ~E2_BEL5~ dlg = ~BELMIN~ aiguille = ~VOYEZ LE VRAI VISAGE DU MAL~ cibles = EVAL ~%ds_e2b_cibles%~ RET ds_e2b_cibles = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@110) requis = 1 STR_VAR cle = ~E2_AER4~ dlg = ~AERIE~ aiguille = ~Vous me laisseriez me joindre à vous~ cibles = EVAL ~%ds_e2b_cibles%~ RET ds_e2b_cibles = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@111) requis = 1 STR_VAR cle = ~E2_AER10~ dlg = ~AERIE~ aiguille = ~Vous me laisseriez vraiment venir avec vous~ cibles = EVAL ~%ds_e2b_cibles%~ RET ds_e2b_cibles = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@135) requis = 1 STR_VAR cle = ~E2_VG9~ dlg = ~VICG1~ aiguille = ~Celui d'être noire et diabolique~ cibles = EVAL ~%ds_e2b_cibles%~ RET ds_e2b_cibles = cibles END
