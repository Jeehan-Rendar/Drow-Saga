  LAF ds_e2_cherche STR_VAR dlg = ~SARVOLO~ aiguille = ~De quel compagnon avez-vous envie~ RET n9 = n RET_ARRAY ds_e2_et END
  OUTER_SET ds_ep9 = $ds_e2_et(~0~)
  LAF ds_e2_cherche STR_VAR dlg = ~SARVOLO~ aiguille = ~qui n'est partagée que par un seul autre drow~ RET n35 = n RET_ARRAY ds_e2_et END
  OUTER_SET ds_ep35 = $ds_e2_et(~0~)
  LAF ds_e2_cherche STR_VAR dlg = ~SARVOLO~ aiguille = ~qui n'a d'égale que celle d'un autre drow~ RET n36 = n RET_ARRAY ds_e2_et END
  OUTER_SET ds_ep36 = $ds_e2_et(~0~)
  ACTION_IF (n9 > 0) AND (n35 > 0) AND (n36 > 0) BEGIN
    OUTER_SET ds_epa = RESOLVE_STR_REF(@887)
    OUTER_SET ds_epb = RESOLVE_STR_REF(@888)
    OUTER_SET ds_epc = RESOLVE_STR_REF(@889)
    OUTER_SET ds_epd = RESOLVE_STR_REF(@890)
    LAF ds_e2_compile STR_VAR fichier = ~drowsaga/contenu/e2/tmp_ep.d~ texte = EVAL ~APPEND #T#SARVOLO#T# IF #T##T# THEN BEGIN #T#DS_EP_V35#T# SAY #%ds_epa% IF #T#!IsValidForPartyDialog("Viconia")#T# THEN GOTO %ds_ep9% IF #T#IsValidForPartyDialog("Viconia")#T# THEN EXTERN #T#VICON25J#T# #T#DS_EP_C35#T# END IF #T##T# THEN BEGIN #T#DS_EP_V36#T# SAY #%ds_epb% IF #T#!IsValidForPartyDialog("Viconia")#T# THEN GOTO %ds_ep9% IF #T#IsValidForPartyDialog("Viconia")#T# THEN EXTERN #T#VICON25J#T# #T#DS_EP_C36#T# END END APPEND #T#VICON25J#T# IF #T##T# THEN BEGIN #T#DS_EP_C35#T# SAY #%ds_epc% IF #T##T# THEN EXTERN #T#SARVOLO#T# %ds_ep9% END IF #T##T# THEN BEGIN #T#DS_EP_C36#T# SAY #%ds_epd% IF #T##T# THEN EXTERN #T#SARVOLO#T# %ds_ep9% END END~ END
    LAF ds_e2_nb STR_VAR dlg = ~SARVOLO~ RET ns END
    OUTER_SET ds_epn36 = ns - 1
    OUTER_SET ds_epn35 = ns - 2
    LAF ds_e2_cible INT_VAR etat = ds_ep35 netat = ds_epn35 STR_VAR dlg = ~SARVOLO~ ndlg = ~SARVOLO~ cibles = EVAL ~%ds_e2b_cibles%~ RET ds_e2b_cibles = cibles END
    LAF ds_e2_cible INT_VAR etat = ds_ep36 netat = ds_epn36 STR_VAR dlg = ~SARVOLO~ ndlg = ~SARVOLO~ cibles = EVAL ~%ds_e2b_cibles%~ RET ds_e2b_cibles = cibles END
    PRINT ~Drow Saga, épilogues : Volo et Viconia (SARVOLO %ds_ep35% -> %ds_epn35%, %ds_ep36% -> %ds_epn36%)~
  END ELSE BEGIN
    WARN ~Drow Saga, épilogues : SARVOLO, Viconia introuvable~
  END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@891) requis = 1 STR_VAR cle = ~E2_EPV5~ dlg = ~SARVOLO~ aiguille = ~Après avoir grandi dans l'isolement feutré de Château-Suif~ cibles = EVAL ~%ds_e2b_cibles%~ RET ds_e2b_cibles = cibles END
