  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@855) requis = 1 STR_VAR cle = ~E2_E8MEL25~ dlg = ~SARMEL01~ aiguille = ~Naturellement, la plupart des gens ici risquent de ne pas apprécier~ cibles = EVAL ~%ds_e2b_cibles%~ RET ds_e2b_cibles = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@856) requis = 1 STR_VAR cle = ~E2_E8GR1~ dlg = ~GROMNIR~ aiguille = ~Mélissanne a fait venir quelqu'un de l'extérieur pour tuer Gromnir~ cibles = EVAL ~%ds_e2b_cibles%~ RET ds_e2b_cibles = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@859) requis = 1 STR_VAR cle = ~E2_E8AZ1~ dlg = ~ABAZIGAL~ aiguille = ~Seul un dragon est digne d'abriter l'essence immortelle~ cibles = EVAL ~%ds_e2b_cibles%~ RET ds_e2b_cibles = cibles END
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@842) requis = 1 STR_VAR cle = ~E2_E8BE12~ dlg = ~SENBEH01~ aiguille = ~Tuer des drows, a priori.~ END
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@860) requis = 1 STR_VAR cle = ~E2_E8D2~ dlg = ~OHDPLANL~ aiguille = ~C'était le frère de mon père. J'ai été nommé d'après lui.~ END
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@850) requis = 1 garde = 1 tete = 1 STR_VAR cle = ~E2_E8SO24~ dlg = ~SOLAR~ aiguille = ~Je ne sais rien de ma vie avant Gorion.~ END
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@852) requis = 1 garde = 1 tete = 1 STR_VAR cle = ~E2_E8SO26~ dlg = ~SOLAR~ aiguille = ~Je comprends pourquoi Gorion ne m'en a jamais parlé~ END
  LAF ds_e2_cherche STR_VAR dlg = ~SENGUA01~ aiguille = ~si vous voulez aller vérifier mon histoire~ RET n RET_ARRAY ds_e2_et END
  ACTION_IF (n > 0) BEGIN
    OUTER_SET ds_e8s = $ds_e2_et(~0~)
    OUTER_SET ds_e8r1 = RESOLVE_STR_REF(@832)
    LAF ds_e2_compile STR_VAR fichier = ~drowsaga/contenu/e2/tmp_e8b.d~ texte = EVAL ~APPEND #T#SENGUA01#T# IF #T##T# THEN BEGIN #T#DS_E8_BU5#T# SAY #%ds_e8r1% IF #T##T# THEN EXTERN #T#SENGUA01#T# %ds_e8s% END END~ END
    LAF ds_e2_nb STR_VAR dlg = ~SENGUA01~ RET ns END
    OUTER_SET ds_e8n = ns - 1
    LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@831) requis = 1 vers = ds_e8n garde = 1 tete = 1 STR_VAR cle = ~E2_E8BU5R~ dlg = ~SENGUA01~ aiguille = ~Merci. Je vais effectivement aller vérifier cette histoire.~ END
    LAF ds_e2_compile STR_VAR fichier = ~drowsaga/contenu/e2/tmp_e8b.d~ texte = EVAL ~ADD_TRANS_TRIGGER #T#SENGUA01#T# %ds_e8s% #T#!Global("DS_E8_BU5","LOCALS",1)#T# DO 0~ END
    LAF ds_e2_compile STR_VAR fichier = ~drowsaga/contenu/e2/tmp_e8b.d~ texte = EVAL ~ADD_TRANS_ACTION #T#SENGUA01#T# BEGIN %ds_e8s% END BEGIN 0 END #T#SetGlobal("DS_E8_BU5","LOCALS",1)#T#~ END
    PRINT ~Drow Saga E8 : bûcheron, réponse ajoutée (SENGUA01 %ds_e8s% -> %ds_e8n%)~
  END ELSE BEGIN
    WARN ~Drow Saga E8 : SENGUA01, réplique 5 introuvable~
  END
  LAF ds_e2_cherche STR_VAR dlg = ~BSAREV25~ aiguille = ~un guerrier lié par un serment... et que je n'aurais pas à craindre~ RET n RET_ARRAY ds_e2_et END
  ACTION_IF (n > 0) BEGIN
    OUTER_SET ds_e8s = $ds_e2_et(~0~)
    OUTER_SET ds_e8r1 = RESOLVE_STR_REF(@858)
    LAF ds_e2_cherche STR_VAR dlg = ~BSAREV25~ aiguille = ~Vous ne gardez donc aucune rancune~ RET n85 = n RET_ARRAY ds_e2_et END
    OUTER_SET ds_e85 = $ds_e2_et(~0~)
    OUTER_SPRINT ds_e8t ~~
    COPY_EXISTING ~bsarev25.dlg~ ~override~
      READ_LONG 0x0c so
      READ_LONG 0x14 to
      READ_LONG (so + ds_e85 * 0x10 + 4) ft
      READ_LONG (so + ds_e85 * 0x10 + 8) nt
      FOR (i = ft; i < ft + nt; i += 1) BEGIN
        READ_LONG (to + i * 0x20) fl
        READ_LONG (to + i * 0x20 + 0x1c) nx
        READ_ASCII (to + i * 0x20 + 0x14) nd (8) NULL
        PATCH_IF ((fl BAND 1) = 1) AND (nx = ds_e8s) AND ("%nd%" STRING_EQUAL_CASE "BSAREV25") BEGIN
          READ_LONG (to + i * 0x20 + 4) rr
          SPRINT ds_e8t ~%ds_e8t% IF #T##T# THEN REPLY #%rr% EXTERN #T#BSAREV25#T# %ds_e8s%~
        END
      END
    BUT_ONLY
    ACTION_IF ("%ds_e8t%" STRING_EQUAL ~~) BEGIN
      OUTER_SPRINT ds_e8t ~IF #T##T# THEN EXTERN #T#BSAREV25#T# %ds_e8s%~
      WARN ~Drow Saga E8 : BSAREV25 85, réponses vers 91 introuvables (Sarevok enchaîne directement)~
    END
    LAF ds_e2_compile STR_VAR fichier = ~drowsaga/contenu/e2/tmp_e8s.d~ texte = EVAL ~APPEND #T#BSAREV25#T# IF #T##T# THEN BEGIN #T#DS_E8_SA85#T# SAY #%ds_e8r1% END END~ END
    LAF ds_e2_nb STR_VAR dlg = ~BSAREV25~ RET ns END
    OUTER_SET ds_e8n = ns - 1
    LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@857) requis = 1 vers = ds_e8n garde = 1 tete = 1 STR_VAR cle = ~E2_E8SA85R~ dlg = ~BSAREV25~ aiguille = ~Je garde rancune, mais j'ai besoin de vous.~ END
    LAF ds_e2_compile STR_VAR fichier = ~drowsaga/contenu/e2/tmp_e8s.d~ texte = EVAL ~EXTEND_BOTTOM #T#BSAREV25#T# %ds_e8n% %ds_e8t% END~ END
    PRINT ~Drow Saga E8 : Sarevok, réponse ajoutée (BSAREV25 85 -> %ds_e8n% -> %ds_e8s%)~
  END ELSE BEGIN
    WARN ~Drow Saga E8 : BSAREV25, réplique 91 introuvable~
  END
  ACTION_IF (FILE_EXISTS_IN_GAME ~d1mothel.cre~) AND (FILE_EXISTS_IN_GAME ~cut217b3.bcs~) BEGIN
    COPY_EXISTING ~d1mothel.cre~ ~override/dsmothdr.cre~
      WRITE_BYTE 0x2f 83
      WRITE_BYTE 0x32 79
    COPY_EXISTING ~cut217b3.bcs~ ~override/dscut217.bcs~
      DECOMPILE_AND_PATCH BEGIN
        REPLACE_TEXTUALLY CASE_INSENSITIVE ~"D1MOTHEL"~ ~"DSMOTHDR"~
      END
    LAF ds_e2_cherche STR_VAR dlg = ~SOLAR~ aiguille = ~Votre passé se dévoile~ RET n RET_ARRAY ds_e2_et END
    ACTION_IF (n > 0) BEGIN
      OUTER_SET ds_e8s = $ds_e2_et(~0~)
      LAF ds_e2_compile STR_VAR fichier = ~drowsaga/contenu/e2/tmp_e8a.d~ texte = EVAL ~EXTEND_BOTTOM #T#SOLAR#T# %ds_e8s% IF #T#Race(Player1,ELF) GlobalGT("DS_P1_DROW","GLOBAL",0)#T# THEN DO #T#ClearAllActions() StartCutSceneMode() StartCutSceneEx("dscut217",FALSE)#T# EXIT END~ END
      PRINT ~Drow Saga E8 : Alianna drow (SOLAR %ds_e8s%, DSCUT217, DSMOTHDR)~
    END ELSE BEGIN
      WARN ~Drow Saga E8 : SOLAR, réplique 25 introuvable~
    END
  END ELSE BEGIN
    WARN ~Drow Saga E8 : D1MOTHEL.CRE ou CUT217B3.BCS absent, Alianna drow non faite~
  END
  ACTION_IF (FILE_EXISTS_IN_GAME ~VICONND2.2da~) AND (FILE_EXISTS_IN_GAME ~ar6200.bcs~) BEGIN
    OUTER_SET ds_ep_cur = 0 - 1
    COPY_EXISTING - ~VICONND2.2da~ ~override~
      READ_2DA_ENTRY 1 2 3 ds_ep_cur
    OUTER_SPRINT ds_ep_txt ~~
    OUTER_SPRINT ds_ep_de ~~
    ACTION_IF (ds_ep_cur >= 0) BEGIN ACTION_GET_STRREF ds_ep_cur ds_ep_txt END
    OUTER_SET ds_ep = 0
    ACTION_IF (ds_ep_cur = 73922) BEGIN OUTER_SET ds_ep = RESOLVE_STR_REF(@861) OUTER_SPRINT ds_ep_de ~du jeu~ END
    ACTION_IF (ds_ep = 0) AND (INDEX (CASE_SENSITIVE EXACT_MATCH ~poursuivirent leur vie aventureuse de nombreuses années après les événements du Téthyr~ ~%ds_ep_txt%~) >= 0) BEGIN OUTER_SET ds_ep = RESOLVE_STR_REF(@871) OUTER_SPRINT ds_ep_de ~d'Ascension (60)~ END
    ACTION_IF (ds_ep = 0) AND (INDEX (CASE_SENSITIVE EXACT_MATCH ~quittèrent ensemble le Téthyr~ ~%ds_ep_txt%~) >= 0) BEGIN OUTER_SET ds_ep = RESOLVE_STR_REF(@875) OUTER_SPRINT ds_ep_de ~d'Ascension (61)~ END
    ACTION_IF (ds_ep < 0) BEGIN
      PRINT ~Drow Saga, épilogues : VICONND2, texte %ds_ep_de%, rien à adapter pour le drow~
    END
    ACTION_IF (ds_ep = 0) BEGIN
      WARN ~Drow Saga, épilogues : VICONND2, texte inconnu (changé par un autre mod) : laissé tel quel pour le drow~
    END
    ACTION_IF (ds_ep > 0) BEGIN
    COPY_EXISTING ~VICONND2.2da~ ~override/DSVICND2.2da~
      REPLACE_TEXTUALLY ~\b%ds_ep_cur%\b~ ~%ds_ep%~
    COPY_EXISTING ~ar6200.bcs~ ~override~
      DECOMPILE_AND_PATCH BEGIN
        SET ds_ts = INDEX_BUFFER (CASE_INSENSITIVE EXACT_MATCH ~TextScreen("VICONND2")~)
        PATCH_IF (ds_ts > 0) BEGIN
          SET ds_deb = RINDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~IF~ ds_ts)
          SET ds_fin = INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~END~ (ds_ts + STRING_LENGTH ~TextScreen("VICONND2")~))
          PATCH_IF (ds_deb >= 0) AND (ds_fin > ds_ts) BEGIN
            SET ds_fin = ds_fin + 3
            READ_ASCII ds_deb ds_bloc (ds_fin - ds_deb)
            INNER_PATCH_SAVE ds_bdrow ~%ds_bloc%~ BEGIN
              REPLACE_TEXTUALLY CASE_SENSITIVE EXACT_MATCH ~Global("StartEndBios","AR6200",1)~ ~Global("StartEndBios","AR6200",1)
  OR(2) CheckStatGT(Player1,0,134) TriggerOverride(Player1,Global("DS_DROW","LOCALS",1))~
              REPLACE_TEXTUALLY CASE_INSENSITIVE EXACT_MATCH ~TextScreen("VICONND2")~ ~TextScreen("DSVICND2")~
            END
            INNER_PATCH_SAVE ds_borig ~%ds_bloc%~ BEGIN
              REPLACE_TEXTUALLY CASE_SENSITIVE EXACT_MATCH ~Global("StartEndBios","AR6200",1)~ ~Global("StartEndBios","AR6200",1)
  !CheckStatGT(Player1,0,134) !TriggerOverride(Player1,Global("DS_DROW","LOCALS",1))~
            END
            DELETE_BYTES ds_deb (ds_fin - ds_deb)
            SPRINT ds_neuf ~%ds_bdrow%%WNL%%WNL%%ds_borig%~
            INSERT_BYTES ds_deb (STRING_LENGTH ~%ds_neuf%~)
            WRITE_ASCIIE ds_deb ~%ds_neuf%~
          END ELSE BEGIN
            PATCH_WARN ~Drow Saga, épilogues : bloc de VICONND2 introuvable dans AR6200~
          END
        END ELSE BEGIN
          PATCH_WARN ~Drow Saga, épilogues : VICONND2 absent d'AR6200~
        END
