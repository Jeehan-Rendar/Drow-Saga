  LAF ds_e2_dit_fin INT_VAR ref = RESOLVE_STR_REF(@248) STR_VAR cle = ~E2_L5ED0~ dlg = ~EDWIN~ aiguille = ~peuvent m'appeler simplement~ END
  LAF ds_e2_dit_fin INT_VAR ref = RESOLVE_STR_REF(@274) STR_VAR cle = ~E2_L5JA0~ dlg = ~JAN~ aiguille = ~Mes modestes marchandises pourraient-elles~ END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@287) requis = 1 STR_VAR cle = ~E2_L5KA1~ dlg = ~SCDUR~ aiguille = ~Ce n'est pas illégal d'être nain~ cibles = EVAL ~%ds_e2b_cibles%~ RET ds_e2b_cibles = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@294) requis = 1 STR_VAR cle = ~E2_L5RE0~ dlg = ~RENAL~ aiguille = ~quelqu'un de plus... volumineux~ cibles = EVAL ~%ds_e2b_cibles%~ RET ds_e2b_cibles = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@295) requis = 1 STR_VAR cle = ~E2_L5RE1~ dlg = ~RENAL~ aiguille = ~je m'attendais à plus... grand~ cibles = EVAL ~%ds_e2b_cibles%~ RET ds_e2b_cibles = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@296) requis = 1 STR_VAR cle = ~E2_L5TA3~ dlg = ~TASSA~ aiguille = ~Dites donc, mais vous êtes adorable~ cibles = EVAL ~%ds_e2b_cibles%~ RET ds_e2b_cibles = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@297) requis = 1 STR_VAR cle = ~E2_L5TA4~ dlg = ~TASSA~ aiguille = ~J'imaginais votre physique plus généreux~ cibles = EVAL ~%ds_e2b_cibles%~ RET ds_e2b_cibles = cibles END
  OUTER_SET ds_bel18 = 0 - 1
  LAF ds_e2_cherche STR_VAR dlg = ~BELMIN~ aiguille = ~Créature pervertie pour semer le mal~ RET n RET_ARRAY ds_e2_et END
  ACTION_IF (n > 0) BEGIN
    OUTER_SET ds_b18o = $ds_e2_et(~0~)
    OUTER_PATCH ~%ds_e2b_cibles%~ BEGIN
      REPLACE_EVALUATE ~BELMIN\.\([0-9]+\)=BELMIN\.\([0-9]+\)~ BEGIN
        PATCH_IF (MATCH1 = ds_b18o) BEGIN SET ds_bel18 = MATCH2 END
      END ~%MATCH0%~
    END
  END
  ACTION_IF (ds_bel18 >= 0) BEGIN
    OUTER_SET ds_r18v = RESOLVE_STR_REF(@106)
    LAF ds_e2_compile STR_VAR fichier = ~drowsaga/contenu/e2/tmp_bel18v.d~ texte = EVAL ~APPEND #T#BELMIN#T# IF #T##T# THEN BEGIN #T#DS_E2_BEL18V#T# SAY #%ds_r18v% COPY_TRANS #T#BELMIN#T# %ds_b18o% END END~ END
    LAF ds_e2_nb STR_VAR dlg = ~BELMIN~ RET ns END
    OUTER_SET ds_bel18v = ns - 1
  END
  OUTER_SET ds_ois35 = 0 - 1
  LAF ds_e2_cherche STR_VAR dlg = ~BHOISIG~ aiguille = ~Nous vous offrons un endroit de repos~ RET n RET_ARRAY ds_e2_et END
  ACTION_IF (n > 0) BEGIN
    OUTER_SET ds_o35o = $ds_e2_et(~0~)
    OUTER_PATCH ~%ds_e2b_cibles%~ BEGIN
      REPLACE_EVALUATE ~BHOISIG\.\([0-9]+\)=BHOISIG\.\([0-9]+\)~ BEGIN
        PATCH_IF (MATCH1 = ds_o35o) BEGIN SET ds_ois35 = MATCH2 END
      END ~%MATCH0%~
    END
  END
  ACTION_IF (ds_ois35 >= 0) BEGIN
    OUTER_SET ds_r35v = RESOLVE_STR_REF(@418)
    LAF ds_e2_compile STR_VAR fichier = ~drowsaga/contenu/e2/tmp_ois35v.d~ texte = EVAL ~APPEND #T#BHOISIG#T# IF #T##T# THEN BEGIN #T#DS_E2_OIS35V#T# SAY #%ds_r35v% COPY_TRANS #T#BHOISIG#T# %ds_o35o% END END~ END
    LAF ds_e2_nb STR_VAR dlg = ~BHOISIG~ RET ns END
    OUTER_SET ds_ois35v = ns - 1
  END
  LAF ds_e2_redirige STR_VAR cibles = EVAL ~%ds_e2b_cibles%~ END
  ACTION_IF (ds_bel18 >= 0) BEGIN
    OUTER_SET ds_b18n = 0
    COPY_EXISTING ~BELMIN.DLG~ ~override~
      DECOMPILE_AND_PATCH BEGIN
        REPLACE_EVALUATE ~~~~~IF ~\([^~]*\)~ THEN REPLY \(#[0-9]+\)\( /\* ~[^~]*~ \*/\)? \(GOTO\|EXTERN ~BELMIN~\) \([0-9]+\)~~~~~ BEGIN
          SPRINT ds_rep ~%MATCH0%~
          PATCH_IF (MATCH5 = ds_bel18) AND (INDEX (CASE_SENSITIVE ~\(^\|[^!]\)GlobalGT("DS_P1_DROW"~ ~%MATCH1%~) >= 0) BEGIN
            SPRINT ds_rep ~~~~~IF ~%MATCH1% !InParty("Viconia")~ THEN REPLY %MATCH2% GOTO %ds_bel18% IF ~%MATCH1% InParty("Viconia")~ THEN REPLY %MATCH2% GOTO %ds_bel18v%~~~~~
            SET ds_b18n += 1
          END
        END ~%ds_rep%~
      END
    BUT_ONLY
    PRINT ~Drow Saga E2 : Belmin 18, variante avec Viconia (copie %ds_bel18v%, %ds_b18n% réponse(s) partagée(s))~
  END
  ACTION_IF (ds_ois35 >= 0) BEGIN
    OUTER_SET ds_o35n = 0
    COPY_EXISTING ~BHOISIG.DLG~ ~override~
      DECOMPILE_AND_PATCH BEGIN
        REPLACE_EVALUATE ~~~~~IF ~\([^~]*\)~ THEN REPLY \(#[0-9]+\)\( /\* ~[^~]*~ \*/\)? \(GOTO\|EXTERN ~BHOISIG~\) \([0-9]+\)~~~~~ BEGIN
          SPRINT ds_rep ~%MATCH0%~
          PATCH_IF (MATCH5 = ds_ois35) AND (INDEX (CASE_SENSITIVE ~\(^\|[^!]\)GlobalGT("DS_P1_DROW"~ ~%MATCH1%~) >= 0) BEGIN
            SPRINT ds_rep ~~~~~IF ~%MATCH1% !InParty("Viconia")~ THEN REPLY %MATCH2% GOTO %ds_ois35% IF ~%MATCH1% InParty("Viconia")~ THEN REPLY %MATCH2% GOTO %ds_ois35v%~~~~~
            SET ds_o35n += 1
          END
        END ~%ds_rep%~
      END
    BUT_ONLY
    PRINT ~Drow Saga E2 : Oisig 35, variante avec Viconia (copie %ds_ois35v%, %ds_o35n% réponse(s) partagée(s))~
  END
END

