  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@902) requis = 1 STR_VAR cle = ~E2_DTXZ13~ dlg = ~LYROS~ aiguille = ~Je me souviens avoir travaillé avec quelqu'un de plutôt stupide~ cibles = EVAL ~%ds_e2b_cibles%~ RET ds_e2b_cibles = cibles END
