  LAF ds_e2_dit_fin INT_VAR ref = RESOLVE_STR_REF(@892) STR_VAR cle = ~E2_DTGK1~ dlg = ~GARKID01~ aiguille = ~Cela fait longtemps qu'il n'avait pas pu aider~ END
  LAF ds_e2_dit_fin INT_VAR ref = RESOLVE_STR_REF(@893) STR_VAR cle = ~E2_DTGK2~ dlg = ~GARKID02~ aiguille = ~La loyauté est très importante pour lui~ END
