  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@137) requis = 1 STR_VAR cle = ~E2_VG13~ dlg = ~VICG1~ aiguille = ~Un nouvel adepte nous rejoint~ cibles = EVAL ~%ds_e2b_cibles%~ RET ds_e2b_cibles = cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@140) requis = 1 STR_VAR cle = ~E2_VI3~ dlg = ~VICONI~ aiguille = ~La majeure partie de cette ville déborde~ cibles = EVAL ~%ds_e2b_cibles%~ RET ds_e2b_cibles = cibles END
