  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@849) requis = 1 STR_VAR cle = ~E2_E8RE0~ dlg = ~SARELF01~ aiguille = ~Je vous en prie, aidez-nous. Les gardes de Gromnir~ cibles = EVAL ~%ds_e2b_cibles%~ RET ds_e2b_cibles = cibles END
