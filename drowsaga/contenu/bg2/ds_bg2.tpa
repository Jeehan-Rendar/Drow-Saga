    COPY_EXISTING ~ar6200.bcs~ ~override~
      DECOMPILE_AND_PATCH BEGIN
        SET ds_ts = INDEX_BUFFER (CASE_INSENSITIVE EXACT_MATCH ~TextScreen("OHHHEX2")~)
        PATCH_IF (ds_ts > 0) BEGIN
          SET ds_deb = RINDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~IF~ ds_ts)
          SET ds_fin = INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~END~ (ds_ts + STRING_LENGTH ~TextScreen("OHHHEX2")~))
          PATCH_IF (ds_deb >= 0) AND (ds_fin > ds_ts) BEGIN
            SET ds_fin = ds_fin + 3
            READ_ASCII ds_deb ds_bloc (ds_fin - ds_deb)
            INNER_PATCH_SAVE ds_bdrow ~%ds_bloc%~ BEGIN
              REPLACE_TEXTUALLY CASE_SENSITIVE EXACT_MATCH ~Global("StartEndBios","AR6200",1)~ ~Global("StartEndBios","AR6200",1)
  OR(2) CheckStatGT(Player1,0,134) TriggerOverride(Player1,Global("DS_DROW","LOCALS",1))~
              REPLACE_TEXTUALLY CASE_INSENSITIVE EXACT_MATCH ~TextScreen("OHHHEX2")~ ~TextScreen("DSHEXND2")~
            END
