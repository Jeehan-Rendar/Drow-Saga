    OUTER_SET ref = RESOLVE_STR_REF(@1151)
    LAF ds_e2_compile STR_VAR fichier = ~drowsaga/contenu/e2/tmp_dit.d~ texte = EVAL ~APPEND #T#RIBALD#T# IF WEIGHT #-9 #T#%trig% NumTimesTalkedTo(0) GlobalGT("DS_P1_DROW","GLOBAL",0)#T# THEN BEGIN #T#DS_E2_AURI1_%s%#T# SAY #%ref% COPY_TRANS #T#RIBALD#T# %s% END END~ END
