
IF
    TriggerOverride(Player1,Global("DS_DROW","LOCALS",1))
    !Global("DS_P1_DROW","GLOBAL",1)
THEN
    RESPONSE #100
        SetGlobal("DS_P1_DROW","GLOBAL",1)
        Continue()
END

IF
    !TriggerOverride(Player1,Global("DS_DROW","LOCALS",1))
    Global("DS_P1_DROW","GLOBAL",1)
THEN
    RESPONSE #100
        SetGlobal("DS_P1_DROW","GLOBAL",0)
        Continue()
END

IF
    Global("ViconiaMatch","GLOBAL",0)
    Global("CheckViconiaMatch","GLOBAL",0)
    Gender(Player1,MALE)
    Global("DS_P1_DROW","GLOBAL",1)
THEN
    RESPONSE #100
        SetGlobal("CheckViconiaMatch","GLOBAL",1)
        SetGlobal("ViconiaMatch","GLOBAL",1)
        Continue()
END

