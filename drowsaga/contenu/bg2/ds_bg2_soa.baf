    Global("DS_P1_DROW","GLOBAL",1)
    InParty("Aerie")
    IsValidForPartyDialogue("Aerie")
    IsValidForPartyDialogue(Player1)
    CombatCounter(0)
    !ActuallyInCombat()
    !GlobalTimerNotExpired("DS_B_GAP","GLOBAL")
THEN
    RESPONSE #100
        SetGlobalTimer("DS_B_GAP","GLOBAL",EIGHT_HOURS)
        ActionOverride("Aerie",StartDialogOverride("DSDAERIE",Player1))
END

