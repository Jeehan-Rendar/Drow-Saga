    Global("DS_CERND_B","GLOBAL",2)
    Global("DS_P1_DROW","GLOBAL",1)
    InParty("Cernd")
    GlobalGT("Chapter","GLOBAL",1)
    GlobalLT("Chapter","GLOBAL",8)
    IsValidForPartyDialogue("Cernd")
    IsValidForPartyDialogue(Player1)
    CombatCounter(0)
    !ActuallyInCombat()
    !GlobalTimerNotExpired("DS_B_GAP","GLOBAL")
THEN
    RESPONSE #100
        SetGlobalTimer("DS_B_GAP","GLOBAL",EIGHT_HOURS)
        ActionOverride("Cernd",StartDialogOverride("DSDCERND",Player1))
END

