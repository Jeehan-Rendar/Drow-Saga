OUTER_SET ds_fb_nb = 0
ACTION_PHP_EACH ds_fb AS k => neuf BEGIN
  OUTER_SET i = k_0
  OUTER_SPRINT vieux ~%k_1%~
  ACTION_IF i < NEXT_STRREF BEGIN
    OUTER_PATCH ~~ BEGIN
      GET_STRREF i m
      GET_STRREF_F i f
    END
    ACTION_IF (INDEX (CASE_SENSITIVE EXACT_MATCH ~%vieux%~ ~%m%~) >= 0) OR (INDEX (CASE_SENSITIVE EXACT_MATCH ~%vieux%~ ~%f%~) >= 0) BEGIN
      OUTER_PATCH_SAVE m ~%m%~ BEGIN REPLACE_TEXTUALLY CASE_SENSITIVE EXACT_MATCH ~%vieux%~ ~%neuf%~ END
      OUTER_PATCH_SAVE f ~%f%~ BEGIN REPLACE_TEXTUALLY CASE_SENSITIVE EXACT_MATCH ~%vieux%~ ~%neuf%~ END
      ACTION_GET_STRREF_S i ds_s
      ACTION_GET_STRREF_FS i ds_sf
      ACTION_IF (~%ds_s%~ STRING_EQUAL ~~) AND (~%ds_sf%~ STRING_EQUAL ~~) BEGIN
        STRING_SET_EVALUATE i ~%m%~ ~%f%~
      END ELSE ACTION_IF (~%ds_sf%~ STRING_EQUAL ~~) BEGIN
        STRING_SET_EVALUATE i ~%m%~ [%ds_s%] ~%f%~
      END ELSE ACTION_IF (~%ds_s%~ STRING_EQUAL ~~) BEGIN
        STRING_SET_EVALUATE i ~%m%~ ~%f%~ [%ds_sf%]
      END ELSE BEGIN
        STRING_SET_EVALUATE i ~%m%~ [%ds_s%] ~%f%~ [%ds_sf%]
      END
      OUTER_SET ds_fb_nb = ds_fb_nb + 1
    END
  END
END
ACTION_DEFINE_ASSOCIATIVE_ARRAY ds_fbm BEGIN
  50537 , ~m'a attaquée~ => ~m'a attaqué~
END
ACTION_PHP_EACH ds_fbm AS k => neuf BEGIN
  OUTER_SET i = k_0
  OUTER_SPRINT vieux ~%k_1%~
  ACTION_IF i < NEXT_STRREF BEGIN
    OUTER_PATCH ~~ BEGIN
      GET_STRREF i m
      GET_STRREF_F i f
    END
    ACTION_IF INDEX (CASE_SENSITIVE EXACT_MATCH ~%vieux%~ ~%m%~) >= 0 BEGIN
      OUTER_PATCH_SAVE m ~%m%~ BEGIN REPLACE_TEXTUALLY CASE_SENSITIVE EXACT_MATCH ~%vieux%~ ~%neuf%~ END
      ACTION_GET_STRREF_S i ds_s
      ACTION_GET_STRREF_FS i ds_sf
      ACTION_IF (~%ds_s%~ STRING_EQUAL ~~) AND (~%ds_sf%~ STRING_EQUAL ~~) BEGIN
        STRING_SET_EVALUATE i ~%m%~ ~%f%~
      END ELSE ACTION_IF (~%ds_sf%~ STRING_EQUAL ~~) BEGIN
        STRING_SET_EVALUATE i ~%m%~ [%ds_s%] ~%f%~
      END ELSE ACTION_IF (~%ds_s%~ STRING_EQUAL ~~) BEGIN
        STRING_SET_EVALUATE i ~%m%~ ~%f%~ [%ds_sf%]
      END ELSE BEGIN
        STRING_SET_EVALUATE i ~%m%~ [%ds_s%] ~%f%~ [%ds_sf%]
      END
      OUTER_SET ds_fb_nb = ds_fb_nb + 1
    END
  END
END
PRINT ~Drow Saga : %ds_fb_nb% faute(s) du jeu de base corrigée(s)~

OUTER_SET ds_ub_avant = NEXT_STRREF
OUTER_SET ds_ub = RESOLVE_STR_REF(~Triche à l'examen d'entrée

I could help young Edie with a magical potion. It might count as cheating, but considering she joined the Merchants' League some might say that's part of the job...~)
ACTION_IF ds_ub < ds_ub_avant BEGIN
  STRING_SET_EVALUATE ds_ub ~Triche à l'examen d'entrée

Je pourrais aider la jeune Edie avec une potion magique. On pourrait parler de triche, mais puisqu'elle a rejoint la Ligue des Marchands, certains diront que ça fait partie du métier...~ ~Triche à l'examen d'entrée

Je pourrais aider la jeune Edie avec une potion magique. On pourrait parler de triche, mais puisqu'elle a rejoint la Ligue des Marchands, certains diront que ça fait partie du métier...~
  PRINT ~Drow Saga : entrée de journal d'UB traduite (Edie)~
END
