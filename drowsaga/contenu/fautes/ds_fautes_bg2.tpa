  55291 , ~Je me suis porté volontaire et Cernd s'est joint à moi, même si je devrai l'affronter sans lui.~ => ~Je me suis portée volontaire, et Cernd m'accompagne pour me soutenir, même s'il m'a prévenue que je devrai l'affronter seule.~
END
OUTER_SET ds_f2_nb = 0
DEFINE_ACTION_MACRO ds_f2_set BEGIN
  ACTION_GET_STRREF_S i ds_s
  ACTION_GET_STRREF_FS i ds_sf
  ACTION_IF (~%ds_s%~ STRING_EQUAL ~~) AND (~%ds_sf%~ STRING_EQUAL ~~) BEGIN
    STRING_SET_EVALUATE i ~%m%~ ~%f%~
  END ELSE ACTION_IF (~%ds_sf%~ STRING_EQUAL ~~) BEGIN
    STRING_SET_EVALUATE i ~%m%~ [%ds_s%] ~%f%~
  END ELSE ACTION_IF (~%ds_s%~ STRING_EQUAL ~~) BEGIN
    STRING_SET_EVALUATE i ~%m%~ ~%f%~ [%ds_sf%]
  END ELSE BEGIN
    STRING_SET_EVALUATE i ~%m%~ [%ds_s%] ~%f%~ [%ds_sf%]
  END
END
DEFINE_ACTION_MACRO ds_f2_un BEGIN
  ACTION_IF i < NEXT_STRREF BEGIN
    OUTER_PATCH ~~ BEGIN
      GET_STRREF i m
      GET_STRREF_F i f
    END
    OUTER_SET ok = 0
    ACTION_IF (ds_f2_m = 1) AND (INDEX (CASE_SENSITIVE EXACT_MATCH ~%vieux%~ ~%m%~) >= 0) BEGIN
      OUTER_PATCH_SAVE m ~%m%~ BEGIN REPLACE_TEXTUALLY CASE_SENSITIVE EXACT_MATCH ~%vieux%~ ~%neuf%~ END
      OUTER_SET ok = 1
    END
    ACTION_IF (ds_f2_f = 1) AND (INDEX (CASE_SENSITIVE EXACT_MATCH ~%vieux%~ ~%f%~) >= 0) BEGIN
      OUTER_PATCH_SAVE f ~%f%~ BEGIN REPLACE_TEXTUALLY CASE_SENSITIVE EXACT_MATCH ~%vieux%~ ~%neuf%~ END
      OUTER_SET ok = 1
    END
    ACTION_IF ok BEGIN
      LAM ds_f2_set
      OUTER_SET ds_f2_nb = ds_f2_nb + 1
    END
  END
END
OUTER_SET ds_f2_m = 1  OUTER_SET ds_f2_f = 1
ACTION_PHP_EACH ds_f2 AS k => neuf BEGIN
  OUTER_SET i = k_0  OUTER_SPRINT vieux ~%k_1%~
  LAM ds_f2_un
END
