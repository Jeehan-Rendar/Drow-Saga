
EXTEND_TOP ~VICONJ~ %e2_vic_pid% #%e2_vic_pos%
  IF ~GlobalGT("DS_P1_DROW","GLOBAL",0) RandomNum(6,1)~ THEN REPLY @1 GOTO DS_E2_MENZO1
  IF ~GlobalGT("DS_P1_DROW","GLOBAL",0) RandomNum(6,2)~ THEN REPLY @1 GOTO DS_E2_MENZO2
  IF ~GlobalGT("DS_P1_DROW","GLOBAL",0) RandomNum(6,3)~ THEN REPLY @1 GOTO DS_E2_MENZO3
  IF ~GlobalGT("DS_P1_DROW","GLOBAL",0) RandomNum(6,4)~ THEN REPLY @1 GOTO DS_E2_MENZO4
  IF ~GlobalGT("DS_P1_DROW","GLOBAL",0) RandomNum(6,5)~ THEN REPLY @1 GOTO DS_E2_MENZO5
  IF ~GlobalGT("DS_P1_DROW","GLOBAL",0) RandomNum(6,6) Gender(Player1,MALE)~ THEN REPLY @1 GOTO DS_E2_MENZO6M
  IF ~GlobalGT("DS_P1_DROW","GLOBAL",0) RandomNum(6,6) !Gender(Player1,MALE)~ THEN REPLY @1 GOTO DS_E2_MENZO6F
END
APPEND ~VICONJ~
  IF ~~ THEN BEGIN DS_E2_MENZO1 SAY @2 IF ~~ THEN EXIT END
  IF ~~ THEN BEGIN DS_E2_MENZO2 SAY @3 IF ~~ THEN EXIT END
  IF ~~ THEN BEGIN DS_E2_MENZO3 SAY @4 IF ~~ THEN EXIT END
  IF ~~ THEN BEGIN DS_E2_MENZO4 SAY @5 IF ~~ THEN EXIT END
  IF ~~ THEN BEGIN DS_E2_MENZO5 SAY @6 IF ~~ THEN EXIT END
  IF ~~ THEN BEGIN DS_E2_MENZO6M SAY @7 IF ~~ THEN EXIT END
  IF ~~ THEN BEGIN DS_E2_MENZO6F SAY @8 IF ~~ THEN EXIT END
END
