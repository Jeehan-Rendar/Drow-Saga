    SAY @100
    IF ~~ THEN REPLY @101 GOTO DS_C26_BR1
    IF ~~ THEN REPLY @102 GOTO DS_C26_BR2
    IF ~~ THEN REPLY @103 GOTO DS_C26_BR3
  END
  IF ~~ THEN BEGIN DS_C26_BR1 SAY @104 IF ~~ THEN GOTO DS_C26_BRF END
  IF ~~ THEN BEGIN DS_C26_BR2 SAY @105 IF ~~ THEN GOTO DS_C26_BRF END
  IF ~~ THEN BEGIN DS_C26_BR3 SAY @106 IF ~~ THEN GOTO DS_C26_BRF END
  IF ~~ THEN BEGIN DS_C26_BRF SAY @107
    IF ~~ THEN DO ~SetGlobal("DS_BRDROW","GLOBAL",1) SetGlobal("P#BRLoveTalk","GLOBAL",3) RealSetGlobalTimer("P#BRLoveTalkTime","GLOBAL",BRROM_TIMER)~ EXIT
  END
