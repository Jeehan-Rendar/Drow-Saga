IF
    Global("DS_G1_FINI","GLOBAL",0)
    Global("DS_G1","GLOBAL",3)
    Global("DS_G1_EIRLAN","GLOBAL",1)
    Dead("DSG1ILP")
    Dead("DSG1SAE")
    Dead("DSG1ILY")
    Dead("DSG1MER")
THEN
    RESPONSE #100
        AddJournalEntry(@7,INFO)
        AddexperienceParty(4000)
        SetGlobal("DS_G1_FINI","GLOBAL",1)
END

IF
    Global("DS_G1_FINI","GLOBAL",0)
    Global("DS_G1","GLOBAL",3)
    !Global("DS_G1_EIRLAN","GLOBAL",1)
    Dead("DSG1ILP")
    Dead("DSG1SAE")
    Dead("DSG1ILY")
    Dead("DSG1MER")
    Dead("DSG1EIR")
THEN
