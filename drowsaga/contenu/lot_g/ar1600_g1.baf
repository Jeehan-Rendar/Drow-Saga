
IF
    Global("DS_P1_DROW","GLOBAL",1)
    GlobalGT("Chapter","GLOBAL",2)
    Global("DS_G1","GLOBAL",0)
    CombatCounter(0)
    NearLocation(Player1,804,2174,40)
THEN
    RESPONSE #100
        SetGlobal("DS_G1","GLOBAL",1)
        CreateCreature("DSG1ILP",[1082.2026],0)
        CreateCreature("DSG1SAE",[1012.2066],0)
        CreateCreature("DSG1ILY",[1152.2066],0)
        CreateCreature("DSG1MER",[942.2106],0)
        CreateCreature("DSG1EIR",[1222.2106],0)
END

