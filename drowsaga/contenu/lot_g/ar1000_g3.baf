IF
    Dead("DSG3JOR")
    !Global("DS_G3_REP_OR","GLOBAL",1)
THEN
    RESPONSE #100
        SetGlobal("DS_G3_REP_OR","GLOBAL",1)
        ReputationInc(-1)
END

