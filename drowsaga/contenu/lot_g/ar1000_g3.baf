
IF
    Global("DS_P1_DROW","GLOBAL",1)
    GlobalGT("Chapter","GLOBAL",6)
    Global("DS_G3","GLOBAL",0)
    CombatCounter(0)
    NearLocation(Player1,1405,772,40)
THEN
    RESPONSE #100
        SetGlobal("DS_G3","GLOBAL",1)
        CreateCreature("DSG3JOR",[1473.791],0)
        CreateCreature("DSG3V1",[1403.831],0)
        CreateCreature("DSG3V2",[1543.831],0)
        CreateCreature("DSG3V3",[1333.871],0)
        CreateCreature("DSG3V4",[1613.871],0)
        CreateCreature("DSG3V5",[1433.921],0)
        CreateCreature("DSG3HAL",[1513.921],0)
END

