IF
    Global("DS_G3_FINI","GLOBAL",0)
    Global("DS_G3","GLOBAL",3)
    Dead("DSG3JOR")
THEN
    RESPONSE #100
        AddJournalEntry(@11,INFO)
        AddexperienceParty(6000)
        SetGlobal("DS_G3_FINI","GLOBAL",1)
END

