
IF
    Global("DS_P1_DROW","GLOBAL",1)
    GlobalGT("Chapter","GLOBAL",1)
    Global("DS_G2","GLOBAL",0)
    CombatCounter(0)
    NearLocation(Player1,3954,52,40)
THEN
    RESPONSE #100
        SetGlobal("DS_G2","GLOBAL",1)
        CreateCreature("DSG2HIL",[3679.330],0)
        CreateCreature("DSG2BRA",[3609.370],0)
        CreateCreature("DSG2GOR",[3749.370],0)
        CreateCreature("DSG2PIP",[3539.410],0)
END

