IF
    Global("DS_G2_FINI","GLOBAL",0)
    Global("DS_G2","GLOBAL",5)
    Dead("DSG2GOR")
THEN
    RESPONSE #100
        AddJournalEntry(@3,INFO)
        AddexperienceParty(2000)
        SetGlobal("DS_G2_FINI","GLOBAL",1)
END

IF
    Global("DS_G2_FINI","GLOBAL",0)
    Global("DS_G2","GLOBAL",3)
    Global("DS_G2_ISSUE","GLOBAL",6)
    Dead("DSG2HIL")
    Dead("DSG2BRA")
    Dead("DSG2GOR")
    Dead("DSG2PIP")
THEN
    RESPONSE #100
        AddJournalEntry(@6,INFO)
        AddexperienceParty(2000)
        SetGlobal("DS_G2_FINI","GLOBAL",1)
END

IF
    Global("DS_G2_FINI","GLOBAL",0)
    Global("DS_G2","GLOBAL",3)
    !Global("DS_G2_ISSUE","GLOBAL",6)
    Dead("DSG2HIL")
    Dead("DSG2BRA")
