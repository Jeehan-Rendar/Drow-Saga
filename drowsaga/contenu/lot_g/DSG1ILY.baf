
IF
    GlobalLT("DS_G1","GLOBAL",3)
    AttackedBy([GOODCUTOFF],DEFAULT)
THEN
    RESPONSE #100
        SetGlobal("DS_G1","GLOBAL",3)
END

IF
    Global("DS_G1","GLOBAL",3)
    !Global("DS_G_ENNEMI","LOCALS",1)
THEN
    RESPONSE #100
        SetGlobal("DS_G_ENNEMI","LOCALS",1)
        Enemy()
END

IF
    Global("DS_G1","GLOBAL",3)
    See(NearestEnemyOf(Myself))
    HaveSpell(WIZARD_BLUR)
THEN
    RESPONSE #100
        Spell(Myself,WIZARD_BLUR)
END

IF
    Global("DS_G1","GLOBAL",3)
    See(NearestEnemyOf(Myself))
    HaveSpell(WIZARD_BLINDNESS)
THEN
    RESPONSE #100
        Spell(NearestEnemyOf(Myself),WIZARD_BLINDNESS)
END

IF
    Global("DS_G1","GLOBAL",3)
    See(NearestEnemyOf(Myself))
    HaveSpell(WIZARD_COLOR_SPRAY)
THEN
    RESPONSE #100
        Spell(NearestEnemyOf(Myself),WIZARD_COLOR_SPRAY)
END

IF
    Global("DS_G1","GLOBAL",3)
    See(NearestEnemyOf(Myself))
    HaveSpell(WIZARD_MAGIC_MISSILE)
THEN
    RESPONSE #100
        Spell(NearestEnemyOf(Myself),WIZARD_MAGIC_MISSILE)
END

IF
    Global("DS_G1","GLOBAL",3)
    See(NearestEnemyOf(Myself))
THEN
    RESPONSE #100
        AttackReevaluate(NearestEnemyOf(Myself),30)
END

IF
    Global("DS_G1","GLOBAL",3)
    !See(NearestEnemyOf(Myself))
THEN
    RESPONSE #100
        MoveToObject(Player1)
END

