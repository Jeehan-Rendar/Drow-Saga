
IF
    TriggerOverride(Player1,Global("DS_DROW","LOCALS",1))
    !Global("DS_P1_DROW","GLOBAL",1)
THEN
    RESPONSE #100
        SetGlobal("DS_P1_DROW","GLOBAL",1)
        Continue()
END

IF
    !TriggerOverride(Player1,Global("DS_DROW","LOCALS",1))
    Global("DS_P1_DROW","GLOBAL",1)
