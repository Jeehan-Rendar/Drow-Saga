        SetGlobal("DS_D_ALORA","GLOBAL",-1)
        SetGlobalTimer("DS_D_ALORA_T","GLOBAL",SIX_HOURS)
        Continue()
END

IF
    Global("DS_D_ALORA","GLOBAL",-1)
    GlobalTimerExpired("DS_D_ALORA_T","GLOBAL")
THEN
    RESPONSE #100
        SetGlobal("DS_D_ALORA","GLOBAL",1)
        Continue()
END

IF
    Global("DS_D_ALORA","GLOBAL",1)
    TriggerOverride(Player1,Global("DS_DROW","LOCALS",1))
    InParty("alora")
    IsValidForPartyDialogue("alora")
    CombatCounter(0)
    !ActuallyInCombat()
    IsValidForPartyDialogue(Player1)
    !GlobalTimerNotExpired("DS_D_GAP","GLOBAL")
THEN
    RESPONSE #100
        SetGlobalTimer("DS_D_GAP","GLOBAL",EIGHT_HOURS)
        ActionOverride("alora",StartDialogOverride("DSDALORA",Player1))
END

