    TriggerOverride(Player1,Global("DS_DROW","LOCALS",1))
    InParty("BAELOTH")
    IsValidForPartyDialogue("BAELOTH")
    CombatCounter(0)
    !ActuallyInCombat()
    IsValidForPartyDialogue(Player1)
    !GlobalTimerNotExpired("DS_D_GAP","GLOBAL")
THEN
    RESPONSE #100
        SetGlobalTimer("DS_D_GAP","GLOBAL",EIGHT_HOURS)
        ActionOverride("BAELOTH",StartDialogOverride("DSSBAE",Player1))
END

