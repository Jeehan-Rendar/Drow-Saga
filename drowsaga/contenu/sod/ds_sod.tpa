  LAF ds_sod_icl INT_VAR ref = RESOLVE_STR_REF(@97) STR_VAR cle = ~I1~ dlg = ~BDIMOEN~ aiguille = ~Bon, nous revoici dans un épouvantable vieux tombeau~ END
