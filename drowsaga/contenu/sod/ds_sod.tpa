  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@46) requis = 1 STR_VAR cle = ~S7~ dlg = ~BDTHERLI~ aiguille = ~Mettez ces ordures à la peau noire en pièces~ cibles = EVAL ~%cibles%~ RET cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@47) requis = 1 STR_VAR cle = ~S8A~ dlg = ~BDKAVA~ aiguille = ~parler à un elfe qui en fait trop~ cibles = EVAL ~%cibles%~ RET cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@48) requis = 1 STR_VAR cle = ~S8B~ dlg = ~BDKAVA~ aiguille = ~Je pensais pas qu'un elfe aurait le cran~ cibles = EVAL ~%cibles%~ RET cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@49) requis = 1 STR_VAR cle = ~S8C~ dlg = ~BDKAVA~ aiguille = ~dès que vous aurez admis que vous êtes un elfe prétentieux~ cibles = EVAL ~%cibles%~ RET cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@50) requis = 1 STR_VAR cle = ~S8D~ dlg = ~BDKAVA~ aiguille = ~et je vous dirai tout ce que vous voulez savoir~ cibles = EVAL ~%cibles%~ RET cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@51) requis = 1 STR_VAR cle = ~S8E~ dlg = ~BDKAVA~ aiguille = ~Vous n'êtes pas si mal, pour un elfe~ cibles = EVAL ~%cibles%~ RET cibles END
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@52) requis = 1 STR_VAR cle = ~S8F~ dlg = ~BDKAVA~ aiguille = ~*soupire* Je suis un elfe prétentieux~ END
