
DEFINE_ACTION_FUNCTION ds_sod_ajoute
  INT_VAR ref = 0
  STR_VAR dlg = ~~ de = ~~ vers = ~~ cle = ~~
BEGIN
  LAF ds_e2_cherche STR_VAR dlg aiguille = EVAL ~%vers%~ RET n RET_ARRAY ds_e2_et END
  ACTION_IF (n = 0) BEGIN
    WARN ~Drow Saga SoD (%cle%) : état d'arrivée introuvable dans %dlg% : %vers%~
  END ELSE BEGIN
    OUTER_SET v = $ds_e2_et(~0~)
    LAF ds_e2_cherche STR_VAR dlg aiguille = EVAL ~%de%~ RET n RET_ARRAY ds_e2_et END
    ACTION_IF (n = 0) BEGIN
      WARN ~Drow Saga SoD (%cle%) : état de départ introuvable dans %dlg% : %de%~
    END
    OUTER_SPRINT d ~~
    OUTER_FOR (k = 0; k < n; ++k) BEGIN
      OUTER_SET s = $ds_e2_et(~%k%~)
      OUTER_SPRINT d ~%d% EXTEND_TOP #T#%dlg%#T# %s% #0 IF #T#GlobalGT("DS_P1_DROW","GLOBAL",0)#T# THEN REPLY #%ref% GOTO %v% END~
      PRINT ~Drow Saga SoD (%cle%) : %dlg% %s% : réponse du drow vers %v%~
    END
    ACTION_IF (n > 0) BEGIN
      LAF ds_e2_compile STR_VAR fichier = ~drowsaga/contenu/e2/tmp_sod_aj.d~ texte = EVAL ~%d%~ END
    END
  END
END

DEFINE_ACTION_FUNCTION ds_sod_icl
  INT_VAR ref = 0
  STR_VAR dlg = ~~ aiguille = ~~ cle = ~~
BEGIN
  LAF ds_e2_cherche STR_VAR dlg aiguille RET n RET_ARRAY ds_e2_et END
  ACTION_IF (n = 0) BEGIN
    WARN ~Drow Saga SoD (%cle%) : réplique introuvable dans %dlg% : %aiguille%~
  END
  OUTER_FOR (k = 0; k < n; ++k) BEGIN
    OUTER_SET s = $ds_e2_et(~%k%~)
    LAF ds_e2_compile STR_VAR fichier = ~drowsaga/contenu/e2/tmp_sod_icl.d~ texte = EVAL ~INTERJECT_COPY_TRANS #T#%dlg%#T# %s% #T#DS_SOD_%cle%#T# == #T#%dlg%#T# IF #T#GlobalGT("DS_P1_DROW","GLOBAL",0)#T# THEN #%ref% END~ END
    PRINT ~Drow Saga SoD (%cle%) : %dlg% %s% : première rencontre~
  END
END

DEFINE_ACTION_FUNCTION ds_sod_finrep
  INT_VAR ref = 0
  STR_VAR dlg = ~~ aiguille = ~~ cle = ~~ si = ~~
BEGIN
  LAF ds_e2_cherche STR_VAR dlg aiguille RET n RET_ARRAY ds_e2_et END
  ACTION_IF (n = 0) BEGIN
    WARN ~Drow Saga SoD (%cle%) : réplique introuvable dans %dlg% : %aiguille%~
  END ELSE BEGIN
    OUTER_SPRINT d1 ~~
    OUTER_SPRINT d2 ~~
    OUTER_FOR (k = 0; k < n; ++k) BEGIN
      OUTER_SET s = $ds_e2_et(~%k%~)
      OUTER_SPRINT d1 ~%d1% ADD_TRANS_TRIGGER #T#%dlg%#T# %s% #T#OR(2) !GlobalGT("DS_P1_DROW","GLOBAL",0) %si%#T#~
      OUTER_SPRINT d2 ~%d2% EXTEND_BOTTOM #T#%dlg%#T# %s% IF #T#GlobalGT("DS_P1_DROW","GLOBAL",0) !%si%#T# THEN REPLY #%ref% EXIT END~
      PRINT ~Drow Saga SoD (%cle%) : %dlg% %s% : réponse finale du drow~
    END
    LAF ds_e2_compile STR_VAR fichier = ~drowsaga/contenu/e2/tmp_sod_fin1.d~ texte = EVAL ~%d1%~ END
    LAF ds_e2_compile STR_VAR fichier = ~drowsaga/contenu/e2/tmp_sod_fin2.d~ texte = EVAL ~%d2%~ END
  END
END

WITH_TRA ~drowsaga/tra/%LANGUAGE%/sod.tra~ BEGIN
  OUTER_SPRINT cibles ~~
  LAF ds_sod_icl INT_VAR ref = RESOLVE_STR_REF(@1) STR_VAR cle = ~C1~ dlg = ~BDSCHAEL~ aiguille = ~La légende. Le mythe. Le héros de la Porte de Baldur~ END
  LAF ds_sod_icl INT_VAR ref = RESOLVE_STR_REF(@2) STR_VAR cle = ~C2~ dlg = ~BDGLINT~ aiguille = ~Oh, euh, bonjour. Euh, excusez-moi, je dois y aller~ END
  LAF ds_sod_icl INT_VAR ref = RESOLVE_STR_REF(@3) STR_VAR cle = ~C3~ dlg = ~BDVOGHIL~ aiguille = ~Holà, la ribaude~ END
  LAF ds_sod_icl INT_VAR ref = RESOLVE_STR_REF(@4) STR_VAR cle = ~C3~ dlg = ~BDVOGHIL~ aiguille = ~Holà, <CHARNAME>~ END
  LAF ds_sod_icl INT_VAR ref = RESOLVE_STR_REF(@5) STR_VAR cle = ~C3~ dlg = ~BDVOGHIL~ aiguille = ~Ah, le héros de la Porte de Baldur~ END
  LAF ds_sod_icl INT_VAR ref = RESOLVE_STR_REF(@6) STR_VAR cle = ~C4~ dlg = ~BDMKHIIN~ aiguille = ~Je m'appelle M'Khiin, du clan Doublelarve~ END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@7) requis = 1 STR_VAR cle = ~C5~ dlg = ~BDBAELOT~ aiguille = ~assez gênant de vous revoir~ cibles = EVAL ~%cibles%~ RET cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@8) requis = 1 STR_VAR cle = ~S1A~ dlg = ~BDDROW~ aiguille = ~Que voulez-vous, rivvin~ cibles = EVAL ~%cibles%~ RET cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@9) requis = 1 STR_VAR cle = ~S1B~ dlg = ~BDDROW~ aiguille = ~Retournez à la surface vous amuser dans les arbres~ cibles = EVAL ~%cibles%~ RET cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@10) requis = 1 STR_VAR cle = ~S1C~ dlg = ~BDDROW~ aiguille = ~Un elfe qui ose s'adresser à un drow~ cibles = EVAL ~%cibles%~ RET cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@11) requis = 1 STR_VAR cle = ~S1A~ dlg = ~BDPOOL54~ aiguille = ~Que voulez-vous, rivvin~ cibles = EVAL ~%cibles%~ RET cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@12) requis = 1 STR_VAR cle = ~S1B~ dlg = ~BDPOOL54~ aiguille = ~Retournez à la surface vous amuser dans les arbres~ cibles = EVAL ~%cibles%~ RET cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@13) requis = 1 STR_VAR cle = ~S1C~ dlg = ~BDPOOL54~ aiguille = ~Un elfe qui ose s'adresser à un drow~ cibles = EVAL ~%cibles%~ RET cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@14) requis = 1 STR_VAR cle = ~S2A~ dlg = ~BDSHAPUR~ aiguille = ~Cela ne vous regarde pas, retournez à la surface~ cibles = EVAL ~%cibles%~ RET cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@15) requis = 1 STR_VAR cle = ~S2B~ dlg = ~BDSHAPUR~ aiguille = ~Je ne négocie pas avec les habitants de la surface~ cibles = EVAL ~%cibles%~ RET cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@16) requis = 1 STR_VAR cle = ~S2C~ dlg = ~BDSHAPUR~ aiguille = ~Attendez... Est-ce un drow à vos côtés~ cibles = EVAL ~%cibles%~ RET cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@17) requis = 1 STR_VAR cle = ~S2D~ dlg = ~BDSHAPUR~ aiguille = ~Je trouvais cela étrange qu'un drow suive un surfacien~ cibles = EVAL ~%cibles%~ RET cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@18) requis = 1 STR_VAR cle = ~S2E~ dlg = ~BDSHAPUR~ aiguille = ~suivant si humblement un être aussi inférieur que vous~ cibles = EVAL ~%cibles%~ RET cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@19) requis = 1 STR_VAR cle = ~S2F~ dlg = ~BDSHAPUR~ aiguille = ~Je n'aurais pas dû envoyer quelqu'un de la surface~ cibles = EVAL ~%cibles%~ RET cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@20) requis = 1 STR_VAR cle = ~S2G~ dlg = ~BDSHAPUR~ aiguille = ~un objet adapté à un rivvil~ cibles = EVAL ~%cibles%~ RET cibles END
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@21) requis = 1 STR_VAR cle = ~S3A~ dlg = ~BDSHAPUR~ aiguille = ~votre reine des araignées, drow~ END
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@22) requis = 1 STR_VAR cle = ~S3B~ dlg = ~BDSHAPUR~ aiguille = ~impossible de raisonner les drows~ END
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@23) requis = 1 STR_VAR cle = ~S3C~ dlg = ~BDSHAPUR~ aiguille = ~Vous êtes une drow intransigeante~ END
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@24) requis = 1 STR_VAR cle = ~S3D~ dlg = ~BDSHAPUR~ aiguille = ~prouver votre bonne foi, drow~ END
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@25) requis = 1 STR_VAR cle = ~S3E~ dlg = ~BDSHAPUR~ aiguille = ~Aucun drow n'aurait pu faire mieux que moi~ END
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@26) requis = 1 STR_VAR cle = ~S3F~ dlg = ~BDSHAPUR~ aiguille = ~Vous pensez qu'un drow aurait pu faire mieux que moi~ END
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@27) requis = 1 STR_VAR cle = ~S3G~ dlg = ~BDSHAPUR~ aiguille = ~Il n'y a rien de pire que de vivre avec des drows~ END
  LAF ds_sod_ajoute INT_VAR ref = RESOLVE_STR_REF(@28) STR_VAR cle = ~S4A~ dlg = ~BDKAELET~ de = ~Je suis la fille d'une grande maison~ vers = ~Nous aurions peut-être dû prendre le temps de la réflexion~ END
  LAF ds_sod_ajoute INT_VAR ref = RESOLVE_STR_REF(@29) STR_VAR cle = ~S4B~ dlg = ~BDKAELET~ de = ~si vous avez réussi à la surface, nous réussirons également~ vers = ~Nous aurions peut-être dû prendre le temps de la réflexion~ END
  LAF ds_sod_ajoute INT_VAR ref = RESOLVE_STR_REF(@30) STR_VAR cle = ~S4C~ dlg = ~BDKAELET~ de = ~Il faut parler comme les habitants de la surface, maintenant~ vers = ~Je suis la fille d'une grande maison~ END
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@31) requis = 1 STR_VAR cle = ~S5A~ dlg = ~BDUMAR~ aiguille = ~J'ignore ce que les drows font~ END
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@32) requis = 1 STR_VAR cle = ~S5B~ dlg = ~BDUMAR~ aiguille = ~La vie à la surface n'est pas facile pour les vôtres~ END
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@33) requis = 1 STR_VAR cle = ~S5C~ dlg = ~BDUMAR~ aiguille = ~passer des drows aux ogres~ END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@34) requis = 1 STR_VAR cle = ~S60~ dlg = ~BDCRUS5~ aiguille = ~nous pourrons peut-être vaincre les drows~ cibles = EVAL ~%cibles%~ RET cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@35) requis = 1 STR_VAR cle = ~S61~ dlg = ~BDCRUS5~ aiguille = ~Ces horribles drows ne tueront plus aucun des nôtres~ cibles = EVAL ~%cibles%~ RET cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@36) requis = 1 STR_VAR cle = ~S62~ dlg = ~BDCRUS5~ aiguille = ~Rencontrer des drows ici~ cibles = EVAL ~%cibles%~ RET cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@37) requis = 1 STR_VAR cle = ~S63~ dlg = ~BDCRUS5~ aiguille = ~avant que ces drows ne nous massacrent~ cibles = EVAL ~%cibles%~ RET cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@38) requis = 1 STR_VAR cle = ~S64~ dlg = ~BDCRUS5~ aiguille = ~Regardez les drows courir~ cibles = EVAL ~%cibles%~ RET cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@39) requis = 1 STR_VAR cle = ~S65~ dlg = ~BDCRUS5~ aiguille = ~Stupides drows~ cibles = EVAL ~%cibles%~ RET cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@40) requis = 1 STR_VAR cle = ~S66~ dlg = ~BDCRUS5~ aiguille = ~Merci d'avoir géré la situation avec les drows~ cibles = EVAL ~%cibles%~ RET cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@34) requis = 1 STR_VAR cle = ~S60~ dlg = ~BDPOOL51~ aiguille = ~nous pourrons peut-être vaincre les drows~ cibles = EVAL ~%cibles%~ RET cibles END
