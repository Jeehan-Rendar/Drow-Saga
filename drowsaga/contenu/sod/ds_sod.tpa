  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@71) requis = 1 STR_VAR cle = ~S15F~ dlg = ~BDBAELOT~ aiguille = ~Je n'ai rien à vous dire, drow~ END
