  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@79) requis = 1 STR_VAR cle = ~S18B~ dlg = ~BDVICONI~ aiguille = ~Alors profitez bien de la compagnie du duergar, drow~ END
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@80) requis = 1 STR_VAR cle = ~S18C~ dlg = ~BDVICONI~ aiguille = ~Quel est votre nom, drow~ END
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@81) requis = 1 STR_VAR cle = ~S18D~ dlg = ~BDVICONI~ aiguille = ~Comment se fait-il qu'une drow, une adoratrice~ END
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@82) requis = 1 STR_VAR cle = ~S18E~ dlg = ~BDVICONI~ aiguille = ~Le Conseil est-il désespéré au point de se tourner vers de telles créatures~ END
