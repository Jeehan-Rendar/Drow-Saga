  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@89) requis = 1 STR_VAR cle = ~V1~ dlg = ~BDVICONJ~ aiguille = ~Il semblerait que je sois sans cesse obligée de supporter la compagnie de surfaciens~ cibles = EVAL ~%cibles%~ RET cibles END
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@90) requis = 1 STR_VAR cle = ~V2~ dlg = ~BDVICONJ~ aiguille = ~Ils se méfient peut-être de vous, mais leurs intentions sont bonnes~ END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@91) requis = 1 STR_VAR cle = ~V3~ dlg = ~BDVICONJ~ aiguille = ~Votre esprit reste aussi tranchant qu'une épée, rivvil~ cibles = EVAL ~%cibles%~ RET cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@92) requis = 1 STR_VAR cle = ~V4~ dlg = ~BDVICONJ~ aiguille = ~Vous supposez trop de choses, habitant de la surface~ cibles = EVAL ~%cibles%~ RET cibles END
