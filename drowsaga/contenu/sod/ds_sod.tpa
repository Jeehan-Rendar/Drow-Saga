  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@41) requis = 1 STR_VAR cle = ~K1~ dlg = ~BDUMAR~ aiguille = ~N'oubliez pas qu'ils ne parlent pas comme nous à la surface~ cibles = EVAL ~%cibles%~ RET cibles END
