  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@43) requis = 1 STR_VAR cle = ~K3~ dlg = ~BDKAELET~ aiguille = ~J'imagine que vous êtes les drows tant recherchés~ END
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@44) requis = 1 STR_VAR cle = ~K4~ dlg = ~BDUMAR~ aiguille = ~Les vôtres vous attendent dans la grotte au nord~ END
