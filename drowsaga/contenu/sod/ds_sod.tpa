  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@66) requis = 1 STR_VAR cle = ~S15A~ dlg = ~BDBAELOJ~ aiguille = ~Si mes choix vous dérangent, drow~ END
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@67) requis = 1 STR_VAR cle = ~S15B~ dlg = ~BDBAELOT~ aiguille = ~Votre départ est parfaitement calculé, drow~ END
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@68) requis = 1 STR_VAR cle = ~S15C~ dlg = ~BDBAELOT~ aiguille = ~Je ne vous abandonne pas, drow~ END
