  LAF ds_sod_finrep INT_VAR ref = RESOLVE_STR_REF(@163) STR_VAR cle = ~E6~ dlg = ~BDNEERA~ aiguille = ~l'alurl faerbol zhah mrimm d'ssinss~ si = ~IsValidForPartyDialogue("VICONIA")~ END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@164) requis = 1 STR_VAR cle = ~SO1~ dlg = ~BDBELLOW~ aiguille = ~J'ai cru qu'on ne remonterait jamais~ cibles = EVAL ~%cibles%~ RET cibles END
