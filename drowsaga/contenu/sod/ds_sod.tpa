  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@123) requis = 1 STR_VAR cle = ~RS2~ dlg = ~BDVICONJ~ aiguille = ~Vous êtes donc semblable aux autres habitants de la surface~ cibles = EVAL ~%cibles%~ RET cibles END
