  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@126) requis = 1 STR_VAR cle = ~RS5~ dlg = ~BDVICONJ~ aiguille = ~j'aurais trouvé un autre moyen de survivre~ cibles = EVAL ~%cibles%~ RET cibles END
