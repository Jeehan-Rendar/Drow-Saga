  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@166) requis = 1 STR_VAR cle = ~SO3~ dlg = ~BDTEERA~ aiguille = ~d'autres disent que... Enfin ce sont des idioties~ cibles = EVAL ~%cibles%~ RET cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@167) requis = 1 STR_VAR cle = ~SO4~ dlg = ~BDFFDOPP~ aiguille = ~ou toute créature sensible que vous pensez inférieure~ cibles = EVAL ~%cibles%~ RET cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@168) requis = 1 STR_VAR cle = ~SO5A~ dlg = ~BDOTILDA~ aiguille = ~des bêtes sauvages et dangereuses~ cibles = EVAL ~%cibles%~ RET cibles END
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@169) requis = 1 garde = 1 STR_VAR cle = ~SO5B~ dlg = ~BDOTILDA~ aiguille = ~quelle que soit leur race~ END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@300) requis = 1 STR_VAR cle = ~SA1~ dlg = ~BDJAHEIJ~ aiguille = ~Votre fuite ne vous fera certainement pas gagner de points~ cibles = EVAL ~%cibles%~ RET cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@301) requis = 1 STR_VAR cle = ~SA2~ dlg = ~BDNEERAJ~ aiguille = ~que le monde vous déteste et vous craigne~ cibles = EVAL ~%cibles%~ RET cibles END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@302) requis = 1 STR_VAR cle = ~SA3~ dlg = ~BDVICONJ~ aiguille = ~Vous vous préoccupez trop de ce que pensent les autres~ cibles = EVAL ~%cibles%~ RET cibles END
  LAF ds_sod_ajoute INT_VAR ref = RESOLVE_STR_REF(@303) STR_VAR cle = ~ST1~ dlg = ~BDTAIELD~ de = ~Il n'y a pas beaucoup de demi-elfes, par ici~ vers = ~Nous cherchons tous à accomplir notre devoir~ END
  LAF ds_e2_redirige STR_VAR cibles = EVAL ~%cibles%~ END
  LAF ds_e2_cherche STR_VAR dlg = ~BDENTAR~ aiguille = ~En quoi puis-je être utile au héros de la Porte de Baldur~ RET n RET_ARRAY ds_e2_et END
  ACTION_IF (n = 1) BEGIN
    OUTER_SET ds_ent = $ds_e2_et(~0~)
    COMPILE EVALUATE_BUFFER ~drowsaga/contenu/sod/ds_sod_entar.d~ USING ~drowsaga/tra/%LANGUAGE%/sod.tra~
    PRINT ~Drow Saga SoD (A1) : accueil d'Entar pour le drow, menu de BDENTAR %ds_ent%~
  END ELSE BEGIN
    WARN ~Drow Saga SoD (A1) : accueil d'Entar introuvable (%n% états)~
  END
  COMPILE ~drowsaga/contenu/sod/ds_sod.d~ USING ~drowsaga/tra/%LANGUAGE%/sod.tra~
  EXTEND_TOP ~BDBALDUR.BCS~ ~drowsaga/contenu/sod/ds_sod.baf~
END
