  LAF ds_sod_ajoute INT_VAR ref = RESOLVE_STR_REF(@94) STR_VAR cle = ~VF1~ dlg = ~BDVICONJ~ de = ~Dans le pire des cas, ils attaquent sans sommation~ vers = ~Il y a longtemps que j'ai appris à survivre toute seule~ END
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@95) requis = 1 STR_VAR cle = ~VF2~ dlg = ~BDCORWIJ~ aiguille = ~Et croyez-vous que Rohma sourira en me voyant~ END
