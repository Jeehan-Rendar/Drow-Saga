  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@73) requis = 1 STR_VAR cle = ~S16B~ dlg = ~BDMKHIIN~ aiguille = ~Est-ce la vérité, drow~ END
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@74) requis = 1 STR_VAR cle = ~S16C~ dlg = ~BDMKHIIN~ aiguille = ~subir l'hospitalité de ce drow~ END
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@75) requis = 1 STR_VAR cle = ~S16D~ dlg = ~BDMKHIIN~ aiguille = ~Je crois que vous avez raison. Partez, drow~ END
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@76) requis = 1 STR_VAR cle = ~S16E~ dlg = ~BDMKHIIN~ aiguille = ~quelqu'un d'aussi précieux que ce drow~ END
