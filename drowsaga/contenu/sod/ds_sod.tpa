  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@147) requis = 1 STR_VAR cle = ~RS26~ dlg = ~BDGLINTJ~ aiguille = ~habitué à avoir les yeux des autres posés sur lui~ cibles = EVAL ~%cibles%~ RET cibles END
  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@148) requis = 1 STR_VAR cle = ~RS27~ dlg = ~BDGLINTJ~ aiguille = ~Je dois admettre que j'ai des sentiments pour Viconia~ END
  LAF ds_e2_dit INT_VAR ref = RESOLVE_STR_REF(@149) requis = 1 STR_VAR cle = ~RS28~ dlg = ~BDVOGHIJ~ aiguille = ~Vous ne pensez pas que vous avez un beau visage~ cibles = EVAL ~%cibles%~ RET cibles END
