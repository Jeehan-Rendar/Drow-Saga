  LAF ds_e2_rep INT_VAR ref = RESOLVE_STR_REF(@160) requis = 1 STR_VAR cle = ~E3~ dlg = ~BDRASAAJ~ aiguille = ~Je n'arrive pas à voir le bout de mon nez~ END
