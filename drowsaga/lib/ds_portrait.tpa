
DEFINE_ACTION_FUNCTION ds_viconia_portrait BEGIN
  ACTION_FOR_EACH ds_p IN ~BDVICONL~ ~BDVICONM~ ~BDVICONS~ BEGIN
    ACTION_IF NOT FILE_EXISTS_IN_GAME ~%ds_p%.BMP~ BEGIN
      COPY ~drowsaga/portraits/%ds_p%.BMP~ ~override~
    END
  END
  COPY_EXISTING_REGEXP GLOB ~^VICONI.*\.CRE$~ ~override~
    PATCH_IF (SOURCE_SIZE > 0x2d4) BEGIN
      READ_ASCII 0x280 dv (32) NULL
      PATCH_IF (~%dv%~ STRING_EQUAL_CASE ~VICONIA~) BEGIN
        WRITE_ASCII 0x34 ~BDVICONM~ #8
        WRITE_ASCII 0x3c ~BDVICONL~ #8
      END
    END
  BUT_ONLY
  ACTION_FOR_EACH ds_ep IN ~VICONND1~ ~VICONND2~ ~VICONND3~ ~DSVICND1~ ~DSVICND2~ ~DSVICND3~ BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME ~%ds_ep%.2da~ BEGIN
      COPY_EXISTING ~%ds_ep%.2da~ ~override~
        REPLACE_TEXTUALLY ~^\*NVICONL~ ~*BDVICONL~
      BUT_ONLY
    END
  END
END
